{
  "name": "context-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "node scripts/serve-docs.cjs",
    "typecheck": "tsc --noEmit",
    "test:search": "node --test tests/site-search.test.cjs",
    "test:workflows": "node --test tests/deploy-guard.test.cjs",
    "test:docs": "node --test tests/docs-site.test.cjs tests/docs-preview.test.cjs tests/example-skill-source.test.cjs tests/public-environment.test.cjs",
    "check:privacy": "python3 scripts/check-public-environment.py",
    "examples:sync": "node scripts/sync-examples.mjs",
    "examples:check": "node scripts/sync-examples.mjs --check"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "prism-react-renderer": "2.4.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "serve-handler": "6.1.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
