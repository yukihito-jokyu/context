{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "503の再送は最大2回",
    "locale": "ja",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "animation": "none"
  },
  "lanes": [
    {
      "id": "client",
      "label": "クライアントが受付結果を判断する"
    },
    {
      "id": "accepted",
      "label": "202の場合"
    },
    {
      "id": "stop",
      "label": "503が続く場合",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "post",
    "response",
    "count",
    "unknown"
  ],
  "nodes": [
    {
      "id": "post",
      "lane": "client",
      "col": 0,
      "type": "frontend",
      "label": "POSTを送る",
      "sublabel": "同じrequestKey"
    },
    {
      "id": "response",
      "lane": "client",
      "col": 1,
      "type": "frontend",
      "label": "応答を確認",
      "sublabel": "202 / 503"
    },
    {
      "id": "count",
      "lane": "client",
      "col": 2,
      "type": "frontend",
      "label": "再送回数を確認",
      "sublabel": "上限2回"
    },
    {
      "id": "known",
      "lane": "accepted",
      "col": 1,
      "type": "frontend",
      "label": "jobIdを使いGET",
      "sublabel": "202は受付"
    },
    {
      "id": "unknown",
      "lane": "stop",
      "col": 3,
      "type": "frontend",
      "label": "受付結果不明",
      "sublabel": "再送を止める"
    }
  ],
  "edges": [
    {
      "id": "sent",
      "from": "post",
      "to": "response",
      "label": "サーバーの応答",
      "role": "main"
    },
    {
      "id": "ok",
      "from": "response",
      "to": "known",
      "label": "202",
      "role": "branch"
    },
    {
      "id": "busy",
      "from": "response",
      "to": "count",
      "label": "503",
      "role": "main"
    },
    {
      "id": "again",
      "from": "count",
      "to": "post",
      "label": "再送回数 < 2",
      "role": "return",
      "route": "up-channel",
      "fromSide": "top",
      "toSide": "top"
    },
    {
      "id": "exhausted",
      "from": "count",
      "to": "unknown",
      "label": "再送回数 = 2",
      "role": "error"
    }
  ]
}
