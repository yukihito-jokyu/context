    {
      "id": "return-artifact",
      "from": "artifact",
      "to": "reader",
      "y": 490,
      "label": "選んだ原本を返す",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "先に確かめる",
      "items": [
        "読者は実行した依頼と実画面を読む。",
        "画面画像は原本を選ぶための手掛かりになる。"
      ]
    },
    {
      "dot": "orange",
      "title": "用途に合わせて取る",
      "items": [
        "HTMLは画面、文章は全文、ZIPは関連ファイル一式。",
        "保存済みの原本を配信し、閲覧時に生成しない。"
      ]
