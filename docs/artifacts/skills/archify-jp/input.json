      "type": "frontend",
      "label": "活用ガイド"
    },
    {
      "id": "artifact",
      "type": "backend",
      "label": "保存済み原本"
    }
  ],
  "segments": [
    {
      "from": 160,
      "to": 320,
      "label": "入力と画面を確認"
    },
    {
      "from": 340,
      "to": 530,
      "label": "原本を選んで取得"
    }
  ],
  "messages": [
    {
      "id": "open-example",
      "from": "reader",
      "to": "guide",
      "y": 190,
      "label": "実行例を開く"
    },
    {
      "id": "show-input",
      "from": "guide",
      "to": "reader",
      "y": 245,
      "label": "依頼文と画面を表示",
      "variant": "return"
    },
    {
      "id": "choose-original",
      "from": "reader",
      "to": "guide",
      "y": 365,
      "label": "原本リンクを選ぶ",
      "variant": "emphasis"
    },
    {
      "id": "read-artifact",
      "from": "guide",
      "to": "artifact",
      "y": 420,
      "label": "HTML・文章・ZIPを取得"
