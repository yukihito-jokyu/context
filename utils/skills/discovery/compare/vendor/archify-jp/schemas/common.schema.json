{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/common.schema.json",
  "title": "Archify 共有定義",
  "$defs": {
    "relativeHtmlHref": {
      "type": "string",
      "minLength": 6,
      "maxLength": 512,
      "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!/)(?:[A-Za-z0-9_.-]+/)*[A-Za-z0-9_.-]+\\.html$"
    },
    "nodeLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "$ref": "#/$defs/relativeHtmlHref"
        },
        "focus": {
          "$ref": "#/$defs/id"
        },
        "view": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "onward": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hierarchyCrumb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "href",
        "label"
      ],
      "properties": {
        "href": {
          "$ref": "#/$defs/relativeHtmlHref"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "focus": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "href",
            "label"
          ],
          "properties": {
            "href": {
              "$ref": "#/$defs/relativeHtmlHref"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "href"
          ],
          "properties": {
            "href": {
              "$ref": "#/$defs/relativeHtmlHref"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        },
        "trail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hierarchyCrumb"
          }
        },
        "siblings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hierarchyCrumb"
          }
        },
        "incoming": {
          "description": "hierarchy-sync が書き込む、他の詳細図からこの図への横断リンク（参照元）。",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "href",
              "label",
              "node"
            ],
            "properties": {
              "href": {
                "$ref": "#/$defs/relativeHtmlHref"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "node": {
                "$ref": "#/$defs/id"
              },
              "node_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "focus": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "role": {
          "enum": [
            "map"
          ]
        },
        "require_links": {
          "type": "boolean"
        },
        "leaf_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "reason"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "enum": ["en", "zh-CN", "ja"]
    },
    "animation": {
      "enum": ["trace", "none"]
    },
    "visualPreset": {
      "enum": ["classic", "signal-flow", "blueprint", "editorial"]
    },
    "qualityProfile": {
      "enum": ["standard", "showcase"]
    },
    "side": {
      "enum": ["left", "right", "top", "bottom"]
    },
    "relationshipWidth": {
      "type": "number",
      "minimum": 0.5
    },
    "point": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "componentType": {
      "enum": ["frontend", "backend", "database", "cloud", "security", "messagebus", "external"]
    },
    "brandMark": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "anyOf": [
            { "maxLength": 80, "pattern": "^[^\\r\\n]+$" },
            { "pattern": "^https?://" }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "type": "string", "minLength": 8, "maxLength": 2048, "pattern": "^https?://" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      ]
    },
    "variant": {
      "enum": ["default", "emphasis", "security", "dashed"]
    },
    "legendMode": {
      "enum": ["auto", "all", "hidden"]
    },
    "legendEntry": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "visible": { "type": "boolean" }
      }
    },
    "guidedViews": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "focus"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "focus": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "note": { "type": "string", "maxLength": 140 }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dot", "title", "items"],
        "properties": {
          "dot": { "enum": ["cyan", "emerald", "violet", "amber", "rose", "orange", "slate"] },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
