{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tt-a1i/archify/schemas/class.schema.json",
  "title": "Archify クラス図",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "classes", "relationships"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "class" },
    "meta": {
      "type": "object", "additionalProperties": false, "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 }, "subtitle": { "type": "string" },
        "locale": { "$ref": "common.schema.json#/$defs/locale" }, "output": { "type": "string" },
        "visual_preset": { "$ref": "common.schema.json#/$defs/visualPreset" },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" },
        "views": { "$ref": "common.schema.json#/$defs/guidedViews" },
        "viewBox": { "$ref": "#/$defs/viewBox" }
      }
    },
    "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/class" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "cards": { "$ref": "common.schema.json#/$defs/cards" }
  },
  "$defs": {
    "viewBox": { "type": "array", "prefixItems": [{ "type": "number", "minimum": 320 }, { "type": "number", "minimum": 240 }], "items": false, "minItems": 2, "maxItems": 2 },
    "visibility": { "enum": ["public", "protected", "package", "private"] },
    "parameter": { "type": "object", "additionalProperties": false, "required": ["name", "type"], "properties": { "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 } } },
    "attribute": { "type": "object", "additionalProperties": false, "required": ["visibility", "name", "type"], "properties": { "visibility": { "$ref": "#/$defs/visibility" }, "name": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "static": { "type": "boolean" }, "abstract": { "type": "boolean" } } },
    "method": { "type": "object", "additionalProperties": false, "required": ["visibility", "name", "parameters", "return_type"], "properties": { "visibility": { "$ref": "#/$defs/visibility" }, "name": { "type": "string", "minLength": 1 }, "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } }, "return_type": { "type": "string", "minLength": 1 }, "static": { "type": "boolean" }, "abstract": { "type": "boolean" } } },
    "class": { "type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "pos", "attributes", "methods"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "name": { "type": "string", "minLength": 1 }, "kind": { "enum": ["class", "abstract", "interface"] }, "stereotype": { "type": "string" }, "pos": { "$ref": "common.schema.json#/$defs/point" }, "width": { "type": "number", "minimum": 180 }, "attributes": { "type": "array", "items": { "$ref": "#/$defs/attribute" } }, "methods": { "type": "array", "items": { "$ref": "#/$defs/method" } } } },
    "relationship": { "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "kind"], "properties": { "id": { "$ref": "common.schema.json#/$defs/id" }, "from": { "$ref": "common.schema.json#/$defs/id" }, "to": { "$ref": "common.schema.json#/$defs/id" }, "kind": { "enum": ["association", "aggregation", "composition", "inheritance", "realization", "dependency"] }, "label": { "type": "string" }, "from_multiplicity": { "type": "string" }, "to_multiplicity": { "type": "string" } } }
  }
}
