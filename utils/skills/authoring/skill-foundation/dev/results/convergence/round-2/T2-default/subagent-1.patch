            elif prev == "heading":
                err("OUT-02", number, "種類の見出しの次の行は空行にする")
            elif prev == "blank" and groups[-1][2]:
                err("OUT-02", number, "同じ種類の項目の間に空行を置かない")
            if groups:
                groups[-1][2].append((number, line))
            prev = "item"
        else:
            err("OUT-02", number, "見出し・空行・`- ` で始まる項目のほかの行を書かない（版の見出し、説明、HTML のコメント、折り返しを書かない）")
            prev = "other"
    if not groups:
        err("OUT-02", 1, "種類の見出し（### <種類>）と項目が1つもない")
    order = [g[0] for g in groups if g[0] in TYPES]
    if order != sorted(order, key=TYPES.index) or len(set(order)) != len(order):
        err("OUT-02", groups[0][1] if groups else 1,
            f"種類の見出しは {', '.join(TYPES)} の順に、1つずつ並べる（今: {', '.join(order)}）")

    covered: dict[str, list[str]] = {}
    for kind, head_line, items in groups:
        if not items:
            err("OUT-02", head_line, f"### {kind} に項目が無い。項目の無い種類の見出しは書かない")
        cited: list[str] = []
        for number, line in items:
            text = line[2:]
            if BREAKING_WORDS.search(text) and not text.startswith(BREAKING):
                err("OUT-08", number, f"破壊的な変更の印は、`- ` の直後の `{BREAKING.strip()}` の形だけにする")
            if text.startswith(BREAKING):
                text = text[len(BREAKING):]
                if kind not in BREAKING_TYPES:
                    err("OUT-08", number, f"`{BREAKING.strip()}` は Changed と Removed の項目にだけ付ける（今: {kind}）")
            match = CITATION.search(text)
            body = text[:match.start()] if match else text
            if kind in ENDINGS and not body.endswith(ENDINGS[kind]):
                err("OUT-03", number, f"{kind} の項目の文は「{'」か「'.join(ENDINGS[kind])}」で終える（根拠の単位の直前）")
            if not match:
                err("OUT-07", number, "項目の末尾に、根拠の単位を `（`<単位>`）` の形で1つ書く")
                continue
            unit = match.group(1)
            if "`" in body and re.search(r"（`[^`]+`）", body):
                err("OUT-07", number, "根拠の単位は項目の末尾に1つだけ書く")
            if unit not in table:
                err("OUT-07", number, f"`{unit}` は collect の単位にない。単位は {', '.join(table)} のどれかにする")
                continue
            if kind in TYPES and kind not in allowed(table[unit]):
                err("OUT-04", number, f"`{unit}` の状態は {','.join(sorted(set(table[unit])))} なので、種類は {', '.join(allowed(table[unit]))} にする")
            if kind in covered.get(unit, []):
                err("STEP-02", number, f"`{unit}` の項目が ### {kind} に2つある。1つの単位について1つの種類に書く項目は1つまで")
            covered.setdefault(unit, []).append(kind)
            cited.append(unit)
        if cited != sorted(cited):
            err("OUT-04", head_line, f"### {kind} の項目は、根拠の単位のパスの昇順に並べる（{', '.join(sorted(cited))}）")
    missing = [u for u in table if u not in covered]
    if missing:
        err("STEP-02", 1, f"項目の無い単位がある: {', '.join(missing)}。どの単位にも項目を1つ以上書く")
    for error in errors:
        print(error)
    return 1 if errors else 0


def cmd_howto(root: Path) -> int:
    path = root / CHANGELOG
    print("## CHANGELOG.md への写し方")
    print()
    if not path.is_file():
        print("- `CHANGELOG.md` がありません。1行目を `# Changelog`、2行目を空行にして作り、3行目から節を写してください")
    else:
        lines = path.read_text(encoding="utf-8").splitlines()
        unreleased = next((i for i, l in enumerate(lines, 1) if re.match(r"^## \[Unreleased\]\s*$", l)), None)
        first = next((i for i, l in enumerate(lines, 1) if l.startswith("## ")), None)
        if unreleased:
            print(f"- `CHANGELOG.md` の {unreleased} 行目に `## [Unreleased]` があります。節の `### <種類>` ごとに、"
                  "その下の同じ見出しの項目の末尾へ項目を足してください")
            print(f"- 同じ見出しが無い種類は、見出しと項目を {', '.join(TYPES)} の順の位置に足してください")
        elif first:
            print(f"- `CHANGELOG.md` に `## [Unreleased]` がありません。{first} 行目の `{lines[first - 1]}` の前に節を丸ごと足し、"
                  "節の後に空行を1つ置いてください")
        else:
            print("- `CHANGELOG.md` に `## ` の見出しがありません。ファイルの末尾に空行を1つ置いてから、節を丸ごと足してください")
    print("- 写した後に `git add CHANGELOG.md` でステージしてください（このスキルは CHANGELOG.md を変えず、ステージもしません）")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("collect", "check", "howto"):
        p = sub.add_parser(name)
        if name == "check":
            p.add_argument("file")
        p.add_argument("--root", default=".")
    args = parser.parse_args()
    root = Path(args.root).resolve()
    if args.command == "collect":
        return cmd_collect(root)
    if args.command == "check":
        return cmd_check(args.file, root)
    return cmd_howto(root)


if __name__ == "__main__":
    sys.exit(main())

