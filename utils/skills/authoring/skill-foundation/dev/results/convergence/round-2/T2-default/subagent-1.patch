            if heading.group(1) not in TYPES:
                err("OUT-02", number, f"種類の見出しは {', '.join('### ' + t for t in TYPES)} のどれかにする")
            groups.append((heading.group(1), number, []))
            prev = "heading"
        elif line.startswith("- "):
