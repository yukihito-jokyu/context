#!/usr/bin/env python3
"""変更履歴の1節の材料を集め、書いた節を検査し、CHANGELOG.md への写し方を出す。

決定: IN-01、IN-02、STEP-01、STEP-02（collect と check）、OUT-02、OUT-03、OUT-04、OUT-07、OUT-08（check）、OUT-06（howto）

サブコマンド:
  collect  ステージ済みの差分（CHANGELOG.md を除く）から、ファイルの数、項目の単位（STEP-02 の決定表）、
           単位ごとの状態と許す種類（OUT-04 の表の1行目と2行目）、差分の先頭 800 行を出す
  check    書いた節を、単位・種類・並べ順・形と突き合わせ、違反を `<ルールID> <ファイル>:<行> <説明>` で出す
  howto    CHANGELOG.md の今の状態から、節の写し方を Markdown の節で出す（報告の report.sections）

終了コード:
  collect  0 材料あり、4 CHANGELOG.md のほかにステージされた変更が無い（IN-01）、2 git が使えない（STEP-04）
  check    0 合格、1 違反あり、2 git が使えない
  howto    0

使い方:
  python3 <skill>/scripts/changelog_entry.py collect [--root <リポジトリのルート>]
  python3 <skill>/scripts/changelog_entry.py check <節のファイル> [--root <リポジトリのルート>]
  python3 <skill>/scripts/changelog_entry.py howto [--root <リポジトリのルート>]
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path, PurePosixPath

TYPES = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
ENDINGS = {
    "Added": ("を追加",),
    "Changed": ("を変更", "に変更"),
    "Deprecated": ("を廃止予定に変更",),
    "Removed": ("を削除",),
    "Fixed": ("を修正",),
    "Security": ("を修正",),
}
BREAKING = "**Breaking:** "
BREAKING_TYPES = ("Changed", "Removed")
FILE_UNIT_MAX = 5
MAX_DIFF_LINES = 800
CHANGELOG = "CHANGELOG.md"
HEADING = re.compile(r"^### (\S.*)$")
CITATION = re.compile(r"（`([^`]+)`）$")
BREAKING_WORDS = re.compile(r"(?i)breaking|破壊的")


def git(args: list[str], root: Path) -> str:
    try:
        proc = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)
    except OSError as exc:
        print(f"git を実行できません: {exc}", file=sys.stderr)
        sys.exit(2)
    if proc.returncode != 0:
        print(f"git {' '.join(args)} が失敗しました: {proc.stderr.strip()}", file=sys.stderr)
        sys.exit(2)
    return proc.stdout


def staged(root: Path) -> list[tuple[str, str, list[str]]]:
    """ステージされたファイルの（状態の記号、パス、差分に渡すパス）。CHANGELOG.md は除く。"""
    fields = git(["diff", "--cached", "--name-status", "-z", "-M", "--no-ext-diff"], root).split("\0")
    entries, i = [], 0
    while i < len(fields) and fields[i]:
        status = fields[i][0]
        if status in "RC":
            old, new, i = fields[i + 1], fields[i + 2], i + 3
            entries.append((status, new, [old, new]))
        else:
            path, i = fields[i + 1], i + 2
            entries.append((status, path, [path]))
    return sorted((e for e in entries if PurePosixPath(e[1]).name != CHANGELOG), key=lambda e: e[1])


def units(entries: list[tuple[str, str, list[str]]]) -> tuple[str, dict[str, list[str]]]:
    """項目の単位（STEP-02）と、単位ごとの状態の記号の一覧。"""
    mode = "ファイル" if len(entries) <= FILE_UNIT_MAX else "ディレクトリ"
    result: dict[str, list[str]] = {}
    for status, path, _ in entries:
        parent = str(PurePosixPath(path).parent)
        unit = path if mode == "ファイル" or parent == "." else parent + "/"
        result.setdefault(unit, []).append(status)
    return mode, dict(sorted(result.items()))


def allowed(statuses: list[str]) -> list[str]:
    """OUT-04 の表の1行目と2行目。状態が A だけなら Added、D だけなら Removed。"""
    if set(statuses) == {"A"}:
        return ["Added"]
    if set(statuses) == {"D"}:
        return ["Removed"]
    return list(TYPES)


def cmd_collect(root: Path) -> int:
    entries = staged(root)
    if not entries:
        print("CHANGELOG.md のほかにステージされた変更がありません（IN-01）")
        return 4
    mode, table = units(entries)
    print(f"ファイルの数: {len(entries)}")
    print(f"項目の単位: {mode}")
    print("単位（パスの昇順。この順に並べる。種類は「許す種類」から選ぶ）:")
    print("  単位\t状態\t許す種類")
    for unit, statuses in table.items():
        print(f"  {unit}\t{','.join(sorted(set(statuses)))}\t{', '.join(allowed(statuses))}")
    paths = [p for _, _, ps in entries for p in ps]
    diff = git(["diff", "--cached", "-M", "--no-ext-diff", "--no-color", "--", *paths], root).splitlines()
    shown = diff[:MAX_DIFF_LINES]
    print(f"差分（{len(diff)} 行のうち先頭 {len(shown)} 行）:")
    print("\n".join(shown))
    return 0


def cmd_check(file: str, root: Path) -> int:
    lines = Path(file).read_text(encoding="utf-8").splitlines()
