#!/usr/bin/env python3
"""ステージ済みの差分から、変更履歴（CHANGELOG.md）に足す1節の材料を出し、書いた1節を整えて検査する。

このスクリプトを how に挙げた決定: IN-01、IN-02、OUT-02、OUT-03、OUT-04、OUT-05、OUT-06、OUT-07、OUT-08、OUT-09

使い方:
  python3 changelog_entry.py collect [--root <ルート>] [--language ja|en]
  python3 changelog_entry.py check <1節のファイル> [--only structure|language|style|count|paths] [--root <ルート>] [--language ja|en]
  python3 changelog_entry.py fix <1節のファイル> --part headings|types|items|endings [--root <ルート>] [--language ja|en]
  python3 changelog_entry.py guide [--root <ルート>]

出力:
  collect: ステージ済みの変更の件数、言語、項目数の上限、ファイルの一覧（順、状態、区分、パス）、「対象」のファイルの差分
  check  : 違反ごとに「<ルールID> <行>行目: <説明>」の1行
  fix    : 直したときだけ「直した: <説明>」の1行。ファイルを書き換える
  guide  : 報告に入れる「## CHANGELOG.md への写し方」の節

終了コード:
  0 成功（check は指摘なし）
  1 check の指摘あり
  2 実行の誤り（git のリポジトリでない、git が無い、ファイルが読めない）
  4 collect: CHANGELOG.md のほかにステージ済みの変更が無い（IN-01）
  5 collect: ステージ済みの変更が「内部」のファイルだけ（IN-01）

--language を省くか空にすると、CHANGELOG.md の項目の言語の多数派で決める（OUT-03）。
"""
from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

TYPES = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
TYPE_ALIASES = {"追加": "Added", "変更": "Changed", "非推奨": "Deprecated", "削除": "Removed",
                "修正": "Fixed", "セキュリティ": "Security"}
TYPE_ALIASES.update({t.lower(): t for t in TYPES})
UNRELEASED = "## [Unreleased]"
CHANGELOG = "CHANGELOG.md"
MAX_ITEMS = 10
MAX_DIFF_LINES = 2000
INTERNAL_PARTS = {"test", "tests", "__tests__", "spec", "specs", "e2e"}
INTERNAL_NAME = re.compile(r"^(test_.*|.*_test\..*|.*\.test\..*|.*\.spec\..*)$")
INTERNAL_PREFIXES = (".github/", ".circleci/")
INTERNAL_FILES = {".gitlab-ci.yml", ".gitignore", ".gitattributes", ".editorconfig"}
JA_CHAR = re.compile(r"[぀-ヿ㐀-䶿一-鿿]")
POLITE = re.compile(r"(です|でした|ます|ました|ません)")
STATUS = {"A": "足した", "M": "変えた", "D": "消した", "R": "名前を変えた", "C": "写した", "T": "種類を変えた"}
GIT = ["git", "-c", "core.quotepath=false"]
EXIT_ERROR, EXIT_EMPTY, EXIT_INTERNAL = 2, 4, 5


class Failure(Exception):
    pass


def git(root: Path, *args: str) -> str:
    try:
        proc = subprocess.run(GIT + list(args), cwd=root, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Failure(f"git を実行できません: {exc}")
    if proc.returncode != 0:
        raise Failure(f"git {' '.join(args)} が失敗しました: {proc.stderr.strip()}")
    return proc.stdout


def project_root(given: str | None) -> Path:
    start = Path(given or ".").resolve()
    return Path(git(start, "rev-parse", "--show-toplevel").strip())


def classify(path: str) -> str:
    """IN-02 の表。除く・内部・対象のどれか。"""
    if path == CHANGELOG:
        return "除く"
    parts = path.split("/")
    if any(p in INTERNAL_PARTS for p in parts[:-1]) or INTERNAL_NAME.match(parts[-1]):
        return "内部"
    if path.startswith(INTERNAL_PREFIXES) or path in INTERNAL_FILES:
        return "内部"
    return "対象"


def staged(root: Path) -> list[dict]:
    """git diff --cached の一覧（git の並び順）。"""
    out = git(root, "diff", "--cached", "--name-status", "-z", "-M", "--no-ext-diff")
    fields = [f for f in out.split("\0") if f != ""]
    entries, i = [], 0
    while i < len(fields):
        code = fields[i]
        letter = code[0]
        if letter in "RC":
            old, path, i = fields[i + 1], fields[i + 2], i + 3
        else:
            old, path, i = None, fields[i + 1], i + 2
        entries.append({"status": letter, "path": path, "old": old, "kind": classify(path)})
    return entries


def target_diff(root: Path, entries: list[dict]) -> str:
    paths = []
    for e in entries:
        if e["kind"] == "対象":
            paths += [p for p in (e["old"], e["path"]) if p]
    if not paths:
        return ""
    return git(root, "diff", "--cached", "--no-color", "--no-ext-diff", "-M", "-U3", "--", *paths)


def count_hunks(diff: str) -> int:
    """差分の塊（@@ の行）の数。塊の無いファイル（名前の変更だけ、バイナリ）は1と数える。"""
    total, current = 0, None
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            if current is not None:
                total += max(1, current)
            current = 0
        elif line.startswith("@@ ") and current is not None:
            current += 1
    if current is not None:
        total += max(1, current)
    return total


def item_limit(root: Path, entries: list[dict]) -> tuple[int, int]:
    hunks = count_hunks(target_diff(root, entries))
    return min(hunks, MAX_ITEMS), hunks


def changelog_bullets(root: Path) -> list[str]:
    path = root / CHANGELOG
    if not path.is_file():
        return []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError):
        return []
    return [line for line in lines if line.startswith("- ")]


def resolve_language(root: Path, given: str | None) -> tuple[str, str]:
    """OUT-03 の表。（言語, 決めた理由）を返す。"""
    value = (given or "").strip().lower()
    if value in ("ja", "en"):
        return value, "入力 language"
    bullets = changelog_bullets(root)
    if not bullets:
        return "ja", "CHANGELOG.md の項目が無いため既定の ja"
    ja = sum(1 for b in bullets if JA_CHAR.search(b))
    lang = "ja" if ja * 2 >= len(bullets) else "en"
    return lang, f"CHANGELOG.md の項目 {len(bullets)} 件のうち日本語 {ja} 件"


def is_language(body: str, lang: str) -> bool:
    has_ja = JA_CHAR.search(body) is not None
    return has_ja if lang == "ja" else not has_ja


# ---- collect ----

def cmd_collect(args) -> int:
    root = project_root(args.root)
    entries = staged(root)
    material = [e for e in entries if e["kind"] != "除く"]
    targets = [e for e in material if e["kind"] == "対象"]
    lang, why = resolve_language(root, args.language)
    print(f"ステージ済みの変更: {len(material)} 件（{CHANGELOG} を除く）")
    print(f"対象のファイル: {len(targets)} 件")
    print(f"内部のファイル: {len(material) - len(targets)} 件")
    if not material:
        print("IN-01: CHANGELOG.md のほかにステージ済みの変更が無い。1節を書かずに `run.py abort --reason \"ステージ済みの変更が無い\"` を実行する")
        return EXIT_EMPTY
    if not targets:
        print("IN-01: ステージ済みの変更が「内部」のファイルだけ。1節を書かずに `run.py abort --reason \"利用者に見える変更が無い\"` を実行する")
        return EXIT_INTERNAL
    limit, hunks = item_limit(root, entries)
    print(f"言語: {lang}（{why}）")
    print(f"項目数の上限: {limit}（対象の差分の塊 {hunks} と {MAX_ITEMS} の小さい方）")
    print(f"種類の順: {', '.join(TYPES)}")
    print("")
    print("| 順 | 状態 | 区分 | パス |")
    print("|---|---|---|---|")
    for n, e in enumerate(entries, 1):
        path = f"{e['old']} → {e['path']}" if e["old"] else e["path"]
        print(f"| {n} | {STATUS.get(e['status'], e['status'])} | {e['kind']} | {path} |")
    print("")
    print("次: 「対象」の差分を、利用者から見た変更1つずつに分け、SKILL.md の STEP-01 の表で種類を決める。")
    print("")
    print("## 対象の差分")
    print("")
    diff_lines = target_diff(root, entries).splitlines()
    print("```diff")
    for line in diff_lines[:MAX_DIFF_LINES]:
        print(line)
    print("```")
    if len(diff_lines) > MAX_DIFF_LINES:
        print(f"（差分の {MAX_DIFF_LINES + 1} 行目から {len(diff_lines)} 行目までを省いた。"
              "続きは `git diff --cached -- <パス>` で読む）")
    return 0


# ---- fix ----

def split_groups(lines: list[str]) -> tuple[list[str], list[tuple[str, list[str]]]] | None:
    """`### ` の見出しで分ける。（見出しの前の行, [(種類, 中身の行)]）。見出しが種類でなければ None。"""
    head, groups, current = [], [], None
    for line in lines:
        if line.startswith("### "):
            name = line[4:].strip()
            if name not in TYPES:
                return None
            current = (name, [])
            groups.append(current)
        elif current is None:
            head.append(line)
        else:
            current[1].append(line)
    return head, groups


def trim(lines: list[str]) -> list[str]:
    start, end = 0, len(lines)
    while start < end and not lines[start].strip():
        start += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return lines[start:end]


def join_groups(head: list[str], groups: list[tuple[str, list[str]]]) -> list[str]:
    out = trim(head)
    for name, body in groups:
        out += ["", f"### {name}", ""] + trim(body)
    return out


def fix_headings(lines: list[str]) -> list[str]:
    out = []
    for line in lines:
        line = line.rstrip()
        if re.match(r"^#{1,2}\s*\[?\s*(unreleased|未リリース)\s*\]?$", line, re.I):
            line = UNRELEASED
        else:
            m = re.match(r"^#{3,4}\s*(.+?)$", line)
            if m and m.group(1).strip().lower() in TYPE_ALIASES:
                line = "### " + TYPE_ALIASES[m.group(1).strip().lower()]
            line = re.sub(r"^[*+]\s+", "- ", line)
            line = re.sub(r"^-\s{2,}", "- ", line)
        out.append(line)
    return trim(out)


def fix_types(lines: list[str]) -> list[str]:
    parsed = split_groups(lines)
    if parsed is None:
        return lines
    head, groups = parsed
    names = [n for n, _ in groups]
    if len(set(names)) != len(names) or names == sorted(names, key=TYPES.index):
        return lines
    return join_groups(head, sorted(groups, key=lambda g: TYPES.index(g[0])))


def fix_items(lines: list[str]) -> list[str]:
    parsed = split_groups(lines)
    if parsed is None:
        return lines
    head, groups = parsed
    changed, result = False, []
    for name, body in groups:
        items = trim(body)
        if items and all(i.startswith("- ") for i in items) and items != sorted(items):
            items, changed = sorted(items), True
        result.append((name, items))
    return join_groups(head, result) if changed else lines


def fix_endings(lines: list[str], lang: str) -> list[str]:
    out = []
    for line in lines:
        if line.startswith("- ") and is_language(line[2:], lang):
            body = line.rstrip()
            if lang == "ja" and not body.endswith("。"):
                body = body.rstrip("．.") + "。"
            elif lang == "en" and not body.endswith("."):
                body = body.rstrip("。") + "."
            line = body
        out.append(line)
    return out


def cmd_fix(args) -> int:
    path = Path(args.file)
    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        raise Failure(f"{path} を読めません: {exc}")
    lines = text.splitlines()
    if args.part == "headings":
        new, what = fix_headings(lines), "見出し、項目の記号、行末を Keep a Changelog の形に整えた"
    elif args.part == "types":
        new, what = fix_types(lines), "種類の見出しを Added、Changed、Deprecated、Removed、Fixed、Security の順に並べ替えた"
    elif args.part == "items":
        new, what = fix_items(lines), "同じ種類の項目を文字列の順に並べ替えた"
    else:
        lang, _ = resolve_language(project_root(args.root), args.language)
        new, what = fix_endings(lines, lang), "項目の文末に句点を足した"
    new_text = "\n".join(new) + "\n" if new else ""
    if new_text != text:
        path.write_text(new_text, encoding="utf-8")
        print(f"直した: {what}")
    return 0


# ---- check ----

def check_structure(lines: list[str]) -> list[str]:
    """OUT-02。1行目、空行の位置、種類の見出し、項目の行の並びを確かめる。"""
    problems = []
    lines = list(lines)
    while lines and not lines[-1]:
        lines.pop()
    if not lines or lines[0] != UNRELEASED:
        problems.append(f"OUT-02 1行目: 1行目は `{UNRELEASED}` にする")
    if len(lines) <= 1:
        return problems + ["OUT-02 2行目: `### <種類>` の見出しと項目が無い"]
    i, n, seen = 1, len(lines), []
    while i < n:
        if lines[i] != "":
            return problems + [f"OUT-02 {i + 1}行目: 見出しと項目の後は、空行を1つ置いて次の `### <種類>` にする（今: {lines[i][:40]}）"]
        i += 1
        if not lines[i].startswith("### "):
            return problems + [f"OUT-02 {i + 1}行目: ここは `### <種類>` の見出しにする（今: {lines[i][:40]}）"]
        name = lines[i][4:].strip()
        if name not in TYPES:
            problems.append(f"OUT-02 {i + 1}行目: 種類は {', '.join(TYPES)} のどれかにする（今: {name}）")
        if name in seen:
            problems.append(f"OUT-02 {i + 1}行目: 種類 {name} を2回書いている")
        seen.append(name)
        i += 1
        if i >= n or lines[i] != "":
            return problems + [f"OUT-02 {i + 1}行目: 種類の見出しの次は空行にする"]
        i += 1
        start = i
        while i < n and lines[i].startswith("- "):
            i += 1
        if i == start:
            return problems + [f"OUT-02 {start + 1}行目: 種類 {name} に `- ` の項目が無い"]
    return problems


CHECK_PARTS = {"structure": "OUT-02", "language": "OUT-03", "style": "OUT-04", "count": "OUT-07", "paths": "OUT-09"}


def check_bullets(bullets: list[tuple[int, str]], lang: str) -> list[str]:
    """OUT-03 と OUT-04。言語の違う項目には OUT-03 だけを出す。"""
    problems = []
    for n, body in bullets:
        if not is_language(body, lang):
            want = "日本語の文字を含める" if lang == "ja" else "日本語の文字を使わない"
            problems.append(f"OUT-03 {n}行目: 言語は {lang} なので、項目に{want}")
            continue
        if lang == "ja":
            if POLITE.search(body):
                problems.append(f"OUT-04 {n}行目: 「です」「ます」を使わず、常体で書く")
            elif not body.endswith("た。"):
                problems.append(f"OUT-04 {n}行目: 項目は「〜た。」で終える")
            if body.count("。") > 1:
                problems.append(f"OUT-04 {n}行目: 1項目は1文にする（「。」は文末の1つだけ）")
        else:
            if not body.endswith("."):
                problems.append(f"OUT-04 {n}行目: 項目は `.` で終える")
            if not re.match(r"^[A-Z`]", body):
                problems.append(f"OUT-04 {n}行目: 項目は大文字か `` ` `` で始める")
    return problems


def check_paths(bullets: list[tuple[int, str]], entries: list[dict]) -> list[str]:
    """OUT-09。ステージ済みのファイルのパスを項目に書いていないか。"""
    problems = []
    paths = sorted({p for e in entries for p in (e["path"], e["old"]) if p}, key=len, reverse=True)
    for n, body in bullets:
        for p in paths:
            if re.search(r"(?<![\w./-])" + re.escape(p) + r"(?![\w/-])", body):
                problems.append(f"OUT-09 {n}行目: ステージ済みのファイルのパス {p} を書かない。利用者から見た変更で書く")
                break
    return problems


def cmd_check(args) -> int:
    path = Path(args.file)
    try:
        lines = [line.rstrip() for line in path.read_text(encoding="utf-8").splitlines()]
    except (OSError, UnicodeDecodeError) as exc:
        raise Failure(f"{path} を読めません: {exc}")
    root = project_root(args.root)
    parts = [args.only] if args.only else list(CHECK_PARTS)
    bullets = [(n, line[2:]) for n, line in enumerate(lines, 1) if line.startswith("- ")]
    problems = []
    if "structure" in parts:
        problems += check_structure(lines)
    if "language" in parts or "style" in parts:
        lang, _ = resolve_language(root, args.language)
        wanted = {CHECK_PARTS[p] for p in parts}
        problems += [p for p in check_bullets(bullets, lang) if p.split()[0] in wanted]
    if "count" in parts:
        limit, hunks = item_limit(root, staged(root))
        if not 1 <= len(bullets) <= limit:
            problems.append(f"OUT-07 0行目: 項目は1つ以上 {limit} 以下にする（今 {len(bullets)}。"
                            f"対象の差分の塊 {hunks} と {MAX_ITEMS} の小さい方）")
    if "paths" in parts:
        problems += check_paths(bullets, staged(root))
    for line in problems:
        print(line)
    return 1 if problems else 0


# ---- guide ----

def cmd_guide(args) -> int:
    root = project_root(args.root)
    path = root / CHANGELOG
    print("## CHANGELOG.md への写し方")
    print("")
    if not path.is_file():
        print("- CHANGELOG.md の状態: 無い")
        print("- 写し方: 次の冒頭の後に空行を1つ置き、出力の1節をそのまま続けて CHANGELOG.md を作る")
        print("")
        print("```markdown")
        print("# Changelog")
        print("")
        print("All notable changes to this project will be documented in this file.")
        print("")
        print("The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).")
        print("```")
    else:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
        unreleased = next((n for n, l in enumerate(lines, 1) if re.match(r"^## \[Unreleased\]\s*$", l)), None)
        first = next((n for n, l in enumerate(lines, 1) if l.startswith("## ")), None)
        if unreleased:
            print(f"- CHANGELOG.md の状態: `{UNRELEASED}` の見出しがある（{unreleased}行目）")
            print(f"- 写し方: 出力の `### <種類>` ごとに、CHANGELOG.md の `{UNRELEASED}` の中の同じ種類の見出しの末尾に項目を足す。"
                  f"同じ種類の見出しが無ければ、{'、'.join(TYPES)} の順の位置に見出しごと足す")
        elif first:
            print(f"- CHANGELOG.md の状態: `{UNRELEASED}` の見出しが無い（最初の `## ` の見出しは {first}行目）")
            print(f"- 写し方: {first}行目の見出しの前に、出力の1節をそのまま入れ、後に空行を1つ置く")
        else:
            print("- CHANGELOG.md の状態: `## ` の見出しが無い")
            print("- 写し方: CHANGELOG.md の末尾に空行を1つ置き、出力の1節をそのまま足す")
    print("- このスキルは CHANGELOG.md を作らず、書き換えていない（OUT-08）")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("collect", help="ステージ済みの差分から材料を出す")
    p.add_argument("--root")
    p.add_argument("--language", default="")
    p = sub.add_parser("check", help="書いた1節を検査する")
    p.add_argument("file")
    p.add_argument("--only", choices=list(CHECK_PARTS), help="1つの観点だけを検査する（省くと全部）")
    p.add_argument("--root")
    p.add_argument("--language", default="")
    p = sub.add_parser("fix", help="書いた1節を整える")
    p.add_argument("file")
    p.add_argument("--part", required=True, choices=["headings", "types", "items", "endings"])
    p.add_argument("--root")
    p.add_argument("--language", default="")
    p = sub.add_parser("guide", help="CHANGELOG.md への写し方を出す")
    p.add_argument("--root")
    args = parser.parse_args(argv)
    handlers = {"collect": cmd_collect, "check": cmd_check, "fix": cmd_fix, "guide": cmd_guide}
    try:
        return handlers[args.command](args)
    except Failure as exc:
        print(f"誤り: {exc}", file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())

