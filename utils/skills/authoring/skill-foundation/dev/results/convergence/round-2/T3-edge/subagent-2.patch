#!/usr/bin/env python3
"""ソースコードの TODO コメントを集め、一覧の Markdown を書く・検査する。

決定: IN-02（読むファイル）、STEP-01（判定と集計）、OUT-02（形）、OUT-03（そのまま写す）、
OUT-04（並べ順と件数）、OUT-05（すべて載せる）、OUT-06（対象と数えたコマンド）

使い方:
  python3 collect_todo.py collect --source <dir> [--out <file>] [--root <dir>]
      一覧の Markdown を --out に書く（無ければ標準出力に出す）。
  python3 collect_todo.py verify --file <file> --source <dir> [--root <dir>]
      一覧のファイルを、今のソースから collect した結果と比べる。
      違いを「<ルールID> <説明>」の行で出す。

--source と --out と --file の相対パスは、プロジェクトのルートからの相対である。
プロジェクトのルートは --root、無ければ今のディレクトリから親へ辿って最初に .git がある場所、
それも無ければ今のディレクトリである。

出力（collect）: 見本 assets/examples/todo-comments.md と同じ形の Markdown。

終了コード:
  0 成功（verify は違いが無い）
  1 verify で違いがある
  2 実行の誤り（source が見つからない、git が失敗した）
"""
from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

TITLE = "# TODO コメントの一覧"
HEADER = "| ファイル | 行 | 識別子 | 内容 |"
DELIMITER = "|---|---|---|---|"
DOC_SUFFIXES = {".md", ".markdown", ".mdx", ".rst", ".txt", ".adoc"}
SKIP_DIRS = {".git", ".skill-runs", "node_modules"}
TODO_RE = re.compile(r"(?:^|(?<=\s))(?://+|/\*+|\*+|#+|--+|;+|<!--|%+)[ \t]*TODO\b(?P<rest>.*)$")
OWNER_RE = re.compile(r"\((?P<owner>[^)]*)\)")
ROW_RE = re.compile(r"^\| `(?P<path>.+)` \| (?P<line>\d+) \| (?P<owner>.*?) \| (?P<text>.*) \|$")
COUNT_RE = re.compile(r"^- 件数: (?P<n>\d+) 件（(?P<files>\d+) ファイル）$")


class Failure(Exception):
    """実行の誤り（終了コード2）。"""


def project_root(start: Path) -> Path:
    current = start.resolve()
    for candidate in [current, *current.parents]:
        if (candidate / ".git").exists():
            return candidate
    return current


def posix(path: str) -> str:
    return Path(path).as_posix()


def in_git(root: Path) -> bool:
    try:
        proc = subprocess.run(["git", "-C", str(root), "rev-parse", "--is-inside-work-tree"],
                              capture_output=True, text=True)
    except OSError:
        return False
    return proc.returncode == 0 and proc.stdout.strip() == "true"


def candidate_paths(root: Path, source: str) -> list[str]:
    """IN-02 の表で、source の下の候補のファイル（ルートからの相対パス）を返す。"""
    target = (root / source).resolve() if not Path(source).is_absolute() else Path(source).resolve()
    if not target.exists():
        raise Failure(f"source が見つからない: {source}")
    try:
        rel_target = target.relative_to(root).as_posix()
    except ValueError:
        rel_target = None
    if rel_target is not None and in_git(root):
        spec = "." if rel_target == "." else ":(literal)" + rel_target
        proc = subprocess.run(["git", "-C", str(root), "ls-files", "-z", "--cached", "--others",
                               "--exclude-standard", "--", spec], capture_output=True)
        if proc.returncode != 0:
            raise Failure("git ls-files が失敗した: " + proc.stderr.decode("utf-8", "replace").strip())
        return sorted({p for p in proc.stdout.decode("utf-8", "surrogateescape").split("\0") if p})
    if target.is_file():
        return [os.path.relpath(target, root).replace(os.sep, "/")]
    found = []
    for current, dirs, files in os.walk(target):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for name in files:
            found.append(os.path.relpath(os.path.join(current, name), root).replace(os.sep, "/"))
    return sorted(found)


def readable(root: Path, rel: str) -> bytes | None:
    """読むファイルなら中身を、読まないファイルなら None を返す（IN-02）。"""
    path = root / rel
    if path.is_symlink() or not path.is_file() or path.suffix.lower() in DOC_SUFFIXES:
        return None
    data = path.read_bytes()
    if b"\0" in data:
        return None
    return data


def escape(cell: str) -> str:
    return cell.replace("|", "\\|")


def parse_todo(line: str) -> tuple[str, str] | None:
    """TODO コメントの行なら（識別子, 内容）を返す（STEP-01、OUT-03）。"""
    match = TODO_RE.search(line)
    if not match:
        return None
    rest = match.group("rest")
    owner = ""
    paren = OWNER_RE.match(rest)
    if paren:
        owner = paren.group("owner").strip()
        rest = rest[paren.end():]
    text = rest.lstrip(" \t:").rstrip()
    for closer in ("*/", "-->"):
        if text.endswith(closer):
            text = text[: -len(closer)].rstrip()
    return escape(owner) or "-", escape(text) or "-"


def collect(root: Path, source: str) -> tuple[list[str], list[tuple[str, int, str, str]]]:
    """（読んだファイル, TODO の行）を返す。行は（パス, 行番号, 識別子, 内容）でパスと行番号の順（OUT-04）。"""
    read, rows = [], []
    for rel in candidate_paths(root, source):
        data = readable(root, rel)
        if data is None:
            continue
        read.append(rel)
        for number, line in enumerate(data.decode("utf-8", "replace").split("\n"), start=1):
            parsed = parse_todo(line.rstrip("\r"))
            if parsed:
                rows.append((rel, number, parsed[0], parsed[1]))
    rows.sort(key=lambda r: (r[0], r[1]))
    return read, rows


def script_rel(root: Path) -> str:
    here = Path(__file__).resolve()
    try:
        return here.relative_to(root.resolve()).as_posix()
    except ValueError:
        return here.as_posix()


def render(root: Path, source: str, rows: list[tuple[str, int, str, str]]) -> str:
    files = len({r[0] for r in rows})
    command = f"python3 {shlex.quote(script_rel(root))} collect --source {shlex.quote(source)}"
    lines = [TITLE, "", f"- 対象: `{source}`", f"- 件数: {len(rows)} 件（{files} ファイル）",
             f"- 数えたコマンド: `{command}`", "", HEADER, DELIMITER]
    lines += [f"| `{escape(path)}` | {number} | {owner} | {text} |" for path, number, owner, text in rows]
    return "\n".join(lines) + "\n"


def verify(root: Path, source: str, text: str) -> list[str]:
    """一覧の Markdown を今のソースと比べ、「<ルールID> <説明>」の行を返す。"""
    read, rows = collect(root, source)
    expected = render(root, source, rows)
    if text == expected:
        return []
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    head = expected.split("\n")[:8]
    if len(lines) < 8 or lines[0] != TITLE or lines[1] != "" or lines[5] != "" or lines[6] != HEADER \
            or lines[7] != DELIMITER or not lines[2].startswith("- 対象: ") \
            or not lines[3].startswith("- 件数: ") or not lines[4].startswith("- 数えたコマンド: "):
        return ["OUT-02 一覧の先頭の8行が見本と違う。次の8行にする: " + " / ".join(head)]
    problems = []
    if lines[2] != head[2]:
        problems.append(f"OUT-06 対象の行が違う。`{head[2]}` にする")
    if lines[4] != head[4]:
        problems.append(f"OUT-06 数えたコマンドの行が違う。`{head[4]}` にする")
    found = []
    for n, line in enumerate(lines[8:], start=9):
        match = ROW_RE.match(line)
        if not match:
            problems.append(f"OUT-02 {n} 行目が表の行の形 `| `<パス>` | <行> | <識別子> | <内容> |` でない: {line[:80]}")
            continue
        found.append((match.group("path").replace("\\|", "|"), int(match.group("line")),
                      match.group("owner"), match.group("text")))
    if any(p.startswith("OUT-02") for p in problems):
        return problems
    by_key = {(r[0], r[1]): r for r in rows}
