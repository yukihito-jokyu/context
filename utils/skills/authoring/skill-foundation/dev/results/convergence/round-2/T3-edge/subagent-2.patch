    seen = set()
    for path, number, owner, cell in found:
        key = (path, number)
        if key in seen:
            problems.append(f"OUT-05 {path}:{number} の行が2回ある。1回にする")
            continue
        seen.add(key)
        if path not in read_set:
            problems.append(f"IN-02 {path} は読む範囲の外（git の除外、文書の拡張子、バイナリ、source の外）。この行を消す")
        elif key not in by_key:
