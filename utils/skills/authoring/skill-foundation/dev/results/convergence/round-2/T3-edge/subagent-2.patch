        else:
            want = by_key[key]
            if owner != want[2] or cell != want[3]:
                problems.append(f"OUT-03 {path}:{number} の識別子か内容が元のコメントと違う。"
                                f"`| {want[2]} | {want[3]} |` にする")
    for key in by_key:
        if key not in seen:
            problems.append(f"OUT-05 {key[0]}:{key[1]} の TODO コメントが載っていない")
    keys = [(r[0], r[1]) for r in found]
    if keys != sorted(keys):
        problems.append("OUT-04 表の行がパスの文字コード順、同じファイルは行番号の順に並んでいない")
    count = COUNT_RE.match(lines[3])
    files = len({r[0] for r in found})
    if not count or int(count.group("n")) != len(found) or int(count.group("files")) != files:
        problems.append(f"OUT-04 件数の行が表と合わない。`- 件数: {len(found)} 件（{files} ファイル）` にする")
    if not problems:
        problems.append("OUT-02 空行か行の区切りが見本と違う。collect_todo.py collect で書き直す")
    return problems


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p_collect = sub.add_parser("collect", help="一覧の Markdown を書く")
    p_collect.add_argument("--source", default=".", help="調べるディレクトリ（ルートからの相対パス）")
    p_collect.add_argument("--out", help="書き込む先（ルートからの相対パス）。無ければ標準出力")
    p_collect.add_argument("--root", help="プロジェクトのルート")
    p_verify = sub.add_parser("verify", help="一覧の Markdown を今のソースと比べる")
    p_verify.add_argument("--file", required=True, help="一覧のファイル（ルートからの相対パス）")
    p_verify.add_argument("--source", default=".", help="調べるディレクトリ（ルートからの相対パス）")
