#!/usr/bin/env python3
"""ステージした変更を集め、コミットメッセージの本文と照らし合わせる（write-commit-message 固有のスクリプト）。

この決定の how に挙がっている: IN-01、STEP-01、STEP-02、OUT-03、OUT-05、OUT-07

サブコマンド:
  collect  ステージしたファイルの一覧（`git diff --cached -M --name-status -z` の順）、本文の各行の頭、
           ブランチ名から見つけたチケットID、ステージした差分を、ラベル付きで出す
  check    コミットメッセージのファイルの3行目以降（本文）が、ステージしたファイルと1対1で同じ順に並び、
           各行が「- <パス>: <説明>」の形で、説明が 40 文字以下かを確かめる。指摘は「<ルールID> <説明>」の行で出す
  command  finish の本文に入れる節（コミットのコマンド）を Markdown で出す

終了コード:
  0 成功（check は指摘なし）
  1 check の指摘あり
  2 実行の誤り（git が無い、git のリポジトリの中でない、ファイルが読めない）
  4 collect: ステージした変更が0件
  5 collect: 解決していない衝突（状態 U）がある

使い方:
  python3 staged_changes.py collect [--root <プロジェクトのルート>]
  python3 staged_changes.py check <メッセージのファイル> [--root <プロジェクトのルート>]
  python3 staged_changes.py command --message-file <メッセージのファイル> [--root <プロジェクトのルート>]
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

TICKET = re.compile(r"(?<![A-Za-z0-9_])[A-Z][A-Z0-9_]+-[0-9]+(?![0-9])")
MAX_DESCRIPTION = 40


def git(root: Path, *args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-c", "core.quotePath=false", *args], cwd=root, capture_output=True)


def in_repository(root: Path) -> bool:
    try:
        proc = git(root, "rev-parse", "--is-inside-work-tree")
    except OSError:
        return False
    return proc.returncode == 0 and proc.stdout.strip() == b"true"


def staged(root: Path) -> list[tuple[str, list[str]]]:
    """ステージした変更の（状態の文字, パスの一覧）。名前の変更とコピーはパスが2つ（元、新）。"""
    proc = git(root, "diff", "--cached", "-M", "--name-status", "-z")
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.decode("utf-8", "replace").strip())
    fields = proc.stdout.decode("utf-8", "surrogateescape").split("\0")
    entries, i = [], 0
    while i < len(fields) and fields[i]:
        status = fields[i][0]
        width = 2 if status in ("R", "C") else 1
        entries.append((status, fields[i + 1:i + 1 + width]))
        i += 1 + width
    return entries


def prefix(entry: tuple[str, list[str]]) -> str:
    """本文の行の頭。名前の変更は「- <元のパス> -> <新しいパス>: 」。"""
    _, paths = entry
    return f"- {' -> '.join(paths)}: "


def branch(root: Path) -> str:
    proc = git(root, "branch", "--show-current")
    return proc.stdout.decode("utf-8", "replace").strip() if proc.returncode == 0 else ""


def branch_tickets(name: str) -> list[str]:
    found = []
    for match in TICKET.findall(name):
        if match not in found:
            found.append(match)
    return found


def cmd_collect(root: Path) -> int:
    if not in_repository(root):
        print("git のリポジトリの中でない（IN-01: 止める）")
        return 2
    entries = staged(root)
    current = branch(root)
    tickets = branch_tickets(current)
    print(f"ブランチ: {current or '（切り離された HEAD）'}")
    if len(tickets) == 1:
        print(f"ブランチのチケットID: {tickets[0]}")
    elif tickets:
        print(f"ブランチのチケットID: 2つ以上（{'、'.join(tickets)}）。依頼に無ければ利用者に聞く（OUT-05）")
    else:
        print("ブランチのチケットID: なし。依頼に無ければ利用者に聞く（OUT-05）")
    print(f"ステージしたファイル: {len(entries)}")
    if not entries:
        print("ステージした変更が無い（IN-01: 止める）")
        return 4
    unmerged = [paths[0] for status, paths in entries if status == "U"]
    if unmerged:
        print(f"解決していない衝突: {'、'.join(unmerged)}（IN-01: 止める）")
        return 5
    print("本文の行（3行目から、この順で1行ずつ写し、`: ` の後に 40 文字以下の説明を書く。OUT-03、OUT-07）:")
    for entry in entries:
        print(prefix(entry))
    print("差分:")
    diff = git(root, "diff", "--cached", "-M", "--no-color", "--no-ext-diff")
    sys.stdout.write(diff.stdout.decode("utf-8", "replace"))
    return 0


def cmd_check(root: Path, file: str) -> int:
    path = Path(file) if Path(file).is_absolute() else root / file
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"メッセージのファイルを読めません: {exc}")
        return 2
    if not in_repository(root):
        print("git のリポジトリの中でない")
        return 2
    entries = staged(root)
    body = lines[2:]
    while body and not body[-1].strip():
        body.pop()
    problems = []
    if not entries:
        problems.append("OUT-03 ステージしたファイルがありません。コミットやステージの状態を変えていないか確かめてください（STEP-02）")
    if len(body) != len(entries):
        problems.append(f"OUT-03 本文の行は {len(body)} 行ですが、ステージしたファイルは {len(entries)} 件です。"
                        "`staged_changes.py collect` の「本文の行」を1件1行で、空行を挟まずに写してください")
    for number, (line, entry) in enumerate(zip(body, entries), 3):
        head = prefix(entry)
        if not line.startswith(head):
            problems.append(f"OUT-03 {number}行目は `{head.rstrip()}` で始めてください（今: {line[:60]}）")
            continue
        description = line[len(head):]
        if not description.strip():
            problems.append(f"OUT-03 {number}行目の説明が空です")
        elif description != description.strip():
            problems.append(f"OUT-03 {number}行目の説明の前後に空白を入れないでください")
        elif len(description) > MAX_DESCRIPTION:
            problems.append(f"OUT-07 {number}行目の説明は {MAX_DESCRIPTION} 文字以下にしてください（今 {len(description)} 文字）")
    for problem in problems:
        print(problem)
    return 1 if problems else 0


def cmd_command(root: Path, message_file: str) -> int:
    if not in_repository(root):
        print("git のリポジトリの中でない")
        return 2
    count = len(staged(root))
    print("## コミットのコマンド")
    print()
    print(f"ステージした {count} ファイルを、このメッセージでコミットするには次を実行する（STEP-02。このスキルはコミットしない）。")
    print()
    print("```sh")
    print(f"git commit -F {message_file}")
    print("```")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    p_collect = sub.add_parser("collect", help="ステージした変更を集める")
    p_collect.add_argument("--root", default=".")
    p_check = sub.add_parser("check", help="本文をステージしたファイルと照らし合わせる")
    p_check.add_argument("file")
    p_check.add_argument("--root", default=".")
    p_command = sub.add_parser("command", help="finish の本文に入れるコミットのコマンドを出す")
    p_command.add_argument("--message-file", required=True)
    p_command.add_argument("--root", default=".")
    args = parser.parse_args()
    root = Path(args.root).resolve()
    try:
        if args.command == "collect":
            return cmd_collect(root)
        if args.command == "check":
            return cmd_check(root, args.file)
        return cmd_command(root, args.message_file)
    except (OSError, RuntimeError) as exc:
        print(f"git を実行できません: {exc}")
        return 2


if __name__ == "__main__":
    sys.exit(main())

