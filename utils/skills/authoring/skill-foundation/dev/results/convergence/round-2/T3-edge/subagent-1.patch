        source = normalize_source(root, args.source)
        if args.check:
            problems = compare(root, source, args.check)
            for line in problems:
                print(line)
            return 1 if problems else 0
        files, rows = collect(root, source)
        text = render(root, source, files, rows)
        if args.out:
            out = Path(args.out)
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(text, encoding="utf-8")
            print(f"一覧を書きました: {args.out}（調べたファイル: {len(files)} 件、TODO コメント: {len(rows)} 件）")
        else:
            sys.stdout.write(text)
        return 0
    except Stop as stop:
        print(str(stop), file=sys.stderr)
        return stop.code


if __name__ == "__main__":
    sys.exit(main())

