#!/usr/bin/env python3
"""ソースコードの TODO コメントを集め、一覧の Markdown を出す。--check では、一覧のファイルを集め直した結果と比べる。

決定: IN-01（終了コード）、IN-02（読む範囲）、STEP-01（集める・数える・並べる）、STEP-02（TODO コメントの条件）、
      OUT-01（--out の置き場）、OUT-02（形）、OUT-03（原文のまま写す）、OUT-04（並べ順）、OUT-05（対象と数えたコマンド）

読むファイル: `git ls-files -c -o --exclude-standard -- <source>` が挙げたファイルのうち、拡張子が LANGUAGES にあるもの。
             NUL バイトがあるファイル、シンボリックリンク、サブモジュール、このスキル自身のディレクトリは読まない。
--source はリポジトリのルートからの相対パスで書く（既定 `.`）。

出力: 一覧の Markdown。--out を付けるとそのファイルに書き、付けないと標準出力に出す。
      --check を付けると、ファイルの一覧と集め直した一覧の違いを「<ルールID> <説明>」の行で出す。
終了コード: 0 成功（--check では違いなし）、1 --check で違いあり、2 実行の誤り（git の失敗、引数の誤り）、
           4 git のリポジトリの外で実行した、5 --source がリポジトリの中に無い

使い方:
  python3 collect_todo.py [--source <パス>] [--out <ファイル>]
  python3 collect_todo.py [--source <パス>] --check <ファイル>
"""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent
TITLE = "# TODO コメントの一覧"
TABLE_HEAD = "| ファイル | 行 | コメント |"
TABLE_RULE = "|---|---|---|"
EMPTY = "TODO コメントは無い。"
META_LABELS = ("対象", "調べたファイル", "TODO コメント", "数えたコマンド")
MARKER = re.compile(r"TODO(?![0-9A-Za-z_])")
DECORATION = " \t*/#!-"

# 拡張子ごとの（行コメントの記号、ブロックコメントの組、文字列の引用符（開き, 閉じ, 行をまたぐか））。STEP-02 の表と同じ。
HASH = (("#",), (), (('"', '"', False), ("'", "'", False)))
LANGUAGES: dict[str, tuple] = {
    ".py": (("#",), (), (('"""', '"""', True), ("'''", "'''", True), ('"', '"', False), ("'", "'", False))),
    ".rb": HASH, ".sh": HASH, ".bash": HASH, ".zsh": HASH,
}
for ext in (".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".go"):
    LANGUAGES[ext] = (("//",), (("/*", "*/"),), (("`", "`", True), ('"', '"', False), ("'", "'", False)))
for ext in (".java", ".swift"):
    LANGUAGES[ext] = (("//",), (("/*", "*/"),), (('"""', '"""', True), ('"', '"', False), ("'", "'", False)))
for ext in (".c", ".h", ".cc", ".cpp", ".hpp"):
    LANGUAGES[ext] = (("//",), (("/*", "*/"),), (('"', '"', False), ("'", "'", False)))
LANGUAGES[".sql"] = (("--",), (("/*", "*/"),), (('"', '"', False), ("'", "'", False)))
for ext in (".html", ".htm", ".xml"):
    LANGUAGES[ext] = ((), (("<!--", "-->"),), ())


class Stop(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def git(root: Path | None, *args: str) -> str:
    command = ["git", "--literal-pathspecs", *([] if root is None else ["-C", str(root)]), *args]
    try:
        proc = subprocess.run(command, capture_output=True, timeout=120)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Stop(2, f"git を実行できません: {exc}")
    if proc.returncode != 0:
        raise Stop(2, f"git {' '.join(args[:2])} が失敗しました: {proc.stderr.decode('utf-8', 'replace').strip()}")
    return proc.stdout.decode("utf-8", "surrogateescape")


def find_root() -> Path:
    try:
        proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise Stop(2, f"git を実行できません: {exc}")
    if proc.returncode != 0 or not proc.stdout.strip():
        raise Stop(4, "git のリポジトリの外で実行しました（IN-01）")
    return Path(proc.stdout.strip()).resolve()


def normalize_source(root: Path, raw: str) -> str:
    """--source をリポジトリのルートからの相対パス（POSIX 形式。ルートは `.`）にする。無ければ終了コード5。"""
    text = (raw or ".").strip().replace("\\", "/") or "."
    path = Path(text)
    full = (path if path.is_absolute() else root / path).resolve()
    try:
        rel = full.relative_to(root).as_posix()
    except ValueError:
        raise Stop(5, f"調べる範囲がリポジトリの中に無い: {raw}（IN-01）")
    if not full.exists():
        raise Stop(5, f"調べる範囲がリポジトリの中に無い: {raw}（IN-01）")
    return rel if rel and rel != "." else "."


def list_files(root: Path, source: str) -> list[str]:
    """読むファイル（IN-02）の相対パスを昇順で返す。"""
    out = git(root, "ls-files", "-z", "-c", "-o", "--exclude-standard", "--", source)
    found = set()
    for rel in out.split("\0"):
        if not rel or Path(rel).suffix.lower() not in LANGUAGES:
            continue
        full = root / rel
        if full.is_symlink() or not full.is_file():
            continue
        try:
            full.resolve().relative_to(SKILL_DIR)
            continue  # このスキル自身のファイルは読まない
        except ValueError:
            pass
        found.add(rel)
    return sorted(found)


def comment_texts(line: str, lang: tuple, state: dict) -> list[str]:
    """1行のコメントの部分（記号を除いた中身）を左から順に返す。state は行をまたぐブロックコメントと文字列を持つ。"""
    line_tokens, blocks, quotes = lang
    texts, i, n = [], 0, len(line)
    while i < n:
        if state.get("block"):
            end = line.find(state["block"], i)
            texts.append(line[i:] if end < 0 else line[i:end])
            if end < 0:
                return texts
            i, state["block"] = end + len(state["block"]), None
            continue
        if state.get("string"):
            close = state["string"]
            j = i
            while j < n:
                if line[j] == "\\":
                    j += 2
                    continue
                if line.startswith(close, j):
                    break
                j += 1
            if j >= n:
                if not state.get("multiline"):
                    state["string"] = None
                return texts
            i, state["string"], state["multiline"] = j + len(close), None, False
            continue
        token = next((t for t in line_tokens if line.startswith(t, i)), None)
        if token:
            texts.append(line[i + len(token):])
            return texts
        block = next((b for b in blocks if line.startswith(b[0], i)), None)
        if block:
            i, state["block"] = i + len(block[0]), block[1]
            continue
        quote = next((q for q in quotes if line.startswith(q[0], i)), None)
        if quote:
            i, state["string"], state["multiline"] = i + len(quote[0]), quote[1], quote[2]
            continue
        i += 1
    if state.get("string") and not state.get("multiline"):
        state["string"] = None
    return texts


def todo_text(comment: str) -> str | None:
    """コメントの中身の先頭（空白と飾りの文字を除く）が TODO なら、TODO から後ろを返す（STEP-02、OUT-03）。"""
    body = comment.lstrip(DECORATION)
    if MARKER.match(body):
        return body.rstrip()
    return None


def scan(root: Path, rel: str) -> list[tuple[int, str]] | None:
    """ファイル1つの TODO コメントを（行番号, コメント）で返す。NUL バイトがあれば None（読まない）。"""
    data = (root / rel).read_bytes()
    if b"\0" in data:
        return None
    lang = LANGUAGES[Path(rel).suffix.lower()]
    state: dict = {}
    found = []
    for number, line in enumerate(data.decode("utf-8", "replace").split("\n"), 1):
        line = line.rstrip("\r")
