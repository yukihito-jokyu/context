    for key in order:
        if key not in seen_keys:
            problems.append(f"STEP-01 {key[0]}:{key[1]} の TODO コメントが一覧にありません。collect_todo.py の出力を書き換えずに使ってください")
    common = [k for k in actual_keys if k in expected]
    if common != [k for k in order if k in seen_keys]:
        problems.append(f"OUT-04 {rel_file} の行の並びが違います。パスの昇順、同じファイルでは行番号の昇順に並べてください")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--source", default=".", help="調べる範囲（リポジトリのルートからの相対パス。既定 .）")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--out", help="一覧を書くファイル")
    group.add_argument("--check", help="比べる一覧のファイル")
    args = parser.parse_args()
    try:
