def escape(text: str) -> str:
    return text.replace("|", "\\|")


def command_line(root: Path, source: str) -> str:
    script = Path(__file__).resolve()
    try:
        shown = script.relative_to(root).as_posix()
    except ValueError:
        shown = script.as_posix()
    return f"python3 {shlex.quote(shown)} --source {shlex.quote(source)}"


def render(root: Path, source: str, files: list[str], rows: list[tuple[str, int, str]]) -> str:
    lines = [TITLE, "",
             f"- 対象: `{escape(source)}`",
             f"- 調べたファイル: {len(files)} 件",
             f"- TODO コメント: {len(rows)} 件",
             f"- 数えたコマンド: `{command_line(root, source)}`",
             ""]
    if rows:
        lines += [TABLE_HEAD, TABLE_RULE] + [f"| `{escape(rel)}` | {number} | {escape(text)} |" for rel, number, text in rows]
    else:
        lines.append(EMPTY)
    return "\n".join(lines) + "\n"


META_RE = re.compile(r"^- (" + "|".join(re.escape(l) for l in META_LABELS) + r"): (.*)$")
ROW_RE = re.compile(r"^\| `[^`]+` \| \d+ \| (?:[^|\\]|\\.)+ \|$")
RULE_RE = re.compile(r"^\|(?:\s*:?-+:?\s*\|)+$")


def table_rows(lines: list[str]) -> list[int]:
    """表の本文の行の番号（0 から）。見出しの行（区切りの直前）と区切りの行は除く。"""
    heads = {i - 1 for i, line in enumerate(lines) if RULE_RE.match(line.strip())}
    return [i for i, line in enumerate(lines)
            if line.startswith("|") and i not in heads and not RULE_RE.match(line.strip())]


def skeleton(lines: list[str]) -> list[str]:
    """値を伏せた行の並び（OUT-02）。表の本文の行は、形が合えば1つの ROWS にまとめる。"""
    rows = set(table_rows(lines))
    shape = []
    for i, line in enumerate(lines):
        meta = META_RE.match(line)
        if meta:
            shape.append(f"- {meta.group(1)}: …")
        elif i in rows:
            if not ROW_RE.match(line):
                shape.append(f"形の違う行: {line[:60]}")
            elif not shape or shape[-1] != "ROWS":
                shape.append("ROWS")
        else:
            shape.append(line.rstrip())
    while shape and shape[-1] == "":
        shape.pop()
    return shape


def parse_row(line: str) -> tuple[str, int, str] | None:
    cells = [c.strip() for c in re.split(r"(?<!\\)\|", line.strip())[1:-1]]
