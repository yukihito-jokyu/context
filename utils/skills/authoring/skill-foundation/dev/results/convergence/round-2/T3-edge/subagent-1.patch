def collect(root: Path, source: str) -> tuple[list[str], list[tuple[str, int, str]]]:
    files, rows = [], []
    for rel in list_files(root, source):
        found = scan(root, rel)
        if found is None:
            continue
        files.append(rel)
        rows += [(rel, number, text) for number, text in found]
