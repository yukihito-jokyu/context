"""ステージ済みの差分から、変更履歴の1節を書く材料を集める。

決定: STEP-01、IN-01、IN-02、OUT-06

出力（標準出力）:
  ステージ済みのファイル: <数>
  対象のファイル: <数>
  除外したファイル: <数>
  項目の数の上限: <対象のファイルの数と5の小さい方>

  ## 対象のファイル
  <状態>\t<パス>            （パスの昇順。状態は git の A・C・D・M・R・T・U・X）
  ## 除外したファイル
  <状態>\t<パス>\t<理由>     （理由は 変更履歴・テスト・CI・ロックファイル）
  ## 差分
  <対象のファイルの git diff --cached。1ファイル400行を超えた分は省く>

記録: <ルート>/.skill-runs/write-changelog-entry/staged.json（ステージの状態の指紋、件数、上限）

終了コード:
  0 成功
  2 実行の誤り（git のリポジトリでない、git の失敗）
  4 ステージ済みの差分が無い
  5 対象のファイルが無い（ステージ済みのファイルがすべて除外の対象）

使い方:
  python3 collect_staged.py [--root <プロジェクトのルート>]
"""
import argparse
import hashlib
import json
import os
import subprocess
import sys

MAX_ITEMS = 5
MAX_DIFF_LINES_PER_FILE = 400
RUN_DIR = os.path.join(".skill-runs", "write-changelog-entry")

LOCK_FILES = {
    "package-lock.json", "yarn.lock", "pnpm-lock.yaml", "poetry.lock", "uv.lock",
    "pipfile.lock", "cargo.lock", "go.sum", "gemfile.lock", "composer.lock",
}
TEST_DIRS = {"test", "tests", "__tests__", "spec"}
CI_DIRS = {".github", ".gitlab", ".circleci"}


def git(root, *args, binary=False):
    cmd = ["git", "-C", root, "-c", "core.quotepath=false", "--literal-pathspecs"] + list(args)
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if res.returncode != 0:
        raise RuntimeError(res.stderr.decode("utf-8", "replace").strip() or "git の失敗: " + " ".join(args))
    return res.stdout if binary else res.stdout.decode("utf-8", "replace")


def classify(path):
    """IN-02 の表を上から当てはめ、除外の理由を返す。対象なら None。"""
    parts = path.split("/")
    name = parts[-1]
    lower = name.lower()
    dirs = parts[:-1]
    if lower == "changelog.md":
        return "変更履歴"
    if any(d in TEST_DIRS for d in dirs) or lower.startswith("test_") \
            or "_test." in lower or ".test." in lower or ".spec." in lower:
        return "テスト"
    if any(d in CI_DIRS for d in dirs) or lower == ".gitlab-ci.yml":
        return "CI"
    if lower in LOCK_FILES:
        return "ロックファイル"
    return None


def parse_name_status(raw):
    """`git diff --cached --name-status -M -z` を (状態, 古いパス, パス) の一覧にする。"""
    fields = raw.split("\0")
    entries = []
    i = 0
    while i < len(fields) and fields[i]:
        status = fields[i]
        letter = status[0]
        if letter in ("R", "C"):
            old, new = fields[i + 1], fields[i + 2]
            i += 3
        else:
            old = new = fields[i + 1]
            i += 2
        entries.append((letter, old, new))
    return entries


def fingerprint(root):
    raw = git(root, "diff", "--cached", "--raw", "-z", "-M", "--no-abbrev", binary=True)
    return hashlib.sha256(raw).hexdigest()


def trim_diff(text):
    out = []
    blocks = []
    for line in text.splitlines():
        if line.startswith("diff --git ") or not blocks:
            blocks.append([])
        blocks[-1].append(line)
    for block in blocks:
        if len(block) > MAX_DIFF_LINES_PER_FILE:
            omitted = len(block) - MAX_DIFF_LINES_PER_FILE
            block = block[:MAX_DIFF_LINES_PER_FILE] + ["（以下 {} 行を省略）".format(omitted)]
        out.extend(block)
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=".")
    args = ap.parse_args()

    try:
        root = git(os.path.abspath(args.root), "rev-parse", "--show-toplevel").strip()
    except (RuntimeError, OSError):
        print("git のリポジトリでない: " + os.path.abspath(args.root))
        return 2

    try:
        entries = parse_name_status(git(root, "diff", "--cached", "--name-status", "-M", "-z", "--no-color"))
        fp = fingerprint(root)
    except RuntimeError as e:
        print("git の失敗: " + str(e).splitlines()[0])
        return 2

    entries.sort(key=lambda e: e[2])
    targets = []
    excluded = []
    for letter, old, path in entries:
        reason = classify(path)
        if reason is None:
            targets.append((letter, old, path))
        else:
            excluded.append((letter, path, reason))
    max_items = min(len(targets), MAX_ITEMS)

    run_dir = os.path.join(root, RUN_DIR)
    os.makedirs(run_dir, exist_ok=True)
    record = {
        "fingerprint": fp,
        "staged": len(entries),
        "targets": [{"status": l, "path": p} for l, _, p in targets],
        "excluded": [{"status": l, "path": p, "reason": r} for l, p, r in excluded],
        "max_items": max_items,
    }
    with open(os.path.join(run_dir, "staged.json"), "w", encoding="utf-8") as f:
        json.dump(record, f, ensure_ascii=False, indent=2)
        f.write("\n")

    if not entries:
        print("ステージ済みの差分が無い")
        return 4
    if not targets:
        print("変更履歴に載せるファイルが無い（除外の対象だけ）")
        for letter, path, reason in excluded:
            print("{}\t{}\t{}".format(letter, path, reason))
        return 5

    print("ステージ済みのファイル: {}".format(len(entries)))
    print("対象のファイル: {}".format(len(targets)))
    print("除外したファイル: {}".format(len(excluded)))
    print("項目の数の上限: {}".format(max_items))
    print("")
    print("## 対象のファイル")
    for letter, _, path in targets:
        print("{}\t{}".format(letter, path))
    print("## 除外したファイル")
    for letter, path, reason in excluded:
        print("{}\t{}\t{}".format(letter, path, reason))
    print("## 差分")
    pathspecs = []
    for _, old, path in targets:
        for p in (old, path):
            if p not in pathspecs:
                pathspecs.append(p)
    try:
        diff = git(root, "diff", "--cached", "--no-color", "--no-ext-diff", "-M", "--", *pathspecs)
    except RuntimeError as e:
        print("git の失敗: " + str(e).splitlines()[0])
        return 2
    print(trim_diff(diff))
    return 0


if __name__ == "__main__":
    sys.exit(main())

