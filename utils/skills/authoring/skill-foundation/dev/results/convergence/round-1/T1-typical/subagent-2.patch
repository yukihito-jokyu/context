#!/usr/bin/env python3
"""コミットメッセージの行の形、本文のファイルの一覧と並び、説明の長さを、ステージした変更と比べて確かめる。

決定: OUT-02（行の形）、STEP-02（本文のファイルの一覧）、OUT-04（並べ順）、OUT-05（説明の長さ）。
契約（assets/contract.json）の command 検査から呼ばれる。

出力: 指摘ごとに `<ルールID> <説明>` の1行。指摘が無ければ何も出さない。
  行の形（OUT-02）が崩れているときは、ほかの検査をしない。

終了コード: 0 指摘なし、1 指摘あり、2 実行の誤り（ファイルが読めない、git が使えない）

使い方:
  python3 check_message.py <メッセージのファイル> [--root <プロジェクトのルート>]
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from collect_changes import TICKET_FULL, staged_entries  # noqa: E402

MAX_DESCRIPTION = 50
BULLET = re.compile(r"^- \S.*?: \S")


def structure_problems(lines: list[str]) -> list[str]:
    problems = []
    if len(lines) < 3:
        return [f"OUT-02 1行目、空行、箇条書きの3行以上が要ります（今 {len(lines)} 行）"]
    head, _, rest = lines[0].partition(" ")
    if not TICKET_FULL.match(head) or not rest.strip() or rest != rest.lstrip():
        problems.append("OUT-02 1行目が `<チケットID> <説明>`（間は半角空白1つ）の形ではありません")
    if lines[1] != "":
        problems.append("OUT-02 2行目は空行にします")
    for n, line in enumerate(lines[2:], 3):
        if not BULLET.match(line):
            problems.append(f"OUT-02 {n}行目が `- <パス>: <説明>` の形ではありません: {line[:60]}")
    return problems


def split_bullet(line: str, expected: list[str]) -> tuple[str, str]:
    """箇条書きの行を（パス, 説明）に分ける。ひな形のパスに当たればそれを優先する。"""
    hits = [p for p in expected if line.startswith(f"- {p}: ")]
    if hits:
        path = max(hits, key=len)
        return path, line[len(path) + 4:]
    body = line[2:]
    path, _, description = body.partition(": ")
    return path, description


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("file", help="コミットメッセージのファイル")
    parser.add_argument("--root", default=".", help="プロジェクトのルート（既定は今のディレクトリ）")
    args = parser.parse_args()
    root = Path(args.root)
    path = Path(args.file)
    if not path.is_absolute():
        path = root / path
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"メッセージのファイルを読めません: {exc}")
        return 2

    problems = structure_problems(lines)
    if problems:
        print("\n".join(problems))
        return 1
    try:
        expected = [p for _, p in staged_entries(root)]
    except RuntimeError as exc:
        print(f"git diff --cached を実行できません: {exc}")
        return 2

    pairs = [split_bullet(line, expected) for line in lines[2:]]
    written = [p for p, _ in pairs]
    for p in expected:
        if p not in written:
            problems.append(f"STEP-02 本文に `{p}` の行がありません（collect_changes.py のひな形の行を写します）")
    for p in dict.fromkeys(written):
        if p not in expected:
            problems.append(f"STEP-02 `{p}` はステージしたファイルの行ではありません（ひな形に無い行を足しません）")
        elif written.count(p) > 1:
            problems.append(f"STEP-02 `{p}` の行が {written.count(p)} 行あります（1ファイル1行にします）")
    if not problems and written != expected:
        problems.append("OUT-04 箇条書きの並びが collect_changes.py のひな形の順と違います（正しい順: "
                        + "、".join(expected) + "）")
    for p, description in pairs:
        if len(description) > MAX_DESCRIPTION:
            problems.append(f"OUT-05 `{p}` の説明が {len(description)} 文字です（{MAX_DESCRIPTION} 文字以下にします）")
    if problems:
        print("\n".join(problems))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

