#!/usr/bin/env python3
"""ステージした変更から、チケットIDと本文の行のひな形を出す。

決定: IN-01（対象外の判定）、STEP-01（チケットIDの取り先）、STEP-02（本文の行のひな形）

出力（標準出力。終了コード0のとき）:
  チケットID: <値>（取り先: 依頼 | ブランチ <ブランチ名>）
  ステージしたファイル: <件数>
  ファイル（本文の順）:
    1. <状態> <パス>
  本文の行のひな形:
  - <パス>:
  （改名と複写の行は `- <旧パス> -> <新パス>: `。並びは `git diff --cached --name-status -M` の順）

対象外のときは、次のどれかの行を出す。
  ERROR <説明>       終了コード2（git が無い、git のリポジトリでない、未マージのファイルがある）
  NO_STAGED <説明>   終了コード1（ステージした変更が無い）
  BAD_TICKET <説明>  終了コード1（--ticket の値がチケットIDの形 [A-Z][A-Z0-9_]+-[0-9]+ でない）
  ASK_TICKET <説明>  終了コード3（--ticket が無く、ブランチ名にもチケットIDが無い）

終了コード: 0 成功、1 対象外、2 実行の誤り、3 チケットIDをユーザーに聞く必要がある

使い方:
  python3 collect_changes.py [--ticket <依頼のチケットID>] [--root <プロジェクトのルート>]
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

TICKET_FULL = re.compile(r"^[A-Z][A-Z0-9_]+-[0-9]+$")
TICKET_IN_BRANCH = re.compile(r"(?<![A-Za-z0-9_])[A-Z][A-Z0-9_]+-[0-9]+(?![0-9])")
STATUS_LABELS = {"A": "追加", "C": "複写", "D": "削除", "M": "変更", "R": "改名", "T": "種類の変更", "U": "未マージ",
                 "X": "不明"}


def git(root: Path, *args: str) -> tuple[int, str]:
    try:
        proc = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, encoding="utf-8",
                              errors="surrogateescape", timeout=30)
    except FileNotFoundError:
        return 127, "git が見つかりません"
    return proc.returncode, proc.stdout if proc.returncode == 0 else proc.stderr


def staged_entries(root: Path) -> list[tuple[str, str]]:
    """（状態の記号, 本文に書くパス）の一覧を git の順で返す。git が使えなければ RuntimeError。"""
    code, out = git(root, "diff", "--cached", "--name-status", "-M", "-z")
    if code != 0:
        raise RuntimeError(out.strip().splitlines()[-1] if out.strip() else "git diff --cached が失敗しました")
    tokens = out.split("\0")
    entries, i = [], 0
    while i < len(tokens) and tokens[i]:
        status = tokens[i][0]
        if status in ("R", "C"):
            entries.append((status, f"{tokens[i + 1]} -> {tokens[i + 2]}"))
            i += 3
        else:
            entries.append((status, tokens[i + 1]))
            i += 2
    return entries


def branch_name(root: Path) -> str:
    code, out = git(root, "symbolic-ref", "--short", "-q", "HEAD")
    return out.strip() if code == 0 else ""


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--ticket", default="", help="依頼にあったチケットID")
    parser.add_argument("--root", default=".", help="プロジェクトのルート（既定は今のディレクトリ）")
    args = parser.parse_args()
    root = Path(args.root)

    code, out = git(root, "rev-parse", "--is-inside-work-tree")
    if code != 0 or out.strip() != "true":
        print(f"ERROR git のリポジトリではありません: {root.resolve()}")
        return 2
    try:
        entries = staged_entries(root)
    except RuntimeError as exc:
        print(f"ERROR {exc}")
        return 2
    if any(status == "U" for status, _ in entries):
        print("ERROR 未マージのファイルがあります。マージを終えてから依頼してください")
        return 2
    if not entries:
        print("NO_STAGED ステージした変更がありません")
        return 1

    raw = args.ticket.strip()
    if raw:
        ticket, source = raw.upper(), "依頼"
        if not TICKET_FULL.match(ticket):
            print(f"BAD_TICKET 「{raw}」はチケットIDの形（[A-Z][A-Z0-9_]+-[0-9]+、例：PROJ-123）ではありません")
            return 1
    else:
        branch = branch_name(root)
        found = TICKET_IN_BRANCH.search(branch)
        if not found:
            print("ASK_TICKET 依頼にもブランチ名にもチケットIDがありません。チケットID（例：PROJ-123）を聞いてください")
            return 3
        ticket, source = found.group(0), f"ブランチ {branch}"

    print(f"チケットID: {ticket}（取り先: {source}）")
    print(f"ステージしたファイル: {len(entries)}")
    print("ファイル（本文の順）:")
    for n, (status, path) in enumerate(entries, 1):
        print(f"  {n}. {STATUS_LABELS.get(status, status)} {path}")
    print("本文の行のひな形:")
    for _, path in entries:
        print(f"- {path}: ")
    return 0


if __name__ == "__main__":
    sys.exit(main())

