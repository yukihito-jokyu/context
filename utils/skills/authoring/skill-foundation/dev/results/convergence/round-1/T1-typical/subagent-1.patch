#!/usr/bin/env python3
"""ステージした変更を集め、コミットメッセージの本文の行頭と、差分の読み方を出す。

この出力を使う決定: IN-01（中断する状況の判定）、IN-02（差分の読み方）、STEP-02（一覧と順序をスクリプトに任せる）、
OUT-02（本文の行頭）、OUT-04（行の順とパスの表記）。

出力（標準出力）:
  チケットID: <ID>
  変更ファイル数: <N>
  ## 本文の行頭 … この順で1ファイル1行。「- <パス>: 」の後に説明を書く
  ## 差分の読み方 … ファイルごとの変更の種類、行数、読むコマンド（IN-02 の表で決めたもの）
  中断するときは「中断の理由: <理由>」の1行だけを出す

終了コード:
  0 成功
  2 使い方の誤り
  4 中断する状況（git のリポジトリでない、チケットIDの形が違う、ステージした変更が無い、未マージのファイルがある）

使い方:
  python3 <skill>/scripts/collect_changes.py --ticket ABC-123 [--root <リポジトリのルート>]
"""
import argparse
import os
import shlex
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _changes  # noqa: E402


def abort(reason):
    print("中断の理由: {}".format(reason))
    return 4


def read_plan(change):
    """IN-02 の表: バイナリは読まない。追加と削除の合計が 500 以下なら全体を読む。それ以外は読まない。"""
    if change["added"] is None or change["deleted"] is None:
        return "バイナリ", "読まない（変更の種類だけで説明を書く）"
    total = change["added"] + change["deleted"]
    lines = "+{} -{}".format(change["added"], change["deleted"])
    if total <= _changes.FULL_DIFF_MAX:
        paths = [change["old"], change["path"]] if change["old"] else [change["path"]]
        cmd = "git diff --cached -M -- " + " ".join(shlex.quote(p) for p in paths)
        return lines, "`{}`".format(cmd)
    return lines, "読まない（501 行以上。変更の種類と行数だけで説明を書く）"


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--ticket", required=True, help="1行目の先頭に付けるチケットID（例: ABC-123）")
    parser.add_argument("--root", default=".", help="リポジトリのルート（既定: 作業ディレクトリ）")
    args = parser.parse_args(argv)

    ticket = args.ticket.strip().upper()
    if not _changes.is_repo(args.root):
        return abort("git のリポジトリでない")
    if not _changes.TICKET_RE.fullmatch(ticket):
        return abort("チケットIDの形が違う")
    try:
        changes = _changes.staged_changes(args.root)
    except _changes.GitError as exc:
        print("git の実行に失敗した: {}".format(exc), file=sys.stderr)
        return 2
    if not changes:
        return abort("ステージした変更が無い")
    if any(c["status"] == "U" for c in changes):
        return abort("未マージのファイルがある")

    print("チケットID: {}".format(ticket))
    print("変更ファイル数: {}".format(len(changes)))
    print()
    print("## 本文の行頭（この順で1ファイル1行。「: 」の後に説明を書く）")
    print()
    for change in changes:
        print("- {}: ".format(change["display"]))
    print()
    print("## 差分の読み方（IN-02）")
    print()
    for change in changes:
        label = _changes.STATUS_LABELS.get(change["status"], "不明")
        lines, how = read_plan(change)
        print("- {}: {}（{}）、{}、{}".format(change["display"], change["status"], label, lines, how))
    return 0


if __name__ == "__main__":
    sys.exit(main())

