#!/usr/bin/env python3
"""コミットメッセージの本文を、ステージした変更と照らして検査する（契約の command 検査から呼ぶ）。

この検査が守らせる決定: OUT-02（ステージしたファイル1つにつき1行の「- <パス>: <説明>」）、
OUT-03（1行目の文末を本文の行で最も多い文末にする）、OUT-04（行の順とパスの表記を collect_changes.py に合わせる）。

出力（標準出力）: 指摘1件につき「<ルールID> <行>行目: <説明>」の1行。指摘が無ければ何も出さない。

終了コード:
  0 指摘なし
  1 指摘あり
  2 使い方の誤り、または git の実行の失敗

使い方:
  python3 <skill>/scripts/check_message.py <メッセージのファイル> [--root <リポジトリのルート>] [--rule OUT-02]
  --rule を付けると、そのルールIDの指摘だけを出す（契約では OUT-02、OUT-03、OUT-04 ごとに1つの検査にする）
"""
import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _changes  # noqa: E402

SEPARATORS = (": ", "：", ":")


def normalize(path):
    path = path.strip().strip("`\"'").strip()
    path = path.replace(" → ", " -> ")
    parts = [p[2:] if p.startswith("./") else p for p in path.split(" -> ")]
    return " -> ".join(parts)


def parse_bullet(line, displays):
    """(表記どおりのパス, 書かれたパス, 説明) を返す。パスが分からなければ表記どおりのパスは None。"""
    rest = line[2:]
    for display in displays:
        if rest.startswith(display + ": "):
            return display, display, rest[len(display) + 2:]
    for sep in SEPARATORS:
        if sep in rest:
            written, desc = rest.split(sep, 1)
            break
    else:
        written, desc = rest, ""
    norm = normalize(written)
    for display in displays:
        if norm == display:
            return display, written, desc.strip()
    return None, written, desc.strip()


def ending(text):
    for verb in _changes.VERBS:
        if text.endswith(verb):
            return verb
    return None


def check(lines, changes):
    findings = []
    displays = [c["display"] for c in changes]
    seen = []
    endings = []
    for index, line in enumerate(lines[2:], start=3):
        if line.strip() == "":
            findings.append(("OUT-02", index, "本文に空行を入れない。本文はステージしたファイル1つにつき1行の「- <パス>: <説明>」だけにする"))
            continue
        if not line.startswith("- "):
            findings.append(("OUT-02", index, "本文の行は「- <パス>: <説明>」の形にする（段落、見出し、トレーラーを書かない）"))
            continue
        display, written, desc = parse_bullet(line, displays)
        if display is None:
            findings.append(("OUT-02", index, "ステージしていないファイルの行がある: {}".format(written)))
            continue
        if display in seen:
            findings.append(("OUT-02", index, "同じファイルの行が2つある: {}".format(display)))
            continue
        if desc == "":
            findings.append(("OUT-02", index, "説明が無い: {}".format(display)))
        if written != display:
            findings.append(("OUT-04", index, "パスは collect_changes.py の行頭のとおり「{}」と書く（書いた表記: {}）".format(display, written)))
        seen.append(display)
        verb = ending(desc)
        if verb:
            endings.append(verb)
    for display in displays:
        if display not in seen:
            findings.append(("OUT-02", len(lines) + 1, "ステージしたファイルの行が無い: {}".format(display)))
    expected = [d for d in displays if d in seen]
    if seen != expected:
        findings.append(("OUT-04", 3, "本文の行の順を collect_changes.py の順にする: {}".format("、".join(expected))))
    if endings and lines:
        counts = {verb: endings.count(verb) for verb in _changes.VERBS}
        top = max(counts.values())
        majority = next(verb for verb in _changes.VERBS if counts[verb] == top)
        first = ending(lines[0])
        if first is not None and first != majority:
            findings.append(("OUT-03", 1, "1行目の文末は、本文の行で最も多い文末「{}」にする（同数なら 追加する、修正する、削除する、変更する の順で先のもの）".format(majority)))
    return findings


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("message", help="コミットメッセージのファイル")
    parser.add_argument("--root", default=".", help="リポジトリのルート（既定: 作業ディレクトリ）")
    parser.add_argument("--rule", action="append", choices=["OUT-02", "OUT-03", "OUT-04"],
                        help="このルールIDの指摘だけを出す（複数可。既定: すべて）")
    args = parser.parse_args(argv)
    rules = set(args.rule or ["OUT-02", "OUT-03", "OUT-04"])

    try:
        with open(args.message, encoding="utf-8") as fh:
            lines = fh.read().split("\n")
    except OSError as exc:
        print("メッセージのファイルを読めない: {}".format(exc), file=sys.stderr)
        return 2
    if lines and lines[-1] == "":
        lines.pop()
    try:
        changes = _changes.staged_changes(args.root)
    except _changes.GitError as exc:
        print("git の実行に失敗した: {}".format(exc), file=sys.stderr)
        return 2
    if not changes:
        if "OUT-02" not in rules:
            return 0
        print("OUT-02 1行目: ステージした変更が無い。IN-01 に従い、書かずに中断する")
        return 1
    findings = [f for f in check(lines, changes) if f[0] in rules]
    for rule, line, text in findings:
        print("{} {}行目: {}".format(rule, line, text))
    return 1 if findings else 0


if __name__ == "__main__":
    sys.exit(main())

