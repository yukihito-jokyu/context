"""collect_changes.py と check_message.py が共有する部品。ステージした変更を git から読む。

単独では実行しない。
"""
import re
import subprocess

TICKET_RE = re.compile(r"[A-Z][A-Z0-9_]*-[0-9]+")
VERBS = ["追加する", "修正する", "削除する", "変更する"]
STATUS_LABELS = {
    "A": "追加",
    "C": "コピー",
    "D": "削除",
    "M": "変更",
    "R": "名前の変更",
    "T": "種類の変更",
    "U": "未マージ",
    "X": "不明",
    "B": "対の切断",
}
FULL_DIFF_MAX = 500


class GitError(Exception):
    pass


def _git(root, args):
    proc = subprocess.run(["git", "-C", root] + args, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if proc.returncode != 0:
        raise GitError(proc.stderr.decode("utf-8", "replace").strip())
    return proc.stdout


def _split(raw):
    tokens = raw.decode("utf-8", "replace").split("\0")
    if tokens and tokens[-1] == "":
        tokens.pop()
    return tokens


def is_repo(root):
    try:
        return _git(root, ["rev-parse", "--is-inside-work-tree"]).strip() == b"true"
    except (GitError, OSError):
        return False


def staged_changes(root):
    """ステージした変更を git の出力の順で返す。各要素は status、path、old、display、added、deleted。"""
    tokens = _split(_git(root, ["diff", "--cached", "-M", "--name-status", "-z"]))
    changes = []
    i = 0
    while i < len(tokens):
        status = tokens[i][:1]
        if status in ("R", "C"):
            old, path = tokens[i + 1], tokens[i + 2]
            i += 3
            display = "{} -> {}".format(old, path)
        else:
            old, path = None, tokens[i + 1]
            i += 2
            display = path
        changes.append({"status": status, "path": path, "old": old, "display": display,
                        "added": None, "deleted": None})
    stats = {}
    tokens = _split(_git(root, ["diff", "--cached", "-M", "--numstat", "-z"]))
    i = 0
    while i < len(tokens):
        parts = tokens[i].split("\t")
        if len(parts) >= 3 and parts[2] == "":
            key = tokens[i + 2]
            i += 3
        else:
            key = parts[2] if len(parts) >= 3 else ""
            i += 1
        stats[key] = (parts[0], parts[1] if len(parts) > 1 else "-")
    for change in changes:
        added, deleted = stats.get(change["path"], ("-", "-"))
        change["added"] = None if added == "-" else int(added)
        change["deleted"] = None if deleted == "-" else int(deleted)
    return changes

