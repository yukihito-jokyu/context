#!/bin/sh
# probe.py の baseline.setup から、一時プロジェクトの中で1回だけ実行する。
# dev/fixtures/basic を写したディレクトリを git のリポジトリにして全部をコミットし、
# 変更（M）、追加（A）、削除（D）、名前の変更（R）を1つずつステージする。
set -eu
[ -f src/legacy.py ] && [ -f docs/usage.md ] || { echo "dev/fixtures/basic を写したディレクトリで実行する" >&2; exit 1; }
git init -q
[ "$(git rev-parse --show-toplevel)" = "$(pwd -P)" ] || { echo "一時プロジェクトのルートで実行する" >&2; exit 1; }
git add -A
git -c user.name=probe -c user.email=probe@example.com commit -q --allow-empty -m base
printf 'def subtract(a, b):\n    return a - b\n' >> src/calc.py
mkdir -p tests
printf 'from src.calc import subtract\n\n\ndef test_subtract():\n    assert subtract(3, 1) == 2\n' > tests/test_calc.py
git rm -q src/legacy.py
git mv docs/usage.md docs/guide.md
git add src/calc.py tests/test_calc.py

