# ---------------------------------------------------------------- 実行

def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--source", help="調べるファイルかディレクトリ（プロジェクトのルートからの相対パス）")
    parser.add_argument("--markers", help="拾う目印（カンマ区切り。大文字にそろえる）")
    parser.add_argument("--output", help="出力のパス（プロジェクトのルートからの相対パス）")
    parser.add_argument("--verify", metavar="FILE", help="FILE を、作り直した結果と比べる")
    parser.add_argument("--rule", help="--verify で出す違いのルールID（カンマ区切り）。無ければすべて")
    args = parser.parse_args(argv)
    root = rt.project_root(Path.cwd())
    try:
        inputs = resolve_inputs(root, args)
    except InputError as exc:
        print(f"ERROR {exc}", file=sys.stderr)
        return 2
    found = collect(root, inputs)
    expected = render(root, inputs, found)
    if args.verify:
        path = inputs["output_path"]
        if not path.is_file():
