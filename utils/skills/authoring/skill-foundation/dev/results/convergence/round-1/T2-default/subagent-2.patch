=== .claude/skills/write-changelog-entry/dev/fixtures/change/calc.py
"""calc コマンド。"""

import sys


def add(a, b):
    return a + b


def sub(a, b):
    return a - b


def mul(a, b):
    return a * b


def div(a, b):
    if b == 0:
        raise ZeroDivisionError("0 では割れない")
    return a / b


def main(argv):
    op, a, b = argv[1], float(argv[2]), float(argv[3])
    try:
        if op == "add":
            print(add(a, b))
        elif op == "sub":
            print(sub(a, b))
        elif op == "mul":
            print(mul(a, b))
        elif op == "div":
            print(div(a, b))
    except ZeroDivisionError as exc:
        print(f"エラー: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

