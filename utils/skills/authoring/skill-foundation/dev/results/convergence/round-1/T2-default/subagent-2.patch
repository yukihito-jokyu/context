#!/usr/bin/env python3
"""出力の節を検査する（OUT-02、OUT-03、OUT-04、OUT-06、OUT-08、STEP-03）。契約の command 検査から --rule を付けて呼ぶ。

  OUT-02   行の形と空行の並び（`## [Unreleased]`、空行、`### <種類>`、空行、`- <項目>`）
  OUT-03   項目の言語と文末（collect_changes.py が決めた「項目の言語」）
  OUT-04   種類の見出しの名前、順、重なり、項目の無い見出し
  OUT-06   既存の Unreleased の項目と同じ文の項目、節の中で同じ文の項目
  OUT-08   ステージしたファイルのパスとファイル名
  STEP-03  ステージ済みのファイルの一覧が collect_changes.py の時点から変わっていないか

出力: 違反ごとに「<ルールID> <行番号>行目: <説明>」。違反が無ければ何も出さない
終了コード: 0 違反なし、1 違反あり、2 使い方の誤り

使い方:
  python3 <skill>/scripts/check_entry.py <節のファイル> [--root <プロジェクトのルート>] [--rule <ルールID>]
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _changelog as cl  # noqa: E402

RULES = ["OUT-02", "OUT-03", "OUT-04", "OUT-06", "OUT-08", "STEP-03"]


def check_structure(lines: list[str]) -> list[tuple[int, str]]:
    found = []
    shaped = []  # (行番号, 行) 字下げした行は OUT-05 が見るので除く
    for no, line in enumerate(lines, 1):
        if line[:1] in (" ", "\t"):
            continue
        shaped.append((no, line))
        if not line.strip() or line == "## [Unreleased]" or cl.H3_RE.match(line) or re.match(r"^- \S", line):
            continue
        found.append((no, f"この形の行は書かない（使える行: `## [Unreleased]`、`### <種類>`、`- <項目>`、空行）: {line[:40]}"))
    if found:
        return found
    sections = cl.parse_entry("\n".join(line for _no, line in shaped))
    expected = cl.render_section(sections)
    actual = [line for _no, line in shaped]
    while actual and not actual[-1].strip():
        actual.pop()
    for i, (want, have) in enumerate(zip(expected, actual)):
        if want != have:
            no = shaped[i][0]
            return [(no, f"空行と見出しの並びが形と違う（期待: `{want or '空行'}`、実際: `{have or '空行'}`）")]
    if len(actual) > len(expected):
        extra = [no for no, line in shaped[len(expected):len(actual)] if line.strip()]
        no = extra[0] if extra else shaped[len(expected)][0]
        return [(no, "この行が形に合わない（項目の前には `### <種類>` の見出しと空行が要る）")]
    if len(actual) < len(expected):
        no = shaped[len(actual) - 1][0] if actual else 1
        return [(no, f"空行と見出しの並びが形と違う（この行の後に `{expected[len(actual)] or '空行'}` が要る）")]
    return []


def check_language(lines: list[str], record: dict | None) -> list[tuple[int, str]]:
    if record is None:
        return [(1, "collect_changes.py の記録が無いため、項目の言語が決まらない。collect_changes.py を実行する")]
    lang = record.get("language")
    found = []
    for no, line in enumerate(lines, 1):
        if not line.startswith("- "):
            continue
        text = line[2:].strip()
        if lang == "ja":
            if not cl.has_japanese(text):
                found.append((no, "項目の言語は ja なので、日本語で書く"))
            elif not text.endswith("。"):
                found.append((no, "ja の項目は「。」で終える"))
        else:
            if cl.has_japanese(text):
                found.append((no, "項目の言語は en なので、日本語の文字を使わない"))
            elif not text.endswith("."):
                found.append((no, "en の項目は「.」で終える"))
            elif not re.match(r"^[A-Z0-9`]", text):
                found.append((no, "en の項目は英大文字、数字、` のどれかで始める"))
    return found


def check_headings(lines: list[str]) -> list[tuple[int, str]]:
    heads: list[list] = []  # [行番号, 種類の名前, 項目の数]
    for no, line in enumerate(lines, 1):
        match = cl.H3_RE.match(line)
        if match:
            heads.append([no, match.group(1), 0])
        elif line.startswith("- ") and heads:
            heads[-1][2] += 1
    found = []
    last = -1
    seen = set()
    for no, name, items in heads:
        if items == 0:
            found.append((no, f"項目の無い種類の見出しは書かない: {name}"))
        if name not in cl.TYPES:
            found.append((no, f"種類の見出しは {', '.join(cl.TYPES)} のどれかにする: {name}"))
            continue
        if name in seen:
            found.append((no, f"同じ見出しを2回書かない: {name}"))
        idx = cl.TYPES.index(name)
        if idx < last:
            found.append((no, f"見出しは {' → '.join(cl.TYPES)} の順に並べる: {name}"))
        seen.add(name)
        last = max(last, idx)
    return found


def check_duplicates(lines: list[str], record: dict | None) -> list[tuple[int, str]]:
    existing = set(record.get("existing_items", [])) if record else set()
    found = []
    seen = set()
    for no, line in enumerate(lines, 1):
        if not line.startswith("- "):
            continue
        item = cl.normalize_item(line)
        if item in existing:
            found.append((no, "既存の Unreleased にある項目と同じ文の項目は書かない"))
        elif item in seen:
            found.append((no, "節の中で同じ文の項目を2回書かない"))
        seen.add(item)
    return found


def check_paths(lines: list[str], record: dict | None) -> list[tuple[int, str]]:
    if record is None:
        return [(1, "collect_changes.py の記録が無いため、ステージしたファイルが分からない。collect_changes.py を実行する")]
    names = set()
    for path in cl.staged_paths(record.get("staged", [])):
        names.add(path)
        names.add(Path(path).name)
    found = []
    for no, line in enumerate(lines, 1):
        if not line.startswith("- "):
            continue
        for name in sorted(names, key=len, reverse=True):
            if re.search(r"(?<![\w./-])" + re.escape(name) + r"(?![\w/-])", line):
                found.append((no, f"ステージしたファイルのパスとファイル名を書かない: {name}"))
                break
    return found


def check_staged(root: Path, record: dict | None) -> list[tuple[int, str]]:
    if record is None:
        return [(1, "collect_changes.py の記録が無い。collect_changes.py を実行する")]
    before = {cl.format_entry(e) for e in record.get("staged_all", [])}
    now = {cl.format_entry(e) for e in cl.staged_entries(root)}
    if before == now:
        return []
    added = ", ".join(sorted(now - before)) or "なし"
    removed = ", ".join(sorted(before - now)) or "なし"
    return [(1, f"ステージ済みのファイルが collect_changes.py の時点と違う（増えた: {added}、減った: {removed}）。"
                "git add、git restore、git reset、git commit、git stash を実行しない")]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("file", help="節のファイル")
    parser.add_argument("--root", help="プロジェクトのルート（既定: git のルート）")
    parser.add_argument("--rule", choices=RULES, help="この1つのルールだけを検査する")
    args = parser.parse_args()

    root = cl.git_root(args.root)
    if root is None:
        print("git のリポジトリでない", file=sys.stderr)
        return 2
    path = Path(args.file)
    if not path.is_absolute():
        path = root / path
    text = cl.read_text(path)
    if text is None:
        print(f"節のファイルが無い: {args.file}", file=sys.stderr)
        return 2
    lines = text.splitlines()
    state = cl.load_state(root)
    record = cl.load_collect(root, state) if state else None

    checks = {
        "OUT-02": lambda: check_structure(lines),
        "OUT-03": lambda: check_language(lines, record),
        "OUT-04": lambda: check_headings(lines),
        "OUT-06": lambda: check_duplicates(lines, record),
        "OUT-08": lambda: check_paths(lines, record),
        "STEP-03": lambda: check_staged(root, record),
    }
    count = 0
    for rule in ([args.rule] if args.rule else RULES):
        for no, message in checks[rule]():
            print(f"{rule} {no}行目: {message}")
            count += 1
    return 1 if count else 0


if __name__ == "__main__":
    sys.exit(main())

