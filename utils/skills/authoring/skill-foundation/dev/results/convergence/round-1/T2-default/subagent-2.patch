    return 0


def print_findings(findings: list[dict]) -> None:
    for f in findings:
        rt.emit(f["message"] if f.get("raw") else rt.format_finding(f))


def cmd_check(args, contract: dict, name: str) -> int:
    root = resolve_root(args.root)
