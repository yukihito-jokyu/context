#!/usr/bin/env python3
"""出力の節を CHANGELOG.md に差し込む（OUT-06、OUT-07、IN-01）。

差し込みは毎回、collect_changes.py が控えた CHANGELOG.md（.skill-runs/write-changelog-entry/base/）から
作り直す。そのため、節を書き直して何度実行しても、項目は重ならない。差し込み方は OUT-06 の表のとおり。
節（.skill-runs/write-changelog-entry/out/changelog-entry.md）が無いときは、CHANGELOG.md を控えの内容に戻す。

出力:
  差し込んだ: CHANGELOG.md（<差し込み方>）
  --check のとき: 一致すれば何も出さない。違えば「OUT-07 CHANGELOG.md: <説明>」

終了コード: 0 成功（--check では一致）、1 --check で不一致、2 使い方の誤り・collect_changes.py の前、
            4 CHANGELOG.md に ## [Unreleased] が2つ以上あり、差し込む位置が決まらない（IN-01）

使い方:
  python3 <skill>/scripts/apply_entry.py [--root <プロジェクトのルート>]
  python3 <skill>/scripts/apply_entry.py --check [--root <プロジェクトのルート>]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _changelog as cl  # noqa: E402


def how(base_exists: bool, base: str | None) -> str:
    if not base_exists:
        return "CHANGELOG.md が無かったので、Keep a Changelog の冒頭を付けて作った"
    if cl.count_unreleased(base or "") == 1:
        return "既存の ## [Unreleased] に足した"
    return "## [Unreleased] が無かったので、最初の版の見出しの前に置いた"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", help="プロジェクトのルート（既定: git のルート）")
    parser.add_argument("--check", action="store_true", help="CHANGELOG.md が節と控えから作った内容と同じかだけを確かめる")
    args = parser.parse_args()

    root = cl.git_root(args.root)
    if root is None:
        print("git のリポジトリでない", file=sys.stderr)
        return 2
    state = cl.load_state(root)
    base = cl.load_base(root, state) if state else None
    if base is None:
        if args.check:
            print("OUT-07 CHANGELOG.md: collect_changes.py の控えが無い。collect_changes.py を実行してから apply_entry.py を実行する")
            return 1
        print("collect_changes.py の控えが無い。先に collect_changes.py を実行する", file=sys.stderr)
        return 2
    base_exists, base_text = base
    target = root / cl.CHANGELOG
    entry_text = cl.read_text(root / cl.ENTRY)
    if entry_text is None:
        original = base_text if base_exists else None
        if args.check:
            if cl.read_text(target) != original:
                print(f"OUT-07 CHANGELOG.md: 節（{cl.ENTRY}）が無いのに CHANGELOG.md が変わっている")
                return 1
            return 0
        if original is None:
            if target.exists():
                target.unlink()
        else:
            target.write_text(original, encoding="utf-8")
        print("節が無いので、CHANGELOG.md を collect_changes.py の時点に戻した")
        return 0
    try:
        merged = cl.merge(base_text if base_exists else None, entry_text)
    except cl.MergeError as exc:
        print(f"{exc}（IN-01: run.py abort --reason CHANGELOG.md の Unreleased が1つに決まらない）")
        return 4
    if args.check:
        current = cl.read_text(target)
        if current != merged:
            print("OUT-07 CHANGELOG.md: 節から apply_entry.py で作った内容と違う。"
                  "節を直してから apply_entry.py を実行し直す（CHANGELOG.md を手で直さない）")
            return 1
        return 0
    target.write_text(merged, encoding="utf-8")
    print(f"差し込んだ: CHANGELOG.md（{how(base_exists, base_text)}）")
    return 0


if __name__ == "__main__":
    sys.exit(main())

