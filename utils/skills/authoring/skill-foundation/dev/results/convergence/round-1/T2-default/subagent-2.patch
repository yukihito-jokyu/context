"""collect_changes.py、apply_entry.py、check_entry.py が共有する部品（git の読み取り、実行記録、節の解析と差し込み）。"""

from __future__ import annotations

import json
import re
import subprocess
from pathlib import Path

NAME = "write-changelog-entry"
RUN_DIR = f".skill-runs/{NAME}"
ENTRY = f"{RUN_DIR}/out/changelog-entry.md"
CHANGELOG = "CHANGELOG.md"
TYPES = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
HEADER = [
    "# Changelog",
    "",
    "All notable changes to this project will be documented in this file.",
    "",
    "The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.1.0/).",
]

UNRELEASED_RE = re.compile(r"^##\s+\[?unreleased\]?\s*$", re.I)
H2_RE = re.compile(r"^##\s")
H3_RE = re.compile(r"^###\s+(.+?)\s*$")
LINKREF_RE = re.compile(r"^\[[^\]]+\]:\s*\S")
BULLET_RE = re.compile(r"^\s*[-*+]\s+\S")
JA_RE = re.compile(r"[぀-ヿ㐀-鿿ｦ-ﾟ]")


class MergeError(Exception):
    """CHANGELOG.md に差し込む位置が決まらない（## [Unreleased] が2つ以上）。"""


def run_git(root: Path, *args: str) -> str:
    result = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"git {' '.join(args)} が失敗した")
    return result.stdout


def git_root(arg: str | None) -> Path | None:
    start = Path(arg).resolve() if arg else Path.cwd()
    try:
        top = run_git(start, "rev-parse", "--show-toplevel").strip()
    except (RuntimeError, FileNotFoundError, NotADirectoryError):
        return None
    return Path(arg).resolve() if arg else Path(top)


def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None


def load_json(path: Path) -> dict | None:
    text = read_text(path)
    if text is None:
        return None
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None
    return data if isinstance(data, dict) else None


def load_state(root: Path) -> dict | None:
    return load_json(root / RUN_DIR / "state.json")


def load_collect(root: Path, state: dict) -> dict | None:
    data = load_json(root / RUN_DIR / "collect.json")
    if data is None or data.get("started_at") != state.get("started_at"):
        return None
    return data


def save_collect(root: Path, record: dict) -> None:
    path = root / RUN_DIR / "collect.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(record, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def save_base(root: Path, state: dict, text: str | None) -> None:
    base = root / RUN_DIR / "base"
    base.mkdir(parents=True, exist_ok=True)
    copy = base / CHANGELOG
    if text is None:
        if copy.exists():
            copy.unlink()
    else:
        copy.write_text(text, encoding="utf-8")
    meta = {"started_at": state.get("started_at"), "exists": text is not None}
    (base / "meta.json").write_text(json.dumps(meta, ensure_ascii=False) + "\n", encoding="utf-8")


def load_base(root: Path, state: dict) -> tuple[bool, str | None] | None:
    """控えが今の実行のものなら (あったか, 中身) を返す。無いか古ければ None。"""
    base = root / RUN_DIR / "base"
    meta = load_json(base / "meta.json")
    if meta is None or meta.get("started_at") != state.get("started_at"):
        return None
    if not meta.get("exists"):
        return False, None
    return True, read_text(base / CHANGELOG) or ""


def staged_entries(root: Path) -> list[list[str]]:
    """git diff --cached --name-status -M -z を [状態, パス] か [状態, 元のパス, 新しいパス] にする。"""
    out = run_git(root, "diff", "--cached", "--name-status", "-M", "-z")
    parts = [p for p in out.split("\0")]
    entries: list[list[str]] = []
    i = 0
    while i < len(parts) and parts[i]:
        status = parts[i][0]
        if status in ("R", "C"):
            entries.append([status, parts[i + 1], parts[i + 2]])
            i += 3
        else:
            entries.append([status, parts[i + 1]])
            i += 2
    return entries


def is_changelog_entry(entry: list[str]) -> bool:
    return any(path == CHANGELOG for path in entry[1:])


def format_entry(entry: list[str]) -> str:
    if len(entry) == 3:
        return f"{entry[0]}\t{entry[1]} -> {entry[2]}"
    return f"{entry[0]}\t{entry[1]}"


def staged_paths(entries: list[list[str]]) -> list[str]:
    return [path for entry in entries for path in entry[1:]]


def staged_diff(root: Path) -> str:
    return run_git(root, "diff", "--cached", "--no-color", "--no-ext-diff", "-M", "--", ".",
                   f":(exclude){CHANGELOG}")


def staged_numstat(root: Path) -> list[tuple[str, str, str]]:
    out = run_git(root, "diff", "--cached", "--numstat", "-M", "--", ".", f":(exclude){CHANGELOG}")
    rows = []
    for line in out.splitlines():
        cols = line.split("\t")
        if len(cols) >= 3:
            rows.append((cols[0], cols[1], cols[-1]))
    return rows


def has_japanese(text: str) -> bool:
    return JA_RE.search(text) is not None


def bullet_lines(text: str) -> list[str]:
    return [line for line in text.splitlines() if BULLET_RE.match(line)]


def count_unreleased(text: str) -> int:
    return sum(1 for line in text.splitlines() if UNRELEASED_RE.match(line))


def block_end(lines: list[str], start: int) -> int:
    for i in range(start + 1, len(lines)):
        if H2_RE.match(lines[i]) or LINKREF_RE.match(lines[i]):
            return i
    return len(lines)


def normalize_item(line: str) -> str:
    text = re.sub(r"^\s*[-*+]\s+", "", line).strip()
    return "- " + re.sub(r"\s+", " ", text)


def unreleased_items(text: str) -> list[str]:
    lines = text.splitlines()
    items: list[str] = []
    for i, line in enumerate(lines):
        if UNRELEASED_RE.match(line):
            for inner in lines[i + 1:block_end(lines, i)]:
                if BULLET_RE.match(inner):
                    items.append(normalize_item(inner))
    return items


def parse_entry(text: str) -> list[tuple[str, list[str]]]:
    """節を [(種類, [項目の行])] にする。行頭が `### ` と `- ` の行だけを読む。"""
    sections: list[tuple[str, list[str]]] = []
    for line in text.splitlines():
        line = line.rstrip()
        match = H3_RE.match(line)
        if match:
            sections.append((match.group(1), []))
        elif line.startswith("- ") and sections:
            sections[-1][1].append(line)
    return sections


def render_section(sections: list[tuple[str, list[str]]]) -> list[str]:
    out = ["## [Unreleased]"]
    for name, items in sections:
        out += ["", f"### {name}"] + ([""] + items if items else [])
    return out


def _strip_blank(lines: list[str]) -> list[str]:
    start, end = 0, len(lines)
    while start < end and not lines[start].strip():
        start += 1
    while end > start and not lines[end - 1].strip():
        end -= 1
    return lines[start:end]


def _type_index(name: str) -> int | None:
    for i, t in enumerate(TYPES):
        if t.lower() == name.strip().lower():
            return i
    return None


def _merge_into_unreleased(lines: list[str], u: int, sections: list[tuple[str, list[str]]]) -> list[str]:
    end = block_end(lines, u)
    block = lines[u + 1:end]
    preamble: list[str] = []
    subs: list[list] = []  # [見出しの行, 種類の名前, 中身の行]
    for line in block:
        match = H3_RE.match(line)
        if match:
            subs.append([line, match.group(1), []])
        elif subs:
            subs[-1][2].append(line)
        else:
            preamble.append(line)
    for name, items in sections:
        found = next((s for s in subs if s[1].strip().lower() == name.strip().lower()), None)
        if found is not None:
            found[2] = _strip_blank(found[2]) + items
            continue
        new = [f"### {name}", name, list(items)]
        idx = _type_index(name)
        pos = len(subs)
        if idx is not None:
            for j, sub in enumerate(subs):
                other = _type_index(sub[1])
                if other is not None and other > idx:
                    pos = j
                    break
        subs.insert(pos, new)
    out = [lines[u]]
    pre = _strip_blank(preamble)
    if pre:
        out += [""] + pre
    for heading, _name, content in subs:
        out += ["", heading]
        body = _strip_blank(content)
        if body:
            out += [""] + body
    rest = lines[end:]
    if rest:
        out += [""] + rest
    return lines[:u] + out


def _insert_before(lines: list[str], at: int, section: list[str]) -> list[str]:
    head = lines[:at]
    if head and head[-1].strip():
        head = head + [""]
    return head + section + [""] + lines[at:]


def merge(base: str | None, entry_text: str) -> str:
    """控えの CHANGELOG.md（無ければ None）に節を差し込んだ内容を返す（OUT-06 の表）。"""
    sections = parse_entry(entry_text)
    section = render_section(sections)
    if base is None:
        return "\n".join(HEADER + [""] + section) + "\n"
    lines = base.splitlines()
    unreleased = [i for i, line in enumerate(lines) if UNRELEASED_RE.match(line)]
    if len(unreleased) >= 2:
        raise MergeError("CHANGELOG.md に ## [Unreleased] が2つ以上ある")
    if unreleased:
        result = _merge_into_unreleased(lines, unreleased[0], sections)
    else:
        first_h2 = next((i for i, line in enumerate(lines) if H2_RE.match(line)), None)
        if first_h2 is not None:
            result = _insert_before(lines, first_h2, section)
        else:
            refs = None
            for i in range(len(lines)):
                rest = [line for line in lines[i:] if line.strip()]
                if LINKREF_RE.match(lines[i]) and all(LINKREF_RE.match(line) for line in rest):
                    refs = i
                    break
            if refs is not None:
                result = _insert_before(lines, refs, section)
            else:
                body = _strip_blank(lines)
                result = (body + [""] if body else []) + section
    return "\n".join(result) + "\n"

