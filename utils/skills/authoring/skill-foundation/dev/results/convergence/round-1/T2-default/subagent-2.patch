"""serve: print the file under ROOT that a request path points to."""

import os
import sys


def resolve(root, path):
    return os.path.join(root, path.lstrip("/"))


def main(argv):
    args = argv[1:]
    if "--legacy-port" in args:
        args.remove("--legacy-port")
        print("warning: --legacy-port is deprecated", file=sys.stderr)
    root, path = args[0], args[1]
    with open(resolve(root, path), encoding="utf-8") as f:
        print(f.read(), end="")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

