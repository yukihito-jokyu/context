#!/usr/bin/env python3
"""ステージ済みの差分から、CHANGELOG.md に足す節の材料を集める（STEP-01、IN-01、OUT-03、OUT-06）。

出力（標準出力）:
  ステージ済みのファイル: <件数>（CHANGELOG.md を除く）
  <状態>\t<パス>                     git diff --cached --name-status -M の順
  CHANGELOG.md: あり|無い（## [Unreleased]: あり|無い|2つ以上）
  既存の Unreleased の項目: <件数>
  - <項目>
  項目の言語: ja|en（<決めた理由>）
  出力: .skill-runs/write-changelog-entry/out/changelog-entry.md
  --- 差分（git diff --cached、CHANGELOG.md を除く） ---
  <差分。3000 行を超えるときは、ファイルごとの追加と削除の行数だけ>

記録（1回の実行で最初の1回だけ書く。2回目からは記録の値を出す）:
  .skill-runs/write-changelog-entry/collect.json   ステージ済みの一覧、項目の言語、既存の項目
  .skill-runs/write-changelog-entry/base/          この時点の CHANGELOG.md の控え（apply_entry.py が使う）

終了コード: 0 成功、2 使い方の誤り・run.py start の前、4 ステージ済みの変更が無い（CHANGELOG.md を除く）、
            5 git のリポジトリでない

使い方:
  python3 <skill>/scripts/collect_changes.py [--root <プロジェクトのルート>]
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _changelog as cl  # noqa: E402

MAX_DIFF_LINES = 3000


def decide_language(state: dict, base_text: str | None) -> tuple[str, str]:
    """OUT-03 の表を上から当てはめる。"""
    value = str((state.get("input") or {}).get("language") or "auto").lower()
    if value in ("ja", "en"):
        return value, f"入力 language が {value}"
    bullets = cl.bullet_lines(base_text or "")
    if bullets:
        ja = sum(1 for line in bullets if cl.has_japanese(line))
        if ja * 2 >= len(bullets):
            return "ja", f"CHANGELOG.md の箇条書き {len(bullets)} 行のうち日本語 {ja} 行"
        return "en", f"CHANGELOG.md の箇条書き {len(bullets)} 行のうち日本語 {ja} 行"
    if cl.has_japanese(str(state.get("text") or "")):
        return "ja", "CHANGELOG.md に箇条書きが無く、依頼文が日本語"
    return "en", "CHANGELOG.md に箇条書きが無く、依頼文に日本語が無い"


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", help="プロジェクトのルート（既定: git のルート）")
    args = parser.parse_args()

    root = cl.git_root(args.root)
    if root is None:
        print("git のリポジトリでない（IN-01: run.py abort --reason git のリポジトリでない）")
        return 5
    state = cl.load_state(root)
    if state is None:
        print(f"実行記録が無い。先に run.py start を実行する（{cl.RUN_DIR}/state.json）", file=sys.stderr)
        return 2

    record = cl.load_collect(root, state)
    if record is None:
        staged_all = cl.staged_entries(root)
        staged = [e for e in staged_all if not cl.is_changelog_entry(e)]
        if not staged:
            print("ステージ済みのファイル: 0（CHANGELOG.md を除く）")
            print("IN-01: run.py abort --reason ステージ済みの変更が無い")
            return 4
        base_text = cl.read_text(root / cl.CHANGELOG)
        language, why = decide_language(state, base_text)
        record = {
            "started_at": state.get("started_at"),
            "staged_all": staged_all,
            "staged": staged,
            "language": language,
            "language_reason": why,
            "changelog_exists": base_text is not None,
            "unreleased_count": cl.count_unreleased(base_text or ""),
            "existing_items": cl.unreleased_items(base_text or ""),
        }
        cl.save_base(root, state, base_text)
        cl.save_collect(root, record)

    print(f"ステージ済みのファイル: {len(record['staged'])}（CHANGELOG.md を除く）")
    for entry in record["staged"]:
        print(cl.format_entry(entry))
    if record["changelog_exists"]:
        count = record["unreleased_count"]
        mark = "無い" if count == 0 else ("あり" if count == 1 else "2つ以上")
        print(f"CHANGELOG.md: あり（## [Unreleased]: {mark}）")
    else:
        print("CHANGELOG.md: 無い（apply_entry.py が Keep a Changelog の冒頭を付けて作る）")
    print(f"既存の Unreleased の項目: {len(record['existing_items'])}")
    for item in record["existing_items"]:
        print(item)
    print(f"項目の言語: {record['language']}（{record['language_reason']}）")
    print(f"出力: {cl.ENTRY}")

    diff = cl.staged_diff(root)
    lines = diff.splitlines()
    print("--- 差分（git diff --cached、CHANGELOG.md を除く） ---")
    if len(lines) > MAX_DIFF_LINES:
        print(f"差分が {MAX_DIFF_LINES} 行を超えるため省いた（{len(lines)} 行）。"
              "ファイルごとに `git diff --cached -- <パス>` で読む（IN-02）")
        for added, deleted, path in cl.staged_numstat(root):
            print(f"+{added}\t-{deleted}\t{path}")
    else:
        print(diff, end="" if diff.endswith("\n") else "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())

