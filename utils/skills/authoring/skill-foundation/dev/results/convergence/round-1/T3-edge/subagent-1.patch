            continue
        real = path.resolve()
        if real == output_real or real == skill_real or skill_real in real.parents:
            continue
        markers = style_for(rel)
        if markers is None:
            continue
        scanned.append(rel)
        try:
            text = path.read_bytes().decode("utf-8-sig")
        except UnicodeDecodeError:
            unreadable.append(rel)
            continue
        for number, line in enumerate(text.split("\n"), 1):
            found = extract(line.rstrip("\r"), markers)
            if found is not None:
                rows.append((rel, number, found[0], found[1]))
    rows.sort(key=lambda r: (r[0], r[1]))
    return {"source": source_rel, "scanned": scanned, "unreadable": unreadable, "rows": rows}


def escape(value: str) -> str:
    return value.replace("|", "\\|")


def row_line(row) -> str:
    path, number, ident, text = row
    return f"| `{escape(path)}` | {number} | {escape(ident) or '-'} | {escape(text) or '-'} |"


def render(result: dict) -> str:
    lines = [TITLE, "",
             f"- 対象: `{result['source']}`",
             f"- 調べたファイル: {len(result['scanned'])} 件",
             f"- 読めなかったファイル: {len(result['unreadable'])} 件",
             f"- TODO コメント: {len(result['rows'])} 件", ""]
    if result["rows"]:
        lines += [TABLE_HEADER, TABLE_DELIMITER] + [row_line(r) for r in result["rows"]]
    else:
        lines.append(EMPTY_SENTENCE)
    if result["unreadable"]:
        lines += ["", UNREADABLE_HEADING, "", UNREADABLE_SENTENCE, ""] + [f"- `{p}`" for p in result["unreadable"]]
    return "\n".join(lines) + "\n"


# ---------------------------------------------------------------- 検査（--check）

def split_cells(line: str) -> list[str]:
    body = line.strip()
    body = body[1:] if body.startswith("|") else body
    body = body[:-1] if body.endswith("|") and not body.endswith("\\|") else body
    return re.split(r"(?<!\\)\|", body)


def parse_row(line: str):
    cells = split_cells(line)
    if len(cells) < 4:
        return None
    cells = cells[:3] + ["|".join(cells[3:])]
    path, number, ident, text = (c.strip() for c in cells)
    path = path[1:-1] if len(path) >= 2 and path.startswith("`") and path.endswith("`") else path
    unescape = lambda v: "" if v == "-" else v.replace("\\|", "|")
    return unescape(path), int(number) if number.isdigit() else None, unescape(ident), unescape(text)


def row_shape_ok(line: str) -> bool:
    cells = split_cells(line)
    if len(cells) != 4 or line != "| " + " | ".join(c.strip() for c in cells) + " |":
        return False
    path, number, ident, text = (c.strip() for c in cells)
    return bool(re.fullmatch(r"`[^`]+`", path) and re.fullmatch(r"[1-9][0-9]*", number) and ident and text)


def mask(line: str) -> str:
    match = BULLET.match(line)
    return f"- {match.group(1)}: …" if match else line


def sections(lines: list[str]):
    """（本文の骨組みの行, 表の行（行番号, 行）, 読めなかったファイルの節の行）に分ける。"""
    cut = lines.index(UNREADABLE_HEADING) if UNREADABLE_HEADING in lines else len(lines)
    main, tail = lines[:cut], lines[cut:]
    table = [i for i, line in enumerate(main) if line.startswith("|")]
    row_index = set(table[2:]) if len(table) >= 2 and re.fullmatch(r"\|[\s:|-]+\|", main[table[1]]) else set(table[1:])
    skeleton = [mask(line) for i, line in enumerate(main) if i not in row_index]
    while skeleton and not skeleton[-1].strip():
        skeleton.pop()
    while tail and not tail[-1].strip():
        tail.pop()
    return skeleton, [(i + 1, main[i]) for i in sorted(row_index)], tail


def check(text: str, expected_text: str, result: dict, output_rel: str) -> list[str]:
    findings = []
    actual_lines, expected_lines = text.split("\n"), expected_text.split("\n")
    a_skel, a_rows, a_tail = sections(actual_lines)
    e_skel, _, e_tail = sections(expected_lines)
    for n, (a, e) in enumerate(zip(a_skel + [""] * len(e_skel), e_skel + [""] * len(a_skel)), 1):
        if a != e:
            findings.append(f"OUT-02 {output_rel}: 骨組みの {n} 行目が「{a}」です。見本と同じ「{e}」にしてください")
            break
    actual_bullets = {m.group(1): m.group(2) for m in map(BULLET.match, actual_lines) if m}
    expected_bullets = {m.group(1): m.group(2) for m in map(BULLET.match, expected_lines) if m}
    for label, value in expected_bullets.items():
        if label in actual_bullets and actual_bullets[label] != value:
            findings.append(f"STEP-02 {output_rel}: 「{label}」が {actual_bullets[label]} です。"
                            f"collect_todo.py の値 {value} にしてください")
    for n, line in a_rows:
        if not row_shape_ok(line):
            findings.append(f"OUT-03 {output_rel}:{n}: 表の行の書き方が違います。"
                            "「| `パス` | 行番号 | 識別子か - | 内容か - |」の形にし、内容の | は \\| にしてください")
    expected_rows = {(r[0], r[1]): (r[2], r[3]) for r in result["rows"]}
    scanned = set(result["scanned"])
    seen, actual_keys = set(), []
    for n, line in a_rows:
        row = parse_row(line)
        if row is None or row[1] is None:
            continue
        key = (row[0], row[1])
        if key in seen:
            findings.append(f"STEP-02 {output_rel}:{n}: `{key[0]}`:{key[1]} が2回あります")
            continue
        seen.add(key)
        actual_keys.append(key)
        if key not in expected_rows:
            if key[0] not in scanned:
                findings.append(f"IN-02 {output_rel}:{n}: `{key[0]}` は読む範囲の外のファイルです。一覧から外してください")
            else:
                findings.append(f"STEP-01 {output_rel}:{n}: `{key[0]}`:{key[1]} は TODO コメントに当たりません。"
                                "一覧から外してください")
        elif expected_rows[key] != (row[2], row[3]):
            findings.append(f"STEP-02 {output_rel}:{n}: `{key[0]}`:{key[1]} の識別子か内容が collect_todo.py の出力と違います")
    for key in expected_rows:
        if key not in seen:
            findings.append(f"STEP-02 {output_rel}: `{key[0]}`:{key[1]} の TODO コメントが一覧にありません")
    common_actual = [k for k in actual_keys if k in expected_rows]
    common_expected = [k for k in expected_rows if k in seen]
    if common_actual != common_expected:
        findings.append(f"OUT-03 {output_rel}: 並べ順が違います。ファイルのパスの文字コード順、同じファイルは行番号の順にしてください")
    if a_tail != e_tail:
        if e_tail:
            findings.append(f"OUT-05 {output_rel}: 「{UNREADABLE_HEADING}」の節に、読めなかったファイル "
                            f"{len(result['unreadable'])} 件を1行ずつ書いてください")
        else:
            findings.append(f"OUT-05 {output_rel}: 読めなかったファイルは無いので、「{UNREADABLE_HEADING}」の節を消してください")
    return findings


def report(result: dict, output_rel: str) -> str:
    return "\n".join([
        "## " + "TODO コメントの一覧", "",
        f"- 出力: `{output_rel}`",
        f"- 対象: `{result['source']}`",
        f"- 調べたファイル: {len(result['scanned'])} 件",
        f"- 読めなかったファイル: {len(result['unreadable'])} 件",
        f"- TODO コメント: {len(result['rows'])} 件",
    ])


def inside(root: Path, rel: str):
    """ルートからの相対パス（POSIX、ルートは「.」）。ルートの外なら None。"""
    target = (root / rel).resolve()
    root_real = root.resolve()
    if target != root_real and root_real not in target.parents:
        return None
    return target.relative_to(root_real).as_posix() if target != root_real else "."


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--source", default=".", help="変換元のディレクトリかファイル（ルートからの相対パス）")
    parser.add_argument("--output", default="todo-comments.md", help="一覧の Markdown（ルートからの相対パス）")
    parser.add_argument("--root", help="プロジェクトのルート")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="書いた一覧を検査する")
    mode.add_argument("--report", action="store_true", help="一覧が最新かを確かめ、報告の節を出す")
    parser.add_argument("--rule", help="--check で、このルールIDの指摘だけを出す")
    args = parser.parse_args(argv)

    root = Path(args.root).resolve() if args.root else project_root(Path.cwd())
    source_rel = inside(root, args.source.strip() or ".")
    if source_rel is None or not (root / source_rel).exists():
        print(f"変換元 {args.source} がプロジェクト（{root}）にありません（STEP-03）", file=sys.stderr)
        return EXIT_SOURCE
    output_rel = inside(root, args.output.strip())
    if output_rel is None or output_rel == ".":
        print(f"出力 {args.output} はプロジェクトの中のファイルにしてください", file=sys.stderr)
        return EXIT_USAGE
    output = root / output_rel
    result = scan(root, source_rel, output_rel)
    expected = render(result)

    if args.check or args.report:
        if not output.is_file():
            print(f"OUT-01 {output_rel} がありません。手順の collect_todo.py を実行してください")
            return EXIT_FINDINGS
        try:
            text = output.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            print(f"STEP-02 {output_rel} が UTF-8 で読めません。collect_todo.py で書き直してください")
            return EXIT_FINDINGS
        if args.report:
            if text != expected:
                print(f"STEP-02 {output_rel} が collect_todo.py の出力と違います。手順の collect_todo.py をやり直してください")
                return EXIT_FINDINGS
            print(report(result, output_rel))
            return 0
        findings = check(text, expected, result, output_rel)
        if args.rule:
            findings = [f for f in findings if f.split(" ", 1)[0] == args.rule]
        for line in findings:
            print(line)
        return EXIT_FINDINGS if findings else 0

    if output.exists():
        try:
            first = output.read_text(encoding="utf-8").split("\n", 1)[0]
        except (UnicodeDecodeError, IsADirectoryError):
            first = None
        if first != TITLE:
            print(f"{output_rel} は手で書いたファイル（1行目が「{TITLE}」でない）なので上書きしません（OUT-04）",
                  file=sys.stderr)
            return EXIT_HANDWRITTEN
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(expected, encoding="utf-8")
    print(f"書いた: {output_rel}")
    print(f"調べたファイル: {len(result['scanned'])} 件")
    print(f"読めなかったファイル: {len(result['unreadable'])} 件")
    print(f"TODO コメント: {len(result['rows'])} 件")
    return 0


if __name__ == "__main__":
    sys.exit(main())

