決定: STEP-03（collect と check --rule STEP-03）、OUT-02・OUT-03・OUT-04・OUT-09（check）、OUT-07（placement）

サブコマンド:
  collect    CHANGELOG.md を除くステージされたファイルの一覧（パスの昇順）と差分を出し、
             一覧と差分の指紋を .skill-runs/write-changelog-entry/work/staged.json に記録する
  check      節のファイルを1つのルールで検査し、違反を「<ルールID> <説明>」の行で出す
  placement  CHANGELOG.md の状態を読み、節の反映のしかたを「## CHANGELOG.md への反映」の節として出す

終了コード:
  0  成功（check は指摘なし）
  1  指摘あり（check）
  2  実行の誤り（git のリポジトリでない、git が無い、引数の誤り）
  4  CHANGELOG.md のほかにステージされた変更が無い（collect）

使い方:
  python3 changelog_entry.py collect [--root <プロジェクトのルート>]
  python3 changelog_entry.py check --rule <OUT-02|OUT-03|OUT-04|OUT-09|STEP-03> [--language ja|en] [--root <ルート>] <節のファイル>
  python3 changelog_entry.py placement [--root <ルート>]
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

NAME = "write-changelog-entry"
RECORD_REL = f".skill-runs/{NAME}/work/staged.json"
OUTPUT_REL = f".skill-runs/{NAME}/out/changelog-entry.md"
CHANGELOG = "CHANGELOG.md"
PATHSPEC = ["--", ".", f":(exclude){CHANGELOG}"]
MAX_DIFF_LINES = 3000

TYPES = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
ENDING_JA = {"Added": "追加した。", "Changed": "変更した。", "Deprecated": "非推奨にした。",
             "Removed": "削除した。", "Fixed": "修正した。", "Security": "修正した。"}
VERB_EN = {"Added": "Add", "Changed": "Change", "Deprecated": "Deprecate",
           "Removed": "Remove", "Fixed": "Fix", "Security": "Fix"}
JA_CHAR = re.compile(r"[぀-ヿ㐀-鿿]")
COMMENT_LINE = re.compile(r"^\s*<!--.*-->\s*$")
UNRELEASED_H2 = re.compile(r"^## \[Unreleased\]\s*$", re.I)
VERSION_H2 = re.compile(r"^## \[[^\]]+\] - \d{4}-\d{2}-\d{2}(?: \[YANKED\])?\s*$")


def git(root: Path, *args: str, binary: bool = False):
    proc = subprocess.run(["git", "-c", "core.quotepath=false", *args], cwd=root, capture_output=True)
    if proc.returncode != 0:
        raise RuntimeError(proc.stderr.decode("utf-8", "replace").strip() or f"git {args[0]} が失敗しました")
    return proc.stdout if binary else proc.stdout.decode("utf-8", "replace")


def find_root(raw: str | None) -> Path:
    if raw:
        return Path(raw).resolve()
    try:
        return Path(git(Path.cwd(), "rev-parse", "--show-toplevel").strip())
    except (RuntimeError, FileNotFoundError):
        return Path.cwd()


def staged_files(root: Path) -> list[dict]:
    raw = git(root, "diff", "--cached", "--name-status", "-M", "-z", *PATHSPEC)
    parts = [p for p in raw.split("\0")]
    files, i = [], 0
    while i < len(parts) and parts[i]:
        status = parts[i]
        if status[0] in "RC":
            files.append({"status": status, "old_path": parts[i + 1], "path": parts[i + 2]})
            i += 3
        else:
            files.append({"status": status, "old_path": None, "path": parts[i + 1]})
            i += 2
    return sorted(files, key=lambda f: f["path"])


def fingerprint(root: Path) -> str:
    data = git(root, "diff", "--cached", "-M", "--binary", "--no-color", "--no-ext-diff", *PATHSPEC, binary=True)
    return hashlib.sha256(data).hexdigest()


def cmd_collect(args) -> int:
    root = find_root(args.root)
    try:
        git(root, "rev-parse", "--git-dir")
        files = staged_files(root)
        diff = git(root, "diff", "--cached", "-M", "--no-color", "--no-ext-diff", "--no-textconv", *PATHSPEC)
        mark = fingerprint(root)
    except FileNotFoundError:
        print("git が見つからない（STEP-05）")
        return 2
    except RuntimeError as exc:
        print(f"git のリポジトリでないか、git が失敗した: {exc}（STEP-05）")
        return 2
    if not files:
        print("CHANGELOG.md のほかにステージされた変更が無い（IN-01: `run.py abort --reason ステージされた変更が無い`）")
        return 4
    record = root / RECORD_REL
    record.parent.mkdir(parents=True, exist_ok=True)
    record.write_text(json.dumps({"fingerprint": mark, "files": files}, ensure_ascii=False, indent=2) + "\n",
                      encoding="utf-8")
    lines = diff.splitlines()
    print(f"ステージされたファイル（CHANGELOG.md を除く、パスの昇順）: {len(files)}")
    for f in files:
        shown = f"{f['old_path']} -> {f['path']}" if f["old_path"] else f["path"]
        print(f"{f['status']}\t{shown}")
    if len(lines) > MAX_DIFF_LINES:
        print(f"差分: {len(lines)} 行（先頭の {MAX_DIFF_LINES} 行だけを下に出す。残りは `git diff --cached -- <パス>` で読む）")
    else:
        print(f"差分: {len(lines)} 行（全部を下に出す）")
    print(f"記録: {RECORD_REL}")
    print("次: STEP-02 の表で、変更ごとに種類を決める。項目の順は、この一覧の順にする（OUT-05）")
    print("")
    print("----- 差分 -----")
    print("\n".join(lines[:MAX_DIFF_LINES]))
    return 0


def parse(text: str) -> list[tuple[int, str, str]]:
    """節の行を (行番号, 種類, 行) にする。種類は h2・h3・item・blank・comment・other。"""
    rows = []
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    for n, line in enumerate(lines, 1):
        if COMMENT_LINE.match(line):
            kind = "comment"
        elif line.strip() == "":
            kind = "blank"
        elif line.startswith("## "):
            kind = "h2"
        elif line.startswith("### "):
            kind = "h3"
        elif re.match(r"^- \S", line):
            kind = "item"
        else:
            kind = "other"
        rows.append((n, kind, line))
    return [r for r in rows if r[1] != "comment"]


def groups(rows) -> list[tuple[int, str, list[tuple[int, str]]]]:
    """`### <種類>` ごとの (行番号, 種類, [(行番号, 項目の本文)])。"""
    result = []
    for n, kind, line in rows:
        if kind == "h3":
            result.append((n, line[4:].strip(), []))
        elif kind == "item" and result:
            result[-1][2].append((n, line[2:].strip()))
    return result


def check_structure(rows) -> list[str]:
    out = []
    if not rows or rows[0][2] != "## [Unreleased]":
        first = rows[0][2] if rows else "（空）"
        out.append(f"OUT-02 1行目は `## [Unreleased]` にする（今: `{first}`）")
    seen = set()
    for idx, (n, kind, line) in enumerate(rows):
        prev = rows[idx - 1][1] if idx > 0 else None
        nxt = rows[idx + 1][1] if idx + 1 < len(rows) else None
        if kind == "h2" and idx > 0:
            out.append(f"OUT-02 {n}行目: `## ` の見出しは1行目の `## [Unreleased]` だけにする")
        elif kind == "h3":
            name = line[4:].strip()
            if name not in TYPES:
                out.append(f"OUT-02 {n}行目: 種類の見出しは `### Added`、`### Changed`、`### Deprecated`、`### Removed`、`### Fixed`、`### Security` のどれかにする（今: `{line}`）")
            elif name in seen:
                out.append(f"OUT-02 {n}行目: `### {name}` を2回書かない。1つのまとまりにする")
            seen.add(name)
            if prev != "blank":
                out.append(f"OUT-02 {n}行目: 種類の見出しの前に空行を1行置く")
            if nxt != "blank":
                out.append(f"OUT-02 {n}行目: 種類の見出しの後に空行を1行置く")
            elif idx + 2 >= len(rows) or rows[idx + 2][1] != "item":
                out.append(f"OUT-02 {n}行目: `{line}` の下に `- ` で始まる項目を1つ以上書く。項目の無い見出しは書かない")
        elif kind == "item":
            if prev not in ("item", "blank") or (prev == "blank" and (idx < 2 or rows[idx - 2][1] != "h3")):
                out.append(f"OUT-02 {n}行目: 項目は種類の見出しと空行1行の直後に、空行を挟まずに並べる")
        elif kind == "blank":
            if prev == "blank":
                out.append(f"OUT-02 {n}行目: 空行を2行続けない")
            if nxt is None:
                out.append(f"OUT-02 {n}行目: 節の末尾に空行を置かない")
        elif kind == "other":
            out.append(f"OUT-02 {n}行目: 見出しと `- ` で始まる1行の項目のほかに書かない（入れ子の項目と文も書かない）（今: `{line}`）")
    if not any(kind == "h3" for _, kind, _ in rows):
        out.append("OUT-02 種類のまとまり（`### <種類>` と項目）が1つも無い")
    return out


def check_style(rows, language: str) -> list[str]:
    out = []
    for _, name, items in groups(rows):
        if name not in TYPES:
            continue
        for n, body in items:
            if language == "en":
                if JA_CHAR.search(body):
                    out.append(f"OUT-03 {n}行目: language が en なので、項目に日本語の文字を書かない")
                if not body.startswith(VERB_EN[name] + " "):
                    out.append(f"OUT-03 {n}行目: `### {name}` の項目は `{VERB_EN[name]} ` で始める（en）")
                if not body.endswith("."):
                    out.append(f"OUT-03 {n}行目: 項目は `.` で終える（en）")
            else:
                if not JA_CHAR.search(body):
                    out.append(f"OUT-03 {n}行目: language が ja なので、項目を日本語で書く")
                if not body.endswith(ENDING_JA[name]):
                    out.append(f"OUT-03 {n}行目: `### {name}` の項目は「{ENDING_JA[name]}」で終える（ja。です・ます を使わない）")
                if body.count("。") > 1:
                    out.append(f"OUT-03 {n}行目: 1項目は1文にする（「。」は文末の1つだけ）")
    return out


def check_order(rows) -> list[str]:
    out, last = [], -1
    for n, name, _ in groups(rows):
        if name not in TYPES:
            continue
        pos = TYPES.index(name)
        if pos < last:
            out.append(f"OUT-04 {n}行目: `### {name}` は `### {TYPES[last]}` より前に置く"
                       f"（順: {'、'.join(TYPES)}）")
        last = max(last, pos)
    return out


def recorded_paths(root: Path) -> list[str]:
    record = root / RECORD_REL
    files = []
    if record.is_file():
        try:
            files = json.loads(record.read_text(encoding="utf-8")).get("files", [])
        except json.JSONDecodeError:
            files = []
    if not files:
        try:
            files = staged_files(root)
        except (RuntimeError, FileNotFoundError):
            files = []
    paths = []
    for f in files:
        paths += [p for p in (f.get("path"), f.get("old_path")) if p]
    return paths


def check_names(rows, root: Path) -> list[str]:
    out = []
    paths = recorded_paths(root)
    for n, kind, line in rows:
        if kind != "item":
            continue
        for path in paths:
            base = path.rsplit("/", 1)[-1]
            words = [path] + ([base] if "." in base.strip(".") or base.startswith(".") else [])
            for word in dict.fromkeys(words):
                if re.search(r"(?<![\w./-])" + re.escape(word) + r"(?![\w-])", line):
                    out.append(f"OUT-09 {n}行目: ステージされたファイルのパスかファイル名 `{word}` を書かない。利用者が使う名前で書く")
                    break
    return out


def check_record(root: Path) -> list[str]:
    record = root / RECORD_REL
    if not record.is_file():
        return [f"STEP-03 `{RECORD_REL}` が無い。`changelog_entry.py collect` を実行してから節を書く"]
    try:
        saved = json.loads(record.read_text(encoding="utf-8")).get("fingerprint")
        now = fingerprint(root)
    except (json.JSONDecodeError, RuntimeError, FileNotFoundError) as exc:
        return [f"STEP-03 collect の記録とステージを比べられない: {exc}"]
    if saved != now:
        return ["STEP-03 collect の後にステージが変わった。`changelog_entry.py collect` をやり直し、節を書き直す"]
    return []


def cmd_check(args) -> int:
    root = find_root(args.root)
    path = Path(args.file)
    if not path.is_absolute():
        path = root / path
    if args.rule == "STEP-03":
        problems = check_record(root)
    else:
        if not path.is_file():
            print(f"{args.rule} 節のファイル `{args.file}` が無い")
            return 1
        rows = parse(path.read_text(encoding="utf-8"))
        problems = {
            "OUT-02": lambda: check_structure(rows),
            "OUT-03": lambda: check_style(rows, (args.language or "ja").lower()),
            "OUT-04": lambda: check_order(rows),
            "OUT-09": lambda: check_names(rows, root),
        }[args.rule]()
    for line in problems:
        print(line)
    return 1 if problems else 0


def changelog_state(root: Path) -> tuple[str, int, int, str]:
    """(状態, 行番号, 項目の数, 見出し)。状態は missing・unreleased・releases-only・no-sections・other-format。"""
    path = root / CHANGELOG
    if not path.is_file():
        return "missing", 0, 0, ""
    lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    h2 = [(n, line) for n, line in enumerate(lines, 1) if line.startswith("## ")]
    for n, line in h2:
        if not (UNRELEASED_H2.match(line) or VERSION_H2.match(line)):
            return "other-format", n, 0, line.strip()
    for i, (n, line) in enumerate(h2):
        if UNRELEASED_H2.match(line):
            end = h2[i + 1][0] - 1 if i + 1 < len(h2) else len(lines)
            items = sum(1 for x in lines[n:end] if re.match(r"^\s*[-*+] ", x))
            return "unreleased", n, items, line.strip()
    if h2:
        return "releases-only", h2[0][0], 0, h2[0][1].strip()
    return "no-sections", len(lines), 0, ""


def cmd_placement(args) -> int:
    root = find_root(args.root)
    state, line, items, heading = changelog_state(root)
    order = "、".join(TYPES)
    if state == "missing":
        status = "CHANGELOG.md が無い"
        how = f"1行目に `# Changelog`、空行1行の後に `{OUTPUT_REL}` の節を置いて、CHANGELOG.md を作る"
    elif state == "unreleased" and items == 0:
        status = f"{line} 行目に `{heading}` があり、項目は 0 個"
        how = f"CHANGELOG.md の {line} 行目の `{heading}` の行を、`{OUTPUT_REL}` の節で置き換える"
    elif state == "unreleased":
        status = f"{line} 行目に `{heading}` があり、項目は {items} 個"
        how = (f"CHANGELOG.md の {line} 行目の `{heading}` の節に、`{OUTPUT_REL}` の項目を種類ごとに足す。"
               f"同じ種類の見出しがあればその項目の末尾に足し、無ければ種類の順（{order}）の位置に見出しごと足す")
    elif state == "releases-only":
        status = f"`## [Unreleased]` が無く、最初の版の見出しが {line} 行目の `{heading}`"
        how = f"CHANGELOG.md の {line} 行目の前に、`{OUTPUT_REL}` の節と空行1行を足す"
    elif state == "no-sections":
        status = "`## ` の見出しが1つも無い"
        how = f"CHANGELOG.md の末尾に、空行1行と `{OUTPUT_REL}` の節を足す"
    else:
        status = f"{line} 行目の見出し `{heading}` が Keep a Changelog の形（`## [版] - YYYY-MM-DD`）でない"
        how = f"`{OUTPUT_REL}` の見出しと項目を CHANGELOG.md の書き方に合わせてから、最初の `## ` の見出しの前に足す"
    print("## CHANGELOG.md への反映")
    print("")
    print(f"- 状態: {status}")
    print(f"- 反映のしかた: {how}")
    print("- 反映の後: このスキルは CHANGELOG.md もステージも変えていない。反映した後に `git add CHANGELOG.md` でステージする")
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="CHANGELOG.md に足す節のための collect・check・placement")
    sub = parser.add_subparsers(dest="command")
    p_collect = sub.add_parser("collect", help="ステージされた変更を集めて記録する")
    p_collect.add_argument("--root")
    p_check = sub.add_parser("check", help="節のファイルを1つのルールで検査する")
    p_check.add_argument("--rule", required=True, choices=["OUT-02", "OUT-03", "OUT-04", "OUT-09", "STEP-03"])
    p_check.add_argument("--language", default="ja")
    p_check.add_argument("--root")
    p_check.add_argument("file", nargs="?", default=OUTPUT_REL)
    p_place = sub.add_parser("placement", help="CHANGELOG.md への反映のしかたを出す")
    p_place.add_argument("--root")
    args = parser.parse_args(argv)
    if args.command == "collect":
        return cmd_collect(args)
    if args.command == "check":
        return cmd_check(args)
    if args.command == "placement":
        return cmd_placement(args)
    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())

