"""ソースコードの TODO コメントを集めて一覧の Markdown を書き、書いた一覧を集め直した結果と比べる。

決定: IN-01、IN-02、STEP-01、STEP-02、OUT-01、OUT-02、OUT-03、OUT-04、OUT-05

サブコマンド:
  write  source の下のファイルを列挙し（IN-02）、TODO コメントを集め（STEP-02）、一覧を書く（OUT-01〜OUT-05）。
         既定の書き先は .skill-runs/analyze-todo-comment/out/todo-comment.md。標準出力には、書いたパスと件数を1行で出す
  check  一覧のファイルを、集め直した結果と比べる。違反ごとに `<ルールID> <ファイル>:<行> <説明>` の行を出す

source を省くと、実行記録（.skill-runs/analyze-todo-comment/state.json）の入力 source を使い、記録が無ければ `.` にする。
2つ以上の場所は `,` か `、` で区切る。プロジェクトのルートは、作業ディレクトリから親へ辿って最初に .git がある場所
（無ければ作業ディレクトリ）である。

終了コード: 0 成功（check は指摘なし）、1 check の指摘あり、2 実行の誤り（git の失敗、一覧のファイルが無い）、
           4 source のパスが無いか、プロジェクトの外を指す（IN-01）

使い方:
  python3 <skill>/scripts/collect_todo.py write [--source <場所>] [--out <ファイル>] [--root <プロジェクトのルート>]
  python3 <skill>/scripts/collect_todo.py check <一覧のファイル> [--source <場所>] [--root <プロジェクトのルート>]
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

NAME = "analyze-todo-comment"
OUT_REL = f".skill-runs/{NAME}/out/todo-comment.md"
STATE_REL = f".skill-runs/{NAME}/state.json"
TITLE = "# TODO コメントの一覧"
LABELS = ["- 対象: ", "- 調べたファイル: ", "- TODO コメント: ", "- 集めたコマンド: "]
TABLE_HEAD = "| 場所 | コメント |"
TABLE_RULE = "|---|---|"
MARKDOWN_EXT = {".md", ".markdown"}
TAG = r"[ \t]*((?i:todo)\b.*)$"
GENERAL = re.compile(r"(?:(?:^|(?<=\s))(?:#+|/{2,}|/\*+|<!--|--|;+|%+)|^\s*\*+)" + TAG)
MARKDOWN = re.compile(r"(?:^|(?<=\s))<!--" + TAG)
