ROW = re.compile(r"^\| `(.+):([1-9][0-9]*)` \| (.+) \|$")


class Stop(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def find_root(raw: str | None) -> Path:
    if raw:
        return Path(raw).resolve()
    current = Path.cwd().resolve()
    for candidate in [current, *current.parents]:
        if (candidate / ".git").exists():
            return candidate
    return current


def raw_source(root: Path, given: str | None) -> str:
    if given is not None and given.strip():
        return given
    state = root / STATE_REL
    if state.is_file():
        try:
            value = json.loads(state.read_text(encoding="utf-8")).get("input", {}).get("source")
        except (json.JSONDecodeError, OSError):
            value = None
        if isinstance(value, str) and value.strip():
            return value
    return "."


def normalize_sources(root: Path, raw: str) -> list[str]:
    """`,`・`、` で区切った場所を、ルートからの相対パス（POSIX 形式、`.` はルート）の昇順の一覧にする。"""
    result = set()
    for part in re.split(r"[,、，]", raw):
        part = part.strip().replace("\\", "/")
        if not part:
            continue
        target = (root / part).resolve()
        try:
            rel = target.relative_to(root)
        except ValueError:
            raise Stop(4, f"source がプロジェクトの外を指しています: {part}")
        if not target.exists():
            raise Stop(4, f"source のパスがありません: {part}")
        result.add(rel.as_posix() if rel.parts else ".")
    return sorted(result) or ["."]


def git_files(root: Path, sources: list[str]) -> list[str]:
    command = ["git", "--literal-pathspecs", "ls-files", "-z", "--cached", "--others", "--exclude-standard", "--", *sources]
    try:
        proc = subprocess.run(command, cwd=root, capture_output=True)
    except OSError as exc:
        raise Stop(2, f"git を実行できません: {exc}")
    if proc.returncode != 0:
        raise Stop(2, f"git ls-files が失敗しました: {proc.stderr.decode('utf-8', 'replace').strip()}")
    return [p for p in proc.stdout.decode("utf-8", "surrogateescape").split("\0") if p]


def walk_files(root: Path, sources: list[str]) -> list[str]:
    found = []
    for source in sources:
        base = root / source
        if base.is_file():
            found.append(source)
            continue
        for dirpath, dirnames, filenames in os.walk(base):
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for name in filenames:
                found.append((Path(dirpath) / name).relative_to(root).as_posix())
    return found


def admitted(path: str, sources: list[str]) -> bool:
    """source から見たパスに `.` で始まる名前が無ければ true（IN-02）。"""
    for source in sources:
        if source == ".":
            rest = path
        elif path == source:
            rest = ""
        elif path.startswith(source + "/"):
            rest = path[len(source) + 1:]
        else:
            continue
        if not any(part.startswith(".") for part in rest.split("/") if part):
            return True
    return False


def comment_text(raw: str) -> str:
    text = raw.rstrip()
    changed = True
    while changed:
        changed = False
        for closer in CLOSERS:
            if text.endswith(closer):
                text = text[: -len(closer)].rstrip()
                changed = True
    return text.replace("|", "\\|")


def todos_in(path: str, text: str) -> list[tuple[int, str]]:
    pattern = MARKDOWN if Path(path).suffix.lower() in MARKDOWN_EXT else GENERAL
    found = []
    for number, line in enumerate(text.split("\n"), 1):
        match = pattern.search(line.rstrip("\r"))
        if match:
            found.append((number, comment_text(match.group(1))))
    return found


def collect(root: Path, sources: list[str]) -> dict:
    listed = git_files(root, sources) if (root / ".git").exists() else walk_files(root, sources)
    files, unreadable, todos = [], 0, []
    for path in sorted(set(listed)):
        full = root / path
        if full.is_symlink() or not full.is_file() or not admitted(path, sources):
            continue
        files.append(path)
        data = full.read_bytes()
        try:
            if b"\0" in data:
                raise UnicodeDecodeError("utf-8", data, 0, 1, "NUL")
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            unreadable += 1
