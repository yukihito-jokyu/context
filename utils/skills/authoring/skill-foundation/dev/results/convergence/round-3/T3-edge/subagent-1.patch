def command_line(root: Path, sources: list[str]) -> str:
    script = os.path.relpath(Path(__file__).resolve(), root).replace(os.sep, "/")
    return f"python3 {script} write --source {shlex.quote(','.join(sources))}"


def header_values(root: Path, result: dict) -> list[str]:
    return [
        "、".join(f"`{s}`" for s in result["sources"]),
        f"{len(result['files'])} 件（テキストとして読めなかったファイル: {result['unreadable']} 件）",
        f"{len(result['todos'])} 件",
