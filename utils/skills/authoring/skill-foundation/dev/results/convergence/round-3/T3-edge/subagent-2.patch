    if target.resolve() == body and not target.is_symlink():
        return []  # 本体がここにある
    changes = []
    if remove:
        if target.is_symlink() or target.exists():
            changes.append(f"{target.relative_to(root)} を外す")
            if not dry:
                if target.is_symlink() or target.is_file():
