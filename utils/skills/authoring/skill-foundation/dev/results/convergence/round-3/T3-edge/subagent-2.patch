#!/usr/bin/env python3
"""ソースコードの TODO コメントを集め、Markdown の一覧を書き、書いた一覧を数え直して検査する。

決定: IN-01（範囲が無いときの終了コード4）、IN-02（読む範囲）、STEP-01（一覧を書く・数え直す）、
STEP-02（TODO コメントに当たる行）、OUT-02（一覧の形）、OUT-03（並べ順と件数）、OUT-04（対象と数えたコマンド）

サブコマンド:
  scan   範囲の TODO コメントを数え、「件数: N 件（M ファイル）」と「<パス>:<行番号>\t<内容>」の行を出す
  write  scan と同じ結果を、OUT-02 の形の Markdown にして --out に書く（前の一覧は上書きする）
  check  --out に書かれた一覧を scan の結果と比べ、違いを「<ルールID> <説明>」の行で出す

終了コード: 0 成功（check は指摘なし）、1 check の指摘あり、2 実行の誤り（git の失敗、ファイルを読めない）、
            4 範囲が無い（source のパスが無い、ルートの外、git のリポジトリでない。IN-01）

使い方:
  python3 <skill>/scripts/todo_comment.py scan  --source <パス> [--root <プロジェクトのルート>]
  python3 <skill>/scripts/todo_comment.py write --source <パス> --out <一覧のファイル> [--root <ルート>]
  python3 <skill>/scripts/todo_comment.py check <一覧のファイル> --source <パス> [--root <ルート>]
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

TITLE = "# TODO コメントの一覧"
TABLE_HEAD = "| ファイル | 行 | 内容 |"
TABLE_RULE = "|---|---:|---|"
EMPTY = "TODO コメントは見つからなかった。"
SKIP_PREFIXES = (".agents/", ".claude/", ".codex/", ".skill-runs/")
MARKER = re.compile(r"(?:^|(?<=[\s;{}()]))(?:#+|//+|/\*+|<!--+|--+)[ \t]*TODO(?![A-Za-z0-9_])")
STAR = re.compile(r"^[ \t]*\*+[ \t]*TODO(?![A-Za-z0-9_])")
CLOSERS = ("*/", "-->")
ROW = re.compile(r"^\| `(.+)` \| (\d+) \| (.*) \|$")
COUNT = re.compile(r"^- 件数: (\d+) 件（(\d+) ファイル）$")


class Stop(Exception):
    def __init__(self, code: int, message: str):
        super().__init__(message)
        self.code = code


def git(args: list[str], root: Path) -> str:
    proc = subprocess.run(["git", *args], cwd=root, capture_output=True)
    if proc.returncode != 0:
        raise Stop(2, f"git {' '.join(args)} が失敗しました: {proc.stderr.decode('utf-8', 'replace').strip()}")
    return proc.stdout.decode("utf-8", "surrogateescape")


def find_root(raw: str) -> Path:
    base = Path(raw).resolve()
    if not base.is_dir():
        raise Stop(4, f"プロジェクトのルートがありません: {raw}")
    proc = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=base, capture_output=True, text=True)
    if proc.returncode != 0:
        raise Stop(4, f"git のリポジトリではありません: {base}")
    return Path(proc.stdout.strip()).resolve()


def normalize_source(root: Path, raw: str) -> str:
    """source をルートからの / 区切りの相対パスにする。ルートなら「.」。"""
    target = Path(raw) if Path(raw).is_absolute() else root / raw
    target = Path(os.path.normpath(str(target)))
    if not target.exists():
        raise Stop(4, f"source のパスがありません: {raw}")
    try:
        rel = target.resolve().relative_to(root)
    except ValueError:
        raise Stop(4, f"source がプロジェクトのルートの外を指しています: {raw}") from None
    text = rel.as_posix()
    return "." if text in ("", ".") else text


def todo_text(line: str) -> str | None:
    """STEP-02 の表で「載せる」に当たる行なら、TODO から行末まで（閉じる印の手前まで）を返す。"""
    match = MARKER.search(line) or STAR.search(line)
    if not match:
        return None
    text = line[line.index("TODO", match.start()):]
    for closer in CLOSERS:
        if closer in text:
            text = text[:text.index(closer)]
    return text.rstrip()


def read_lines(path: Path) -> list[str] | None:
    try:
        data = path.read_bytes()
    except OSError as exc:
        raise Stop(2, f"ファイルを読めません: {path}: {exc}") from None
    if b"\0" in data:
        return None
    return [line.rstrip("\r") for line in data.decode("utf-8", "replace").split("\n")]


def list_files(root: Path, source: str) -> list[str]:
    """IN-02 の表で「読む」に当たるファイル（ルートからの相対パス、昇順）。"""
    out = git(["ls-files", "--cached", "--others", "--exclude-standard", "-z", "--", source], root)
    files = []
    for rel in sorted(set(p for p in out.split("\0") if p)):
        path = root / rel
        if rel.startswith(SKIP_PREFIXES) or path.is_symlink() or not path.is_file():
            continue
        files.append(rel)
    return files


def scan(root: Path, source: str) -> tuple[list[str], list[tuple[str, int, str]]]:
    files = list_files(root, source)
    rows = []
    for rel in files:
        lines = read_lines(root / rel)
        if lines is None:
            continue
        for number, line in enumerate(lines, 1):
            text = todo_text(line)
            if text is not None:
                rows.append((rel, number, text))
    return files, rows


def command_line(root: Path, source: str) -> str:
    script = Path(os.path.abspath(__file__))
    try:
        shown = script.relative_to(root).as_posix()
    except ValueError:
        shown = script.as_posix()
    return f"python3 {shown} scan --source {source}"


def escape(text: str) -> str:
    return text.replace("|", "\\|")


def unescape(text: str) -> str:
    return text.replace("\\|", "|")


def count_line(rows: list[tuple[str, int, str]]) -> str:
    return f"- 件数: {len(rows)} 件（{len({r[0] for r in rows})} ファイル）"


def render(root: Path, source: str, rows: list[tuple[str, int, str]]) -> str:
    lines = [TITLE, "", f"- 対象: `{source}`", count_line(rows), f"- 数えたコマンド: `{command_line(root, source)}`", ""]
    if rows:
        lines += [TABLE_HEAD, TABLE_RULE]
        lines += [f"| `{escape(path)}` | {number} | {escape(text)} |" for path, number, text in rows]
    else:
        lines.append(EMPTY)
    return "\n".join(lines) + "\n"


def check(root: Path, source: str, file: Path) -> list[str]:
    files, rows = scan(root, source)
    try:
        lines = file.read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        return [f"OUT-01 一覧を UTF-8 のテキストとして読めません: {exc}"]
    errors = []
    head = lines[:6]
    if f"- 対象: `{source}`" not in head:
        errors.append(f"OUT-04 3行目は「- 対象: `{source}`」にしてください")
    if f"- 数えたコマンド: `{command_line(root, source)}`" not in head:
        errors.append(f"OUT-04 5行目は「- 数えたコマンド: `{command_line(root, source)}`」にしてください")
    count = [line for line in head if line.startswith("- 件数: ")]
    if count and count[0] != count_line(rows):
        errors.append(f"OUT-03 件数の行は「{count_line(rows)}」にしてください（今: {count[0]}）")
    body = lines[6:]
    if not rows:
        if body != [EMPTY]:
            errors.append(f"OUT-02 TODO が0件なので、7行目からは「{EMPTY}」の1行だけにしてください")
        return errors
    if body[:2] != [TABLE_HEAD, TABLE_RULE]:
        errors.append(f"OUT-02 7行目と8行目は「{TABLE_HEAD}」と「{TABLE_RULE}」にしてください")
        return errors
    found = []
    for number, line in enumerate(body[2:], 9):
        match = ROW.match(line)
        if not match:
            errors.append(f"OUT-02 {number}行目は「| `<パス>` | <行番号> | <内容> |」の表の行にしてください。表の後に行を足さないでください")
            continue
        found.append((unescape(match.group(1)), int(match.group(2)), unescape(match.group(3))))
    expected = {(path, number): text for path, number, text in rows}
    texts_by_file: dict[str, set[str]] = {}
    for path, _, text in rows:
        texts_by_file.setdefault(path, set()).add(text)
    seen = set()
    for path, number, text in found:
        key = (path, number)
        seen.add(key)
        if key in expected:
            if text != expected[key]:
                errors.append(f"STEP-01 `{path}` の {number} 行目の内容は「{expected[key]}」です（今: {text}）。書き換えないでください")
        elif path not in files:
            errors.append(f"IN-02 `{path}` は読む範囲の外です（source の外、.gitignore で無視、AI の道具の置き場、バイナリ）")
        elif text in texts_by_file.get(path, set()):
            errors.append(f"STEP-01 `{path}` の「{text}」の行番号が違います（今: {number}）")
        else:
            errors.append(f"STEP-02 `{path}` の {number} 行目は TODO コメントに当たりません")
    missing = [f"`{path}` の {number} 行目" for path, number, _ in rows if (path, number) not in seen]
    if missing:
        errors.append(f"STEP-01 一覧に無い TODO があります: {'、'.join(missing[:10])}（全 {len(missing)} 件）")
    order = [(path, number) for path, number, _ in found]
    if order != sorted(order):
        errors.append("OUT-03 表の行はパスの昇順、同じパスの中は行番号の昇順に並べてください")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("scan", "write", "check"):
        p = sub.add_parser(name)
        if name == "check":
            p.add_argument("file")
        p.add_argument("--source", default=".")
        p.add_argument("--root", default=".")
        if name == "write":
            p.add_argument("--out", required=True)
    args = parser.parse_args()
    try:
        root = find_root(args.root)
        source = normalize_source(root, args.source)
        if args.command == "scan":
            _, rows = scan(root, source)
            print(count_line(rows)[2:])
            for path, number, text in rows:
                print(f"{path}:{number}\t{text}")
            return 0
        if args.command == "write":
            _, rows = scan(root, source)
            out = Path(args.out) if Path(args.out).is_absolute() else root / args.out
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(render(root, source, rows), encoding="utf-8")
            print(f"書いた: {out.relative_to(root).as_posix() if out.is_relative_to(root) else out}（{count_line(rows)[2:]}）")
            return 0
        file = Path(args.file) if Path(args.file).is_absolute() else root / args.file
        errors = check(root, source, file)
        for error in errors:
            print(error)
        return 1 if errors else 0
    except Stop as stop:
        print(str(stop))
        return stop.code


if __name__ == "__main__":
    sys.exit(main())

