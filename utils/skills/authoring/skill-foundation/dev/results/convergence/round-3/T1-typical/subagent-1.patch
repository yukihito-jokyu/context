#!/usr/bin/env python3
"""コミットメッセージの本文と要約を検査する（契約の command 検査。OUT-02、OUT-03、STEP-02）。

サブコマンド:
  body     3行目から最後の行までが「- `<パス>`: <変更の要約>」の形の箇条書きだけか（OUT-02）
  summary  1行目の要約と箇条書きの要約が、--language の形か（OUT-03）
           ja: 最後の文字が終止形の語尾のひらがな（う く ぐ す ず つ づ ぬ ふ ぶ ぷ む ゆ る）
           en: ひらがな・カタカナ・漢字を含まない
  paths    箇条書きのパスが、ステージされたファイル（名前の変更は変更後のパス）と1対1で、パスの昇順か（STEP-02）

出力: 違反ごとに `<ルールID> <ファイル>:<行> <説明>`
終了コード: 0 合格、1 違反あり、2 実行の誤り（ファイルが読めない、git が使えない）

使い方:
  python3 <skill>/scripts/check_message.py body <メッセージのファイル>
  python3 <skill>/scripts/check_message.py summary <メッセージのファイル> [--language ja|en]
  python3 <skill>/scripts/check_message.py paths <メッセージのファイル> [--root <リポジトリのルート>]
"""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
from pathlib import Path

BULLET = re.compile(r"^- `([^`]+)`: (\S.*)$")
JA_ENDING = set("うくぐすずつづぬふぶぷむゆる")
JA_CHARS = re.compile(r"[぀-ヿ㐀-䶿一-鿿]")


def read_lines(file: str) -> list[str]:
    try:
        lines = Path(file).read_text(encoding="utf-8").splitlines()
    except (OSError, UnicodeDecodeError) as exc:
        print(f"{file} を読めません: {exc}", file=sys.stderr)
        sys.exit(2)
    while lines and not lines[-1].strip():
        lines.pop()  # 末尾の空行は形の違反にしない
    return lines


def body(file: str, lines: list[str]) -> list[str]:
    errors = []
    for number, line in enumerate(lines[2:], 3):
        if not line.strip():
            errors.append(f"OUT-02 {file}:{number} 本文に空行を入れないでください")
        elif not BULLET.match(line):
            errors.append(f"OUT-02 {file}:{number} 本文の行は「- `<パス>`: <変更の要約>」の形にしてください: {line[:60]}")
    return errors


def summaries(lines: list[str]) -> list[tuple[int, str]]:
    found = []
    if lines:
        _, sep, rest = lines[0].partition(" ")
        if sep:
            found.append((1, rest.strip()))
    for number, line in enumerate(lines[2:], 3):
        match = BULLET.match(line)
        if match:
            found.append((number, match.group(2).strip()))
    return found


def summary(file: str, lines: list[str], language: str) -> list[str]:
    errors = []
    for number, text in summaries(lines):
        if language == "en":
            if JA_CHARS.search(text):
                errors.append(f"OUT-03 {file}:{number} language が en なので、要約にひらがな・カタカナ・漢字を使わないでください: {text[:60]}")
        elif not text or text[-1] not in JA_ENDING:
            errors.append(f"OUT-03 {file}:{number} 要約は日本語の「<対象>を<動詞の終止形>」で終えてください"
                          f"（最後の文字は {'・'.join(sorted(JA_ENDING))} のどれか）: {text[:60]}")
    return errors


def staged(root: Path) -> list[str]:
    try:
        proc = subprocess.run(["git", "diff", "--cached", "-M", "--name-only", "-z"], cwd=root,
                              capture_output=True, text=True, encoding="utf-8", errors="replace")
    except FileNotFoundError:
        print("git が見つかりません", file=sys.stderr)
        sys.exit(2)
    if proc.returncode != 0:
        print(f"git diff --cached が失敗しました: {proc.stderr.strip()}", file=sys.stderr)
        sys.exit(2)
    return sorted({path for path in proc.stdout.split("\0") if path})


def paths(file: str, lines: list[str], root: Path) -> list[str]:
    expected = staged(root)
    found = [BULLET.match(line).group(1) for line in lines[2:] if BULLET.match(line)]
    errors = []
    missing = [p for p in expected if p not in found]
    extra = [p for p in found if p not in expected]
    duplicated = sorted({p for p in found if found.count(p) > 1})
    if missing:
        errors.append(f"STEP-02 {file} ステージされたファイルの箇条書きがありません: {missing}")
    if extra:
        errors.append(f"STEP-02 {file} ステージされていないパスの箇条書きがあります（1ファイル1行。ディレクトリでまとめない）: {extra}")
    if duplicated:
        errors.append(f"STEP-02 {file} 同じパスの箇条書きが2行以上あります: {duplicated}")
    if not missing and not extra and not duplicated and found != expected:
        errors.append(f"STEP-02 {file} 箇条書きはパスの昇順（collect_diff.py の「本文に書くパス」の順）に並べてください: {expected}")
    return errors


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=["body", "summary", "paths"])
    parser.add_argument("file")
    parser.add_argument("--language", default="ja")
    parser.add_argument("--root", default=".")
    args = parser.parse_args()
    lines = read_lines(args.file)
    if args.command == "body":
        errors = body(args.file, lines)
    elif args.command == "summary":
        errors = summary(args.file, lines, args.language.strip().lower())
    else:
        errors = paths(args.file, lines, Path(args.root).resolve())
    for error in errors:
        print(error)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())

