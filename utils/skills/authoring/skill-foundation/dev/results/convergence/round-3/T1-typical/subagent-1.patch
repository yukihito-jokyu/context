#!/usr/bin/env python3
"""ステージ済みの差分を集め、コミットメッセージの材料を出す（IN-01、IN-02、STEP-01、STEP-02、STEP-03、STEP-04）。

出力: ファイルの数、本文に書くパス（パスの昇順。名前の変更は変更後のパス）と変更の種類、ファイルごとの差分。
      1ファイルの差分は先頭 200 行、全体は 2000 行までにし、省いたときはそう書く。--path では、そのファイルの差分を 2000 行まで出す
終了コード: 0 材料あり、2 git が使えない（STEP-04）、4 ステージされた変更が無い（IN-01）

使い方:
  python3 <skill>/scripts/collect_diff.py [--root <リポジトリのルート>] [--path <パス>]
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

PER_FILE_LINES = 200
TOTAL_LINES = 2000
KINDS = {"A": "追加", "M": "変更", "D": "削除", "R": "名前の変更", "C": "複写", "T": "種類の変更", "U": "未解決の衝突"}
# 利用者の設定（diff.renames、外部 diff、textconv）で出力が変わらないよう、オプションを明示する。パスは -z で引用符を付けずに受け取る
DIFF = ["diff", "--cached", "-M", "--no-color", "--no-ext-diff", "--no-textconv"]


def git(args: list[str], root: Path) -> str:
    try:
        proc = subprocess.run(["git", "--literal-pathspecs", *args], cwd=root, capture_output=True, text=True,
                              encoding="utf-8", errors="replace")
    except FileNotFoundError:
        print("git が見つかりません", file=sys.stderr)
        sys.exit(2)
    if proc.returncode != 0:
        print(f"git {' '.join(args)} が失敗しました: {proc.stderr.strip()}", file=sys.stderr)
        sys.exit(2)
    return proc.stdout


def entries(root: Path) -> list[tuple[str, str, str]]:
    """（状態の1文字目, 本文に書くパス, 元のパス）を、git の出力の順に返す。"""
    fields = git([*DIFF, "--name-status", "-z"], root).split("\0")
    result, i = [], 0
    while i < len(fields) and fields[i]:
        status = fields[i][0]
        if status in ("R", "C"):
            result.append((status, fields[i + 2], fields[i + 1]))
            i += 3
        else:
            result.append((status, fields[i + 1], fields[i + 1]))
            i += 2
    return result


def file_diff(root: Path, path: str, source: str) -> list[str]:
    """1ファイルの差分。名前の変更は、元のパスも渡して変更として検出させる。"""
    paths = [path] if source == path else [source, path]
    return git([*DIFF, "--", *paths], root).splitlines()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", default=".")
    parser.add_argument("--path", help="このパスの差分だけを出す（本文に書くパスのどれか）")
    args = parser.parse_args()
    root = Path(args.root).resolve()
    items = entries(root)
    if not items:
        print("ステージされた変更がありません（IN-01）")
        return 4
    sources = {path: source for _, path, source in items}
    if args.path:
        if args.path not in sources:
            print(f"{args.path} はステージされたファイルにありません。本文に書くパス: {sorted(sources)}", file=sys.stderr)
            return 2
        lines = file_diff(root, args.path, sources[args.path])
        print("\n".join(lines[:TOTAL_LINES]))
        if len(lines) > TOTAL_LINES:
            print(f"（{args.path} の差分の {TOTAL_LINES + 1} 行目から {len(lines)} 行目を省きました）")
        return 0
    ordered = sorted(items, key=lambda item: item[1])
    print(f"ファイルの数: {len(ordered)}")
    print("本文に書くパス（この順に1行ずつ書く。STEP-02）:")
    for status, path, source in ordered:
        note = f"、元のパス {source}" if source != path else ""
        print(f"  - `{path}`（{status} {KINDS.get(status, '上のどれでもない')}{note}）")
    print("差分:")
    printed = 0
    for _, path, source in ordered:
        print(f"===== {path} =====")
        room = min(PER_FILE_LINES, max(TOTAL_LINES - printed, 0))
        lines = file_diff(root, path, source) if room else []
        shown = lines[:room]
        if shown:
            print("\n".join(shown))
        printed += len(shown)
        if not room:
            print(f"（全体が {TOTAL_LINES} 行を超えたので省きました。`collect_diff.py --path {path}` で読む）")
        elif len(lines) > len(shown):
            print(f"（{len(lines) - len(shown)} 行を省きました。`collect_diff.py --path {path}` で読む）")
    return 0


if __name__ == "__main__":
    sys.exit(main())

