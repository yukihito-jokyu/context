<body>
  <header class="topbar"><div><strong>__PROJECT_TITLE__</strong><small>__PROJECT_SUBTITLE__</small></div><span class="version">__SNAPSHOT_LABEL__</span></header>
  <main class="workspace">
    <section class="mock-shell" aria-label="画面モック">
      <div class="toolbar"><div><strong>画面本体</strong><p>注釈モードで画面内の要素をクリックすると、その要素を囲んで指摘できます</p></div><button class="annotate-toggle" type="button" aria-pressed="false">＋ 要素を選んで指摘</button></div>
      <div class="mock-canvas" data-annotation-surface>
        <div class="ai-content" data-ai-content>__MOCK_CONTENT__</div>
        __FIXED_ANNOTATIONS__
        __SCREEN_DETAIL_FRAMES__
        <div class="dom-hover" data-dom-hover hidden></div>
      </div>
    </section>
    <aside class="review-panel" aria-label="フィードバック入力">
      <div class="review-head"><div class="review-tabs" role="tablist"><button id="review-points-tab" type="button" role="tab" aria-selected="true" aria-controls="review-points-panel">確認ポイント</button><button id="screen-details-tab" type="button" role="tab" aria-selected="false" aria-controls="screen-details-panel">画面の詳細設計</button></div><div class="review-mode-copy"><h2 id="review-mode-title">確認ポイント</h2><p id="review-mode-description">LLMが選んだ確認項目と、過去の承認履歴を確認します。</p><button class="overlay-toggle" id="overlay-toggle" type="button" aria-pressed="true">確認ポイントの連番・枠を非表示</button></div></div>
      <form class="review-body" id="feedback-form">
        <section class="review-view" id="review-points-panel" role="tabpanel"><div id="review-items">__REVIEW_CARDS__</div></section>
        <section class="review-view" id="screen-details-panel" role="tabpanel" hidden><div id="screen-detail-items">__SCREEN_DETAIL_CARDS__</div><section class="screen-detail-approval"><p>各項目へのコメントを確認したうえで、画面詳細設計全体を一括承認します。</p><button id="screen-details-approve" type="button" aria-pressed="false">画面の詳細設計を一括承認</button></section></section>
        <section class="general"><h3>全体へのフィードバック</h3><p>確認ポイント以外の感想や要望を自由に記載できます。</p><textarea id="general-feedback"></textarea></section>
        <button class="submit" type="submit">フィードバックを送信</button>
        <p class="send-status" role="status">送信内容はCodexが読めるJSONとして保存されます。</p>
      </form>
    </aside>
  </main>
  <template id="custom-template"><section class="review-card custom"><div class="card-heading"><span class="number"></span><div><h3>選択要素への指摘</h3><p class="target-summary">赤い四角で囲んだ要素へのフィードバックです。</p></div></div><label>この要素へのフィードバック</label><textarea></textarea><div class="card-actions"><button class="remove" type="button">この指摘を削除</button><button class="approve" type="button" aria-pressed="false">承認</button></div></section></template>
  <script>
    const snapshotId=__SNAPSHOT_ID_JSON__;
    const testParams=new URLSearchParams(location.search);
    const canvas=document.querySelector("[data-annotation-surface]"),aiContent=document.querySelector("[data-ai-content]"),toggle=document.querySelector(".annotate-toggle"),reviewItems=document.querySelector("#review-items"),status=document.querySelector(".send-status"),hoverBox=document.querySelector("[data-dom-hover]"),reviewPanel=document.querySelector(".review-panel"),pointsTab=document.querySelector("#review-points-tab"),detailsTab=document.querySelector("#screen-details-tab"),pointsPanel=document.querySelector("#review-points-panel"),detailsPanel=document.querySelector("#screen-details-panel"),overlayToggle=document.querySelector("#overlay-toggle"),detailsApprove=document.querySelector("#screen-details-approve");
    const emptyState=reviewItems.querySelector(".review-empty");
    const domSelections=new Map();
    let mode=false,hoverTarget=null,reviewMode="points",pointOverlays=true,detailOverlays=true;
    function nextAvailableNumber(){const used=new Set([...document.querySelectorAll(".review-card[data-note]")].map(card=>Number(card.dataset.note)).filter(Number.isFinite));let candidate=1;while(used.has(candidate))candidate+=1;return candidate}
    function place(element,area){element.style.left=`${area.x}%`;element.style.top=`${area.y}%`;element.style.width=`${area.width}%`;element.style.height=`${area.height}%`}
    function targetRect(target,padding=0){const canvasRect=canvas.getBoundingClientRect(),rect=target.getBoundingClientRect();return{left:rect.left-canvasRect.left+canvas.scrollLeft-padding,top:rect.top-canvasRect.top+canvas.scrollTop-padding,width:rect.width+padding*2,height:rect.height+padding*2,target:rect,padding}}
    function placePixels(element,area){element.style.left=`${area.left}px`;element.style.top=`${area.top}px`;element.style.width=`${area.width}px`;element.style.height=`${area.height}px`}
    function hideHover(){hoverTarget=null;hoverBox.hidden=true}
    function setMode(on){mode=on;toggle.setAttribute("aria-pressed",String(on));toggle.textContent=on?"指摘する要素をクリック":"＋ 要素を選んで指摘";canvas.classList.toggle("annotation-mode",on);status.textContent=on?"青い点線で表示されるDOM要素をクリックしてください。":"送信内容はCodexが読めるJSONとして保存されます。";if(!on)hideHover()}
    function bindApprove(button){button.addEventListener("click",()=>{const on=button.getAttribute("aria-pressed")!=="true";button.setAttribute("aria-pressed",String(on));button.textContent=on?"承認済み":"承認";button.closest(".review-card").classList.toggle("approved",on)})}
    function insertCardInNumberOrder(card){const number=Number(card.dataset.note),nextCard=[...reviewItems.querySelectorAll(".review-card[data-note]")].find(item=>Number(item.dataset.note)>number);reviewItems.insertBefore(card,nextCard||null)}
    function selectorFor(target){const key=target.getAttribute("data-review-target");if(key)return`[data-review-target="${key}"]`;const parts=[];let current=target;while(current&&current!==aiContent){const parent=current.parentElement;if(!parent)break;parts.unshift(`${current.tagName.toLowerCase()}:nth-child(${[...parent.children].indexOf(current)+1})`);current=parent}return`[data-ai-content] > ${parts.join(" > ")}`}
    function targetText(target){return(target.getAttribute("aria-label")||target.getAttribute("placeholder")||target.getAttribute("title")||target.textContent||"").replace(/\s+/g," ").trim()}
    function targetSummary(target){const text=targetText(target).slice(0,48);return`${target.tagName.toLowerCase()}${text?`「${text}」`:""}`}
    const textContentTags=new Set(["SPAN","STRONG","SMALL","EM","B","I","P","H1","H2","H3","H4","H5","H6"]);
    function selectableTarget(origin){if(!(origin instanceof Element)||!aiContent.contains(origin)||origin===aiContent)return null;const interactive=origin.closest("button,a,input,select,textarea,label");if(interactive&&aiContent.contains(interactive))return interactive;if(!textContentTags.has(origin.tagName))return origin;const region=origin.closest("[data-review-target],article,li,tr,td,th,fieldset,details,summary");if(region&&region!==aiContent)return region;return origin.parentElement&&origin.parentElement!==aiContent?origin.parentElement:origin}
    function percentageRect(target){const canvasRect=canvas.getBoundingClientRect(),rect=target.getBoundingClientRect(),width=canvas.scrollWidth||canvasRect.width,height=canvas.scrollHeight||canvasRect.height,clamp=value=>Math.max(0,Math.min(100,value));return{x_percent:Number(clamp((rect.left-canvasRect.left+canvas.scrollLeft)/width*100).toFixed(2)),y_percent:Number(clamp((rect.top-canvasRect.top+canvas.scrollTop)/height*100).toFixed(2)),width_percent:Number(clamp(rect.width/width*100).toFixed(2)),height_percent:Number(clamp(rect.height/height*100).toFixed(2))}}
    function alignmentDiagnostic(box,target,padding,identity){const area=targetRect(target,padding);placePixels(box,area);box.style.visibility="visible";const boxRect=box.getBoundingClientRect(),rect=area.target,tolerance=2,aligned=Math.abs(boxRect.left-(rect.left-padding))<=tolerance&&Math.abs(boxRect.top-(rect.top-padding))<=tolerance&&Math.abs(boxRect.right-(rect.right+padding))<=tolerance&&Math.abs(boxRect.bottom-(rect.bottom+padding))<=tolerance;return{...identity,aligned,box:{left:boxRect.left,top:boxRect.top,right:boxRect.right,bottom:boxRect.bottom},target:{left:rect.left,top:rect.top,right:rect.right,bottom:rect.bottom},padding}}
