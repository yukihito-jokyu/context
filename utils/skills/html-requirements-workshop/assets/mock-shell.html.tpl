ail-empty{padding:20px;border:1px dashed #cfd5e1;border-radius:14px;text-align:center}.screen-detail-empty p{color:var(--muted);font-size:12px}.screen-detail-approval{padding:14px;border:1px solid #cfe8de;border-radius:14px;background:#f5fcf9}.screen-detail-approval p{margin:0 0 10px;font-size:12px;line-height:1.5}.screen-detail-approval button{width:100%;padding:10px;border:1px solid #a9ddc9;border-radius:10px;color:var(--green);background:#fff;font-weight:800}.screen-detail-approval button[aria-pressed=true]{color:#fff;background:var(--green)}.screen-detail-frame{position:absolute;z-index:6;border:2px solid var(--red);border-radius:8px;background:rgb(228 91 104 / 8%);pointer-events:none}.screen-detail-frame-number{position:absolute;top:-16px;left:-16px;display:grid;width:30px;height:30px;place-items:center;border:3px solid #fff;border-radius:9px;color:#fff;background:var(--red);box-shadow:0 6px 16px rgb(108 35 44 / 22%);font-size:12px;font-weight:800}.selection-box[data-target-key]{border-color:var(--accent);background:rgb(91 103 241 / 8%)}.selection-box[data-target-key] .selection-number{background:var(--accent)}body[data-review-mode=details] .annotate-toggle,body[data-review-mode=details] .selection-box,body[data-review-mode=details] .dom-hover,body[data-review-mode=points] .screen-detail-frame,body[data-point-overlays=false] .selection-box,body[data-point-overlays=false] #review-items .number,body[data-detail-overlays=false] .screen-detail-frame,body[data-detail-overlays=false] .detail-sequence{display:none!important}.detail-target-active{outline:3px solid var(--accent);outline-offset:3px}
