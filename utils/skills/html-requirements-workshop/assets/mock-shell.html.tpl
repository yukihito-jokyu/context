    @media(max-width:1040px){.workspace{grid-template-columns:1fr}.review-panel{position:static;max-height:none}}@media(max-width:680px){.workspace{padding:8px}.toolbar{align-items:flex-start;flex-direction:column}.placeholder-row{grid-template-columns:1fr}}
