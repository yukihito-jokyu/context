<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Self Review — __SOURCE_HTML__ → __TARGET_HTML__</title>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0d1117;
      --panel: #161b22;
      --panel-2: #1c2128;
      --border: #30363d;
      --muted: #8b949e;
      --text: #e6edf3;
      --blue: #58a6ff;
      --green: #3fb950;
      --green-bg: rgba(46, 160, 67, .16);
      --red: #f85149;
      --red-bg: rgba(248, 81, 73, .16);
      --yellow: #d29922;
      --selection: #58a6ff;
      font-family: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 1080px; overflow: hidden; background: var(--bg); color: var(--text); }
    button, input, textarea { font: inherit; }
    button { color: inherit; }
    button:disabled, input:disabled, textarea:disabled { cursor: not-allowed; opacity: .52; }
    .topbar { height: 68px; display: flex; align-items: center; gap: 18px; padding: 0 22px; border-bottom: 1px solid var(--border); background: #010409; }
    .brand { font-weight: 700; letter-spacing: -.02em; white-space: nowrap; }
    .compare { display: flex; align-items: center; gap: 8px; font-size: 13px; }
    .ref { min-width: 74px; padding: 5px 9px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); color: var(--blue); text-align: center; }
    .arrow { color: var(--muted); }
    .summary { margin-left: auto; display: flex; gap: 15px; color: var(--muted); font-size: 13px; }
    .summary strong { color: var(--text); font-weight: 600; }
    .shell-badge { padding: 4px 8px; border: 1px solid var(--border); border-radius: 999px; color: var(--muted); font-size: 11px; }
    .toolbar { height: 52px; display: flex; align-items: center; gap: 10px; padding: 0 16px; border-bottom: 1px solid var(--border); background: var(--panel); }
    .search { width: 280px; padding: 7px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--text); outline: none; }
    .search:focus { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(88,166,255,.15); }
    .filters { display: flex; gap: 6px; }
    .filter, .manual-mode-button { cursor: pointer; padding: 6px 10px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg); color: #c9d1d9; font-size: 12px; }
    .filter.active { border-color: var(--blue); background: rgba(56,139,253,.15); color: #79c0ff; }
    .manual-mode-button { border-radius: 6px; }
    .manual-mode-button.active { border-color: #e3b341; background: rgba(187,128,9,.18); color: #f2cc60; }
    .hint { margin-left: auto; color: var(--muted); font-size: 12px; }
    .layout { display: grid; grid-template-columns: 220px minmax(560px, 1.25fr) minmax(400px, .9fr); height: calc(100vh - 120px); }
    .pane { min-width: 0; overflow: auto; }
    .file-tree-pane { padding: 12px 9px; border-right: 1px solid var(--border); background: #0b0f14; }
    .diff-pane { padding: 16px; border-right: 1px solid var(--border); }
    .review-pane { padding: 16px; background: #0b0f14; }
    .tree-title { display: flex; align-items: center; justify-content: space-between; margin: 2px 7px 10px; color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .tree-count, .review-count { padding: 3px 7px; border-radius: 999px; background: var(--panel-2); color: var(--muted); font-size: 11px; }
    .empty-tree { margin: 12px 6px; padding: 18px 10px; border: 1px dashed var(--border); border-radius: 7px; color: var(--muted); text-align: center; font-size: 12px; line-height: 1.55; }
    .skeleton-file { border: 1px solid var(--border); border-radius: 7px; overflow: hidden; background: var(--panel); }
    .skeleton-file-head { height: 41px; display: flex; align-items: center; gap: 9px; padding: 0 12px; border-bottom: 1px solid var(--border); background: var(--panel-2); color: var(--muted); font: 600 13px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .empty-main { min-height: 310px; display: grid; place-items: center; padding: 30px; }
    .empty-content { max-width: 410px; text-align: center; }
    .empty-icon { width: 48px; height: 48px; display: grid; place-items: center; margin: 0 auto 14px; border: 1px solid var(--border); border-radius: 12px; background: var(--panel-2); color: var(--muted); font-size: 22px; }
    .empty-content h1 { margin: 0 0 7px; font-size: 16px; }
    .empty-content p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.65; }
    .review-head { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 13px; }
    .review-head h1 { margin: 0; font-size: 17px; }
    .review-head p { margin: 5px 0 0; color: var(--muted); font-size: 12px; }
    .review-count { margin-left: auto; }
    .export-button { padding: 7px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--panel-2); color: var(--muted); font-size: 12px; font-weight: 700; }
    .empty-review { min-height: 310px; display: grid; place-items: center; padding: 30px; border: 1px dashed var(--border); border-radius: 8px; background: rgba(22,27,34,.45); }
    .shell-notes { margin-top: 12px; padding: 10px 11px; border: 1px solid var(--border); border-radius: 7px; background: var(--panel); color: var(--muted); font-size: 11px; line-height: 1.6; }
    .tree { list-style: none; margin: 0; padding: 0; font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .tree ul { list-style: none; margin: 0; padding: 0 0 0 15px; }
    .tree-folder.collapsed > ul { display: none; }
    .tree-row { width: 100%; display: flex; align-items: center; gap: 6px; padding: 7px 8px; border: 0; border-radius: 5px; background: transparent; color: #c9d1d9; text-align: left; cursor: pointer; }
    .tree-row:hover, .tree-row.active { background: rgba(56,139,253,.16); color: #79c0ff; }
    .tree-chevron { width: 10px; color: var(--muted); text-align: center; }
    .tree-folder.collapsed > .tree-row .tree-chevron { transform: rotate(-90deg); }
    .tree-file-icon { color: var(--muted); }
    .tree-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tree-stat { margin-left: auto; color: var(--muted); font-size: 10px; }
    .add { color: #56d364; } .del { color: #ff7b72; }
    .file { margin-bottom: 16px; border: 1px solid var(--border); border-radius: 7px; overflow: hidden; background: var(--panel); }
    .file-header { position: sticky; top: 0; z-index: 2; width: 100%; display: flex; align-items: center; gap: 9px; padding: 10px 12px; border: 0; border-bottom: 1px solid var(--border); background: var(--panel-2); color: var(--text); text-align: left; cursor: pointer; font: 600 13px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .file-header:hover { background: #252b33; }
    .file-header:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; }
    .file-icon { color: var(--muted); }
    .file-stats { margin-left: auto; }
    .file.collapsed .file-content { display: none; }
    .file.collapsed .file-icon { transform: rotate(-90deg); }
    .file.collapsed .file-header { border-bottom: 0; }
    .hunk { padding: 7px 12px; background: rgba(56,139,253,.12); color: #79c0ff; font: 12px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .line { position: relative; display: grid; grid-template-columns: 44px 44px 20px minmax(0,1fr); min-height: 25px; font: 12px/25px ui-monospace, SFMono-Regular, Menlo, monospace; cursor: pointer; }
    .line.addition { background: var(--green-bg); } .line.deletion { background: var(--red-bg); }
    .ln { padding-right: 8px; border-right: 1px solid rgba(139,148,158,.16); color: var(--muted); text-align: right; }
    .sign { text-align: center; } .code { padding: 0 9px; overflow: hidden; white-space: pre; text-overflow: ellipsis; }
    .line.selected::after, .line.manual-selected::before { position: absolute; inset: 0; border-right: 2px solid var(--selection); border-left: 4px solid var(--selection); content: ""; pointer-events: none; }
    .line.group-start::after { border-top: 2px solid var(--selection); } .line.group-end::after { border-bottom: 2px solid var(--selection); }
    .line.manual-selected::before { border-right: 2px dashed #e3b341; border-left: 4px solid #e3b341; }
    .line.manual-start::before { border-top: 2px dashed #e3b341; } .line.manual-end::before { border-bottom: 2px dashed #e3b341; }
    .cards { display: grid; gap: 10px; } .card { border: 1px solid var(--border); border-radius: 8px; background: var(--panel); overflow: hidden; cursor: pointer; transition: border-color .12s, transform .12s; }
    .card:hover { border-color: #6e7681; transform: translateY(-1px); }
    .card.selected { border-color: var(--blue); box-shadow: 0 0 0 2px rgba(88,166,255,.16); } .card.hidden { display: none; }
    .card.has-feedback { border-left: 4px solid var(--selection); }
    .card-top { display: flex; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 11px; }
    .badge { padding: 3px 7px; border-radius: 999px; font-weight: 700; } .badge.rule_out { color:#ff7b72;background:rgba(248,81,73,.16); } .badge.rule_in { color:#56d364;background:rgba(46,160,67,.16); } .badge.unknown { color:#e3b341;background:rgba(187,128,9,.17); } .badge.no_rule { color:#b1bac4;background:rgba(110,118,129,.16); }
    .range { font-family: ui-monospace,monospace; } .confidence { margin-left:auto;color:var(--muted); } .card-body { padding:12px; }
    .rule-name { margin:0 0 5px;font-size:14px; }
    .source { display:grid;gap:3px;margin-bottom:8px;color:var(--blue);font:11px ui-monospace,monospace; }
    .source-item { display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
    .quote { margin:0 0 9px;padding:8px 9px;border-left:3px solid #6e7681;background:var(--bg);font-size:12px;line-height:1.5; }
    .reason,.suggestion { margin:0;font-size:12px;line-height:1.55; } .suggestion { margin-top:8px;padding:8px;background:rgba(248,81,73,.08);color:#ffa198; }
    .feedback { margin-top:10px;padding-top:9px;border-top:1px solid var(--border); } .feedback label { display:block;margin-bottom:5px;color:#cae8ff;font-size:11px;font-weight:700; }
    textarea { width:100%;min-height:60px;resize:vertical;padding:8px;border:1px solid var(--border);border-radius:5px;background:var(--bg);color:var(--text);outline:none; }
    textarea:focus { border-color: var(--selection); box-shadow: 0 0 0 2px rgba(88,166,255,.14); }
    .manual-panel { display:none;margin-bottom:10px;padding:10px;border:1px solid #9e6a03;border-radius:7px;background:rgba(187,128,9,.08); } .manual-panel.visible { display:block; }
    .manual-location { color:#f2cc60;font:11px ui-monospace,monospace; } .manual-actions { display:flex;justify-content:flex-end;gap:6px;margin-top:7px; }
    .manual-actions button { padding:5px 8px;border:1px solid var(--border);border-radius:5px;background:var(--panel-2);color:var(--text);cursor:pointer; }
    .manual-comments { display:grid;gap:6px;margin-bottom:10px; } .manual-comment { padding:8px;border:1px solid #6e5b24;border-radius:6px;background:var(--panel);font-size:12px; }
    .manual-comment-top { display:flex;align-items:center;gap:8px;margin-bottom:5px;color:#f2cc60;font:11px ui-monospace,monospace; }
    .manual-comment-remove { margin-left:auto;padding:2px 5px;border:0;background:transparent;color:var(--muted);cursor:pointer; }
    .manual-comment p { margin:0;color:#c9d1d9;font-size:12px;line-height:1.5; }
    .empty { display:none;padding:40px 20px;text-align:center;color:var(--muted); }
    @media (max-width: 1180px) {
      .layout { grid-template-columns: 190px minmax(540px, 1.25fr) minmax(380px, .8fr); }
      .summary span:first-child { display: none; }
    }
  </style>
</head>
<body data-target="__TARGET_ATTR__" data-source="__SOURCE_ATTR__">
  <header class="topbar">
    <div class="brand">Self Review</div>
    <div class="compare" aria-label="比較対象"><span class="ref">__TARGET_HTML__</span><span class="arrow">←</span><span class="ref">__SOURCE_HTML__</span></div>
    <div class="summary"><span><strong>__FILES_CHANGED__</strong> files changed</span>__ADDITIONS_STAT_HTML____DELETIONS_STAT_HTML__<span><strong>__REVIEW_COUNT__</strong> reviews</span></div>
  </header>
  <nav class="toolbar" aria-label="評価の絞り込み">
    <input class="search" type="search" placeholder="ファイル、ルール、理由を検索" __DISABLED__>
    <div class="filters">
      <button class="filter active" type="button" data-filter="all" __DISABLED__>すべて __REVIEW_COUNT__</button>
      <button class="filter" type="button" data-filter="rule_out" __DISABLED__>ルール外 __RULE_OUT_COUNT__</button>
      <button class="filter" type="button" data-filter="rule_in" __DISABLED__>ルール内 __RULE_IN_COUNT__</button>
      <button class="filter" type="button" data-filter="unknown" __DISABLED__>判断不能 __UNKNOWN_COUNT__</button>
      <button class="filter" type="button" data-filter="no_rule" __DISABLED__>対象なし __NO_RULE_COUNT__</button>
    </div>
    <button id="manual-mode" class="manual-mode-button" type="button" __DISABLED__>任意行を選択して指摘</button>
    <span class="hint">ドラッグで連続行、クリックで個別行を選択できます</span>
  </nav>
  <main class="layout">
    <nav class="pane file-tree-pane" aria-label="変更ファイル">
      <div class="tree-title"><span>Changed files</span><span class="tree-count">__FILES_CHANGED__</span></div>
      __FILE_TREE_HTML__
    </nav>
    <section class="pane diff-pane" aria-label="差分">
      __DIFF_HTML__
    </section>
    <aside class="pane review-pane" aria-label="ルール評価">
      <div class="review-head">
        <div><h1>ルール評価</h1><p>変更行に適用された根拠と判定</p></div>
        <span class="review-count">__REVIEW_COUNT__件</span>
        <button id="export-feedback" class="export-button" type="button" __DISABLED__>指摘をJSONで送信</button>
      </div>
      <div id="export-status" class="shell-notes" hidden></div>
      <section id="manual-panel" class="manual-panel"><div id="manual-location" class="manual-location"></div><textarea id="manual-feedback" placeholder="選択行への指摘"></textarea><div class="manual-actions"><button id="manual-cancel" type="button">解除</button><button id="manual-add" type="button" disabled>指摘に追加</button></div></section>
      <div id="manual-comments" class="manual-comments"></div>
      <div id="cards" class="cards">__REVIEW_HTML__</div>
      <div id="empty" class="empty">条件に一致する評価はありません</div>
    </aside>
  </main>
  <script>
    const mappedLines=[...document.querySelectorAll('.line[data-reviews]')],allLines=[...document.querySelectorAll('.line[data-number]')],cards=[...document.querySelectorAll('.card')];
    const manualButton=document.querySelector('#manual-mode'),manualPanel=document.querySelector('#manual-panel'),manualLocation=document.querySelector('#manual-location'),manualFeedback=document.querySelector('#manual-feedback'),manualAdd=document.querySelector('#manual-add'),manualCommentsElement=document.querySelector('#manual-comments');
    let manualMode=false,dragging=false,dragAnchor=null,didDrag=false,suppressClick=false,manualComments=[],manualCommentSerial=0;
    const clearClass=(names)=>allLines.forEach(line=>line.classList.remove(...names));
    function markGroups(selected,prefix){selected.forEach(line=>{const prev=line.previousElementSibling,next=line.nextElementSibling;if(!prev?.classList.contains(prefix==='manual'?'manual-selected':'selected'))line.classList.add(prefix==='manual'?'manual-start':'group-start');if(!next?.classList.contains(prefix==='manual'?'manual-selected':'selected'))line.classList.add(prefix==='manual'?'manual-end':'group-end')})}
    function selectReview(id){cards.forEach(card=>card.classList.toggle('selected',card.dataset.reviewId===id));clearClass(['selected','group-start','group-end']);const selected=mappedLines.filter(line=>line.dataset.reviews.split(',').includes(id));selected.forEach(line=>line.classList.add('selected'));markGroups(selected,'review');selected[0]?.scrollIntoView({behavior:'smooth',block:'center'})}
    cards.forEach(card=>card.addEventListener('click',event=>{if(!event.target.closest('textarea'))selectReview(card.dataset.reviewId)}));
    function selectedManual(){return allLines.filter(line=>line.classList.contains('manual-selected'))}
    function compact(values){const nums=[...new Set(values.map(Number))].sort((a,b)=>a-b);if(!nums.length)return'';const result=[];let start=nums[0],end=nums[0];for(const n of nums.slice(1)){if(n===end+1)end=n;else{result.push(start===end?`${start}`:`${start}-${end}`);start=end=n}}result.push(start===end?`${start}`:`${start}-${end}`);return result.join(',')}
    function refreshManual(){clearClass(['manual-start','manual-end']);const selected=selectedManual();markGroups(selected,'manual');manualPanel.classList.toggle('visible',!!selected.length);manualAdd.disabled=!selected.length||!manualFeedback.value.trim();if(selected.length){manualLocation.textContent=`${selected[0].dataset.file}:${compact(selected.map(line=>line.dataset.number))} (${selected.length}行)`}else{manualLocation.textContent=''}}
    function clearManual(){clearClass(['manual-selected','manual-start','manual-end']);manualFeedback.value='';dragAnchor=null;refreshManual()}
    function fileLines(line){return allLines.filter(item=>item.dataset.file===line.dataset.file&&item.dataset.side===line.dataset.side)}
    function toggleLine(line){const selected=selectedManual();if(selected.length&&(selected[0].dataset.file!==line.dataset.file||selected[0].dataset.side!==line.dataset.side))clearManual();line.classList.toggle('manual-selected');dragAnchor=line;refreshManual()}
    allLines.forEach(line=>{line.addEventListener('mousedown',event=>{if(manualMode&&event.button===0){event.preventDefault();dragging=true;didDrag=false;dragAnchor=line}});line.addEventListener('mouseenter',()=>{if(!manualMode||!dragging||!dragAnchor||dragAnchor.dataset.file!==line.dataset.file||dragAnchor.dataset.side!==line.dataset.side)return;didDrag=true;clearClass(['manual-selected']);const list=fileLines(line),a=list.indexOf(dragAnchor),b=list.indexOf(line);list.slice(Math.min(a,b),Math.max(a,b)+1).forEach(item=>item.classList.add('manual-selected'));refreshManual()});line.addEventListener('click',()=>{if(manualMode&&!suppressClick)toggleLine(line);else if(!manualMode&&line.dataset.reviews)selectReview(line.dataset.reviews.split(',')[0])})});
    document.addEventListener('mouseup',()=>{if(!dragging)return;dragging=false;if(didDrag){suppressClick=true;setTimeout(()=>suppressClick=false,0)}});
    manualButton.addEventListener('click',()=>{manualMode=!manualMode;manualButton.classList.toggle('active',manualMode);manualButton.textContent=manualMode?'行選択モード中':'任意行を選択して指摘';if(!manualMode)clearManual()});
    document.querySelector('#manual-cancel').addEventListener('click',clearManual);
    manualFeedback.addEventListener('input',refreshManual);
    function renderManual(){manualCommentsElement.replaceChildren(...manualComments.map(comment=>{const box=document.createElement('div');box.className='manual-comment';const top=document.createElement('div');top.className='manual-comment-top';top.textContent=`${comment.file}:${comment.line_range}`;const remove=document.createElement('button');remove.className='manual-comment-remove';remove.type='button';remove.textContent='削除';remove.addEventListener('click',()=>{manualComments=manualComments.filter(item=>item.comment_id!==comment.comment_id);renderManual()});top.appendChild(remove);const body=document.createElement('p');body.textContent=comment.feedback;box.append(top,body);return box}))}
    manualAdd.addEventListener('click',()=>{const selected=selectedManual(),feedback=manualFeedback.value.trim();if(!selected.length||!feedback)return;manualCommentSerial+=1;manualComments.push({comment_id:`manual-${manualCommentSerial}`,file:selected[0].dataset.file,side:selected[0].dataset.side,lines:selected.map(line=>Number(line.dataset.number)),line_range:compact(selected.map(line=>line.dataset.number)),feedback});renderManual();clearManual()});
    document.querySelectorAll('.file-header').forEach(header=>header.addEventListener('click',()=>{const file=header.closest('.file'),expanded=file.classList.contains('collapsed');file.classList.toggle('collapsed',!expanded);header.setAttribute('aria-expanded',String(expanded))}));
    document.querySelectorAll('.tree-folder-toggle').forEach(toggle=>toggle.addEventListener('click',()=>{const folder=toggle.closest('.tree-folder'),expanded=folder.classList.contains('collapsed');folder.classList.toggle('collapsed',!expanded);toggle.setAttribute('aria-expanded',String(expanded))}));
    document.querySelectorAll('.tree-file').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('.tree-file').forEach(item=>item.classList.remove('active'));button.classList.add('active');const file=document.getElementById(button.dataset.target);file.classList.remove('collapsed');file.querySelector('.file-header').setAttribute('aria-expanded','true');file.scrollIntoView({behavior:'smooth',block:'start'})}));
    const search=document.querySelector('.search'),empty=document.querySelector('#empty'),filters=[...document.querySelectorAll('[data-filter]')];let filter='all';function applyFilter(){const q=search.value.toLowerCase();let visible=0;cards.forEach(card=>{const show=(filter==='all'||card.dataset.verdict===filter)&&card.dataset.search.toLowerCase().includes(q);card.classList.toggle('hidden',!show);visible+=show});empty.style.display=cards.length&&!visible?'block':'none'}search.addEventListener('input',applyFilter);filters.forEach(button=>button.addEventListener('click',()=>{filter=button.dataset.filter;filters.forEach(item=>item.classList.toggle('active',item===button));applyFilter()}));
    cards.forEach(card=>card.querySelector('textarea').addEventListener('input',event=>card.classList.toggle('has-feedback',!!event.target.value.trim())));
    document.querySelector('#export-feedback').addEventListener('click',async()=>{const payload={schema_version:'1.0',report:{target:document.body.dataset.target,source:document.body.dataset.source},reviews:cards.map(card=>({review_id:card.dataset.reviewId,feedback:card.querySelector('textarea').value.trim()})),manual_comments:manualComments};const status=document.querySelector('#export-status');try{if(location.protocol.startsWith('http')){const response=await fetch('/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});if(!response.ok)throw new Error(await response.text());status.textContent='指摘を送信しました。AIが修正へ進みます。'}else{const blob=new Blob([JSON.stringify(payload,null,2)+'\n'],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='self-review-feedback.json';a.click();URL.revokeObjectURL(url);status.textContent='self-review-feedback.jsonを書き出しました。'}status.hidden=false}catch(error){status.textContent=`送信に失敗しました: ${error.message}`;status.hidden=false}});
  </script>
</body>
</html>
