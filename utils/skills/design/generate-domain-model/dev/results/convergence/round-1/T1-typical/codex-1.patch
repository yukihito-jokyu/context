.git
.skill-runs</pre></details></section><footer>分類と関係の意味はコードの読解に基づく整理です。抜粋の一致と画像の構造を機械検査し、意味の正しさは別途レビューします。</footer></main><dialog aria-label="図の拡大"><button id="close">閉じる</button><h2></h2><div class="zoom"><img alt=""></div></dialog><script>const search=document.querySelector('#search'),domain=document.querySelector('#domain');function filter(){const q=search.value.toLocaleLowerCase();let n=0;document.querySelectorAll('.concept,.diagram').forEach(e=>{const show=(!domain.value||!e.dataset.domain||domain.value===e.dataset.domain)&&(!q||(e.dataset.search||'').toLocaleLowerCase().includes(q)||e.classList.contains('diagram'));e.hidden=!show;if(show&&e.classList.contains('concept'))n++});document.querySelector('#count').textContent=n+'件の概念';document.querySelector('#empty').hidden=n>0}search.addEventListener('input',filter);domain.addEventListener('change',filter);const modal=document.querySelector('dialog');document.querySelectorAll('.preview').forEach(b=>b.addEventListener('click',()=>{modal.querySelector('img').src=b.dataset.image;modal.querySelector('img').alt=b.dataset.title;modal.querySelector('h2').textContent=b.dataset.title;modal.showModal()}));document.querySelector('#close').addEventListener('click',()=>modal.close());filter();</script></body></html>

