entListener('click',()=>{modal.querySelector('img').src=b.dataset.image;modal.querySelector('img').alt=b.dataset.title;modal.querySelector('h2').textContent=b.dataset.title;modal.showModal()}));document.querySelector('#close').addEventListener('click',()=>modal.close());filter();</script></body></html>

